
freesurfer_lut=/fs/tools/freesurfer/5.3.0/Ubuntu14/FreeSurferColorLUT.txt
num_lines=`cat ${freesurfer_lut} | wc -l`

freesurfer_lut_selected=FreeSurferColorLUT_Connectivity.txt
label_selected_list=`cat freesurfer_connectivity_labels.txt`

if [ ! -e ${freesurfer_lut_selected} ]; then
  for idx in `seq 1 ${num_lines}`; do
    line=`sed "${idx}q;d" ${freesurfer_lut}`
    label=`echo ${line} | tr "\t" " " | tr -s " " | cut -d " " -f2`
    for label_test in ${label_selected_list}; do
      if [ "${label}" == "${label_test}" ]; then
        echo ${line} >> ${freesurfer_lut_selected}
      fi
    done
  done
fi

freesurfer_lut_selected=FreeSurferColorLUT_WM.txt
label_num_list="2 7 16 29 32 41 46 61 64 59 60 27 28 `seq 77 88` `seq 100 117` `seq 155 158` `seq 195 196` `seq 199 200` `seq 203 204` 212 219 223 `seq 250 255`"

if [ ! -e ${freesurfer_lut_selected} ]; then
  for idx in `seq 1 ${num_lines}`; do
    line=`sed "${idx}q;d" ${freesurfer_lut}`
    label_num=`echo ${line} | tr "\t" " " | tr -s " " | cut -d " " -f1`
    for label_num_test in ${label_num_list}; do
      if [ "${label_num}" == "${label_num_test}" ]; then
        echo ${line} >> ${freesurfer_lut_selected}
      fi
    done
  done
fi

freesurfer_lut_selected=FreeSurferColorLUT_Ventricles.txt
label_num_list="4 5 14 15 31 43 44 63 72"

if [ ! -e ${freesurfer_lut_selected} ]; then
  for idx in `seq 1 ${num_lines}`; do
    line=`sed "${idx}q;d" ${freesurfer_lut}`
    label_num=`echo ${line} | tr "\t" " " | tr -s " " | cut -d " " -f1`
    for label_num_test in ${label_num_list}; do
      if [ "${label_num}" == "${label_num_test}" ]; then
        echo ${line} >> ${freesurfer_lut_selected}
      fi
    done
  done
fi

