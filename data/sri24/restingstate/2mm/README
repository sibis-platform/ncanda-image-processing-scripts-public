# sri24_*.nii.gz was generated by Eva manually tracing those structures in the mni space and then non-rigidly registered to the sri24 space. 

# parc116 thalamus mask
c3d ../../parcellation/sri24_parc116.nii.gz -replace 77 1000 -thresh 1000 inf 1 0 -pad 0x0x1 0x0x0 0 -interpolation NearestNeighbor -resample 120x120x78 -flip x -orient RPI -origin 0x0x0mm -o sri24_Thalamus_L.nii.gz
c3d ../../parcellation/sri24_parc116.nii.gz -replace 78 1000 -thresh 1000 inf 1 0 -pad 0x0x1 0x0x0 0 -interpolation NearestNeighbor -resample 120x120x78 -flip x -orient RPI -origin 0x0x0mm -o sri24_Thalamus_R.nii.gz

