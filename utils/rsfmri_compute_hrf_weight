import argparse
import numpy as np
import sys
import os.path

import nipype
crashDir=os.getenv('NIPYPE_CRASH_DIR')
if crashDir:
  nipype.config.set("execution", "crashdump_dir", crashDir)

from nipype.algorithms.modelgen import spm_hrf

# suppress warnings from spm_hrf
import warnings
warnings.filterwarnings("ignore", message="divide by zero encountered in log")

#
# Main 
#

# Parse Arguments 
parser = argparse.ArgumentParser(description="Compute hrf weight values.")
parser.add_argument("-n", "--nscans", type=int, required=True, help="number of scans.", action="store")
parser.add_argument("-t", "--TR", type=float, required=True, help="TR in seconds.", action="store")
parser.add_argument("-o", "--output", help="Output filename.", required=True, action="store")
args = parser.parse_args()

rt = args.TR / 10
xlen = 100 + np.ceil(args.nscans * args.TR / rt)
x = np.ones(int(xlen))
x[0:100] = np.zeros(100)

hrf = spm_hrf(rt)

x = np.convolve(x, hrf)

# mean of each 10 elements
weight = np.mean(x[100:100+10*args.nscans].reshape(-1,10), axis=1)

np.savetxt(args.output, weight)

