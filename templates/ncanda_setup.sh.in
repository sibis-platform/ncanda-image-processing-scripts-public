#
# Setup hcp workbench
#

# export CARET7_DIR=${CARET7_DIR:-@NCANDA_CARET7_DIR@}
export CARET7_DIR=@NCANDA_CARET7_DIR@

if [ "${CARET7_DIR}" = "" ]; then
  echo "ERROR: must set 'CARET7_DIR' environment variable to HCP Workbench root directory"
  exit 1
fi

# 05/21/26: JD: Workbench runtime libraries are needed for wb_command,
# but should not be added globally because they can interfere with Slicer/ANTs.
caret7()
{
  LD_LIBRARY_PATH="${CARET7_DIR}/libs_linux64:${LD_LIBRARY_PATH}" \
    ${CARET7_DIR}/exe_linux64/$*
}

# Some pipeline scripts may call wb_command directly instead of through caret7.
wb_command()
{
  LD_LIBRARY_PATH="${CARET7_DIR}/libs_linux64:${LD_LIBRARY_PATH}" \
    ${CARET7_DIR}/exe_linux64/wb_command "$@"
}

#
# Setup msm
#

# export MSM_DIR=${MSM_DIR:-@NCANDA_MSM_DIR@}
export MSM_DIR=@NCANDA_MSM_DIR@

if [ "${MSM_DIR}" = "" ]; then
  echo "ERROR: must set 'MSM_DIR' environment variable to MSM root directory"
  exit 1
fi

msm()
{
  ${MSM_DIR}/$*
}

#
# Set up error mailing
#
ncanda_error_email()
{
  local addr="@NCANDA_PIPEOP_EMAIL@"
  local subject="NCANDA Pipeline: $1"

  # -r option does not work with all mailx versions 
  eval "mailx -s \"${subject}\" ${addr}"
}

#
# log mechanism 
#
log_and_execute()
{
  local cmd=$1
  local outfile=$2
  local outdir=`dirname $outfile`
  mkdir -p $outdir
  echo "${SVN_VERSION},$CMD" > ${outdir}/`basename ${outfile} | cut -d '.' -f 1`.cmd
  $CMD 
}

