  ${C3D_DIR}/bin/$*
}

#
# Setup NAONLM
#

# export NAONLM_DIR=${NAONLM_DIR:-@NCANDA_NAONLM_DIR@}
export NAONLM_DIR=@NCANDA_NAONLM_DIR@

if [ "${NAONLM_DIR}" = "" ]; then
  echo "ERROR: must set 'NAONLM_DIR' environment variable to NAONLM root directory"
