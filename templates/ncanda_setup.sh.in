#

# export ANTS_DIR=${ANTS_DIR:-@NCANDA_ANTS_DIR@}
export ANTS_DIR=@NCANDA_ANTS_DIR@

if [ "${ANTS_DIR}" = "" ]; then
  echo "ERROR: must set 'ANTS_DIR' environment variable to ANTS binary directory"
  exit 1
fi

