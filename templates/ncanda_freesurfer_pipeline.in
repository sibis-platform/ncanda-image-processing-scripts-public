NCANDA_BINARY_DIR=@NCANDA_BINARY_DIR_CONFIG@
DATA_DIR=@DATA_DIR_CONFIG@
TEMPLATE_DIR=@TEMPLATE_DIR_CONFIG@

LONGITUDINAL_FLAG=$2 
if [ "$LONGITUDINAL_FLAG" == "" ]; then 
   LONGITUDINAL_FLAG=true
fi 

# run epi_rag without white matter 
EPI_REG_FLAG=$3 

source ${NCANDA_BINARY_DIR}/ncanda_setup.sh $*

pushd () {
  command pushd "$@" > /dev/null
}
popd () {
  command popd "$@" > /dev/null
}

#
# Setup input and output
#

export subject=${SUBJECT}_${ARM}_${VISIT}
if [ "${VISIT}" == "baseline" ]; then
  export t1_brain=$(LWDP_get_override_file ${WORKDIR}/structural/stripped/t1_brain.nii.gz)
else
  # for followups, apply intensity matched images
  export t1_brain=$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/corrected/t1_brain.nii.gz)
fi

# Error if no stripped T1w image
if [ ! -e ${t1_brain} ]; then
  echo "ERROR: missing ${t1_brain}"
  exit 1
fi

# Set up the directories for a freesurfer auto_recon_all job, where the brain mask is already made and 
# is substituted into the processing stream.

freesurfer_run_stage_1() {
    FS_DIR=$1 
    subject=$2 
    FS_LOG_FILE=${FS_DIR}/autorecon1.log
    FS_SUBJECT_DIR=${FS_DIR}/${subject}

    T1_STRIPPED=${FS_SUBJECT_DIR}/mri/orig/001.mgz
    # This is what we believe to be the last file created by freesurfer when running autorecon 1
    lastfile_stage_1=${FS_SUBJECT_DIR}/mri/brainmask.mgz

    if LWDP_needs_update_and_lock ${lastfile_stage_1} ${T1_STRIPPED}; then
	freesurfer_reset ${FS_SUBJECT_DIR} 1

	echo "INFO:${FS_SUBJECT_DIR}: Started freesurfer stage 1 at `date` ..."
	manual_overwrite=${FS_DIR}/manual/${subject}
	if [ -e ${manual_overwrite} ]; then       
	    echo "INFO:${FS_SUBJECT_DIR}: Copying files from ${manual_overwrite}!" 
	    rsync -rtaL ${manual_overwrite}/ ${FS_SUBJECT_DIR}
	fi 

	if ! recon-all  -norandomness -openmp ${OMP_NUM_THREADS} -sd ${FS_DIR} -autorecon1 -noskullstrip -no-isrunning -s ${subject} -rng-seed 1234 &> ${FS_LOG_FILE}; then
	    echo "freesurfer recon-all autorecon1 (refined) failed for ${WORKDIR}, running again with -notalairach option"
	    if ! recon-all -norandomness -openmp ${OMP_NUM_THREADS} -sd ${FS_DIR} -autorecon1 -noskullstrip -clean-tal -notalairach -no-isrunning -s ${subject} -rng-seed 1234 &>  ${FS_LOG_FILE}; then
		freesurfer_err_msg ${FS_SUBJECT_DIR} "ERROR:${FS_SUBJECT_DIR}: freesurfer recon-all autorecon1 failed" ${FS_LOG_FILE}
	    fi

	fi

	if [ "`tail -1 ${FS_LOG_FILE}`" != "done" ]; then 
	    freesurfer_err_msg ${FS_SUBJECT_DIR} "ERROR:${FS_SUBJECT_DIR}: freesurfer recon-all autorecon1 did not complete correctly - possible solution provided in this script!" ${FS_LOG_FILE}
	    # if it fails bc of Talairach Transform
	    # then install missing lib to make  mni_autoreg work or manually create the the transform by following the instructions outlined in  https://surfer.nmr.mgh.harvard.edu/fswiki/FsTutorial/Talairach_freeview
	    # 1) Open up the talairach registration results with tkregister2
            #    export SUBJECTS_DIR=<case>/<arm>/<visit>/structural/longitudinal/freesurfer_refined
            #    cd $SUBJECT_DIR
            #    ./tkregister2 --mgz --s template_baseline_1y_2y_3y_4y --fstal
	    # 2) visuall confirm failure
	    # 3) translate, rotate, scale to correct the registration.
	    # 4) Save the xfm file 
            # 5) Create a README file how the xfm file was created 
            # 6) Put the README and talairach.xfm under structural/longitudinal/freesurfer_refined/manual/<template>/mri/transforms/ (path must include manual/)
            # 7) rm -rf structural/longitudinal/freesurfer_refined/template_baseline_1y_2y_3y_4y/mri/transforms    
	    # 8) Run script again comenting out freesurfer_reset
	fi   

	# Create links for masked brain image to the original image (which we made sure is already masked)
	# brainmask from T1.mgz has holes, so replaced T1.mgz to orig.mgz
	for file in brainmask.auto.mgz brainmask.mgz; do
	    if [ ! -f ${FS_SUBJECT_DIR}/mri/${file} ]; then
		pushd ${FS_SUBJECT_DIR}/mri > /dev/null
		ln -s orig.mgz ${file}
		popd > /dev/null
	    else 
		echo "WARNING:${FS_SUBJECT_DIR}: skipped pushd ${FS_DIR}/${FS_SUBJECT_DIR}/mri; ln -s orig.mgz ${file}; popd"
	    fi
	done

	echo "INFO:${FS_SUBJECT_DIR}: freesurfer stage 1 completed"
	LWDP_lockfile_delete ${lastfile_stage_1}
    fi
}

