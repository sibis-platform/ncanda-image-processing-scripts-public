##############################################################################################################

#
# Refine alignment with SRI24 atlas based on FA map
#

convert_ants_warp_to_cmtk_nrrd()
{
  local warp=$1
  local ref_image=$2
  local inp_image=$3
  local output_nrrd=$4

  local tmpdir=$(mktemp -d)

  # fix header information
  c3d c3d ${ref_image} -o ${tmpdir}/ref_image.nii.gz
  c3d c3d ${inp_image} -o ${tmpdir}/inp_image.nii.gz
  ref_image=${tmpdir}/ref_image.nii.gz
  inp_image=${tmpdir}/inp_image.nii.gz

  c3d c3d -mcs ${warp} -oo ${tmpdir}/warp_x.nii ${tmpdir}/warp_y.nii ${tmpdir}/warp_z.nii

  ref_orient=`c3d c3d ${ref_image} -info-full | grep -i orient | cut -d ":" -f2 | tr -d " "`
  ref_dim_x=`fsl fslval ${ref_image} dim1 | tr -d " "`
  ref_dim_y=`fsl fslval ${ref_image} dim2 | tr -d " "`
  ref_dim_z=`fsl fslval ${ref_image} dim3 | tr -d " "`
  ref_spacing_x=`fsl fslval ${ref_image} pixdim1 | tr -d " "`
  ref_spacing_y=`fsl fslval ${ref_image} pixdim2 | tr -d " "`
  ref_spacing_z=`fsl fslval ${ref_image} pixdim3 | tr -d " "`
  ref_origin_x=`c3d c3d ${ref_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f1`
  ref_origin_y=`c3d c3d ${ref_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f2`
  ref_origin_z=`c3d c3d ${ref_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f3`
  inp_orient=`c3d c3d ${inp_image} -info-full | grep -i orient | cut -d ":" -f2 | tr -d " "`
  inp_origin_x=`c3d c3d ${inp_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f1`
  inp_origin_y=`c3d c3d ${inp_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f2`
  inp_origin_z=`c3d c3d ${inp_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f3`
  if [[ "${ref_orient}" == *"L"*  && "${inp_orient}" == *"R"* ]]; then
    expr_x="${ref_dim_x}*${ref_spacing_x}-(a+(${ref_origin_x})-(${inp_origin_x}))"
  elif [[ "${ref_orient}" == *"R"*  && "${inp_orient}" == *"L"* ]]; then
    expr_x="${ref_dim_x}*${ref_spacing_x}+(a+(${ref_origin_x})-(${inp_origin_x}))"
  else
    # this function is not verified for L to L or R to R cases
    echo "WARNING: convert_warp_to_cmtk_nrrd is not verified for ${ref_orient} to ${inp_orient} cases."
    expr_x="a+(${ref_origin_x})-(${inp_origin_x})"
  fi
  if [[ "${ref_orient}" == *"P"*  && "${inp_orient}" == *"A"* ]]; then
    expr_y="${ref_dim_y}*${ref_spacing_y}-(a+(${ref_origin_y})-(${inp_origin_y}))"
  elif [[ "${ref_orient}" == *"A"*  && "${inp_orient}" == *"P"* ]]; then
    expr_y="${ref_dim_y}*${ref_spacing_y}+(a+(${ref_origin_y})-(${inp_origin_y}))"
  else
    # this function is not verified for P to A or A to P cases
    echo "WARNING: convert_warp_to_cmtk_nrrd is not verified for ${ref_orient} to ${inp_orient} cases."
    expr_y="a+(${ref_origin_y})-(${inp_origin_y})"
  fi
  if [[ "${ref_orient}" == *"S"*  && "${inp_orient}" == *"I"* ]]; then
    # this function is not verified for S to I cases
    echo "WARNING: convert_warp_to_cmtk_nrrd is not verified for ${ref_orient} to ${inp_orient} cases."
    expr_z="${ref_dim_z}*${ref_spacing_z}-(a+(${ref_origin_z})-(${inp_origin_z}))"
  elif [[ "${ref_orient}" == *"I"*  && "${inp_orient}" == *"S"* ]]; then
    # this function is not verified for I to S cases
    echo "WARNING: convert_warp_to_cmtk_nrrd is not verified for ${ref_orient} to ${inp_orient} cases."
    expr_z="${ref_dim_z}*${ref_spacing_z}+(a+(${ref_origin_z})-(${inp_origin_z}))"
  else
    expr_z="a+(${ref_origin_z})-(${inp_origin_z})"
  fi

  afni 3dcalc -a ${tmpdir}/warp_x.nii -expr "${expr_x}" -prefix ${tmpdir}/warp_x_fixed.nii
  afni 3dcalc -a ${tmpdir}/warp_y.nii -expr "${expr_y}" -prefix ${tmpdir}/warp_y_fixed.nii
  afni 3dcalc -a ${tmpdir}/warp_z.nii -expr "${expr_z}" -prefix ${tmpdir}/warp_z_fixed.nii

  c3d c3d ${tmpdir}/warp_x_fixed.nii -origin 0x0x0mm -o ${tmpdir}/warp_x_fixed_o.nii
  c3d c3d ${tmpdir}/warp_y_fixed.nii -origin 0x0x0mm -o ${tmpdir}/warp_y_fixed_o.nii
  c3d c3d ${tmpdir}/warp_z_fixed.nii -origin 0x0x0mm -o ${tmpdir}/warp_z_fixed_o.nii

  c3d c3d ${tmpdir}/warp_x_fixed_o.nii ${tmpdir}/warp_y_fixed_o.nii ${tmpdir}/warp_z_fixed_o.nii -omc ${output_nrrd}

  rm -rf ${tmpdir}
}

refine_sri24_warp_fa()
{
  local branch=$1
  local dti_dir=$2
  local dti=$3
  local fa_subject=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/${dti_dir}/${dti}_fa.nii.gz)
  local fa_atlas=${DATA_DIR}/sri24/sri24_fa.nii.gz

  sri24_fa_warp=${DIFFUSION_DIR}/${branch}/registration/sri24_fa/ants_0Warp.nii.gz
  if LWDP_needs_update_and_lock ${sri24_fa_warp} ${fa_subject} ${fa_atlas} ${b0_t1_mtx} ${t1_sri24_mtx}; then
    ants antsApplyTransforms -d 3 -o [${sri24_fa_warp},1] -r ${fa_atlas} -t ${sri24_t1_mtx} ${t1_b0_mtx}
    LWDP_lockfile_delete ${sri24_fa_warp}
  fi
  export sri24_fa_warp=$(LWDP_get_override_file ${sri24_fa_warp})

  sri24_fa_refine_xfm=${DIFFUSION_DIR}/${branch}/registration/sri24_fa_refine/atlas_subject.xform
  if LWDP_needs_update_and_lock ${sri24_fa_refine_xfm} ${fa_subject} ${fa_atlas} ${sri24_fa_warp}; then
    tmpdir=$(mktemp -d)
    convert_ants_warp_to_cmtk_nrrd ${sri24_fa_warp} ${fa_atlas} ${fa_subject} ${tmpdir}/dfield.nrrd
    cmtk fit_spline_dfield --final-cp-spacing 20 --levels 2 --fit-affine-first ${tmpdir}/dfield.nrrd ${tmpdir}/spline.xform
    cmtk warpx -v -o ${sri24_fa_refine_xfm} --max-stepsize 2.56 --min-stepsize 0.04 --grid-refine 2 --delay-refine --ignore-edge 1 --fast --smoothness-constraint-weight 0.1 --ncc --initial ${tmpdir}/spline.xform ${fa_atlas} ${fa_subject}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${sri24_fa_refine_xfm}
  fi
  export sri24_fa_refine_xfm=$(LWDP_get_override_file ${sri24_fa_refine_xfm})

  fa_sri24_warp=${DIFFUSION_DIR}/${branch}/registration/fa_sri24/ants_0Warp.nii.gz
  if LWDP_needs_update_and_lock ${fa_sri24_warp} ${fa_subject} ${fa_atlas} ${b0_t1_mtx} ${t1_sri24_mtx}; then
    ants antsApplyTransforms -d 3 -o [${fa_sri24_warp},1] -r ${fa_subject} -t ${b0_t1_mtx} ${t1_sri24_mtx}
    LWDP_lockfile_delete ${fa_sri24_warp}
  fi
  export fa_sri24_warp=$(LWDP_get_override_file ${fa_sri24_warp})

  fa_sri24_refine_xfm=${DIFFUSION_DIR}/${branch}/registration/fa_sri24_refine/subject_atlas.xform
  if LWDP_needs_update_and_lock ${fa_sri24_refine_xfm} ${fa_subject} ${fa_atlas} ${fa_sri24_warp}; then
    tmpdir=$(mktemp -d)
    convert_ants_warp_to_cmtk_nrrd ${fa_sri24_warp} ${fa_subject} ${fa_atlas} ${tmpdir}/dfield.nrrd
    cmtk fit_spline_dfield --final-cp-spacing 20 --levels 2 --fit-affine-first ${tmpdir}/dfield.nrrd ${tmpdir}/spline.xform
    cmtk warpx -v -o ${fa_sri24_refine_xfm} --max-stepsize 2.56 --min-stepsize 0.04 --grid-refine 2 --delay-refine --ignore-edge 1 --fast --smoothness-constraint-weight 0.1 --ncc --initial ${tmpdir}/spline.xform ${fa_subject} ${fa_atlas}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${fa_sri24_refine_xfm}
  fi
  export fa_sri24_refine_xfm=$(LWDP_get_override_file ${fa_sri24_refine_xfm})
}

#refine_sri24_warp_fa freewater fwdti_te fwdti
refine_sri24_warp_fa freewater fwdti_te dti

#
# Reslice scalar maps to atlas space
#

reslice_scalar_to_atlas()
{
  local branch=$1
  local dti_dir=$2
  local dti=$3
  local fa_atlas=${DATA_DIR}/sri24/sri24_fa.nii.gz
  if [ "${dti}" == "dti" ]; then
    map_list="fa md l1 lt"
  else
    map_list="fa md l1 lt f"
  fi

  for map in ${map_list}; do
    local input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/${dti_dir}/${dti}_${map}.nii.gz)
    local output=${DIFFUSION_DIR}/${branch}/reslice/sri24/ffd/${dti_dir}/${dti}_${map}.nii.gz
    if LWDP_needs_update_and_lock ${output} ${input} ${sri24_fa_warp} ${fa_atlas}; then
      ants antsApplyTransforms -n Linear -i ${input} -r ${fa_atlas} -o ${output} -t ${sri24_fa_warp}
      c3d c3d ${output} -type float -o ${output}
      LWDP_lockfile_delete ${output}
    fi
  done

  for map in ${map_list}; do
    local input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/${dti_dir}/${dti}_${map}.nii.gz)
    local output=${DIFFUSION_DIR}/${branch}/reslice/sri24/ffd_refine/${dti_dir}/${dti}_${map}.nii.gz
    if LWDP_needs_update_and_lock ${output} ${input} ${sri24_fa_refine_xfm} ${fa_atlas}; then
      cmtk reformatx --linear -o ${output} --floating ${input} ${fa_atlas} ${sri24_fa_refine_xfm}
      LWDP_lockfile_delete ${output}
    fi
  done

  for map in ${map_list}; do
    local input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/${dti_dir}/${dti}_${map}.nii.gz)
    local output=${DIFFUSION_DIR}/${branch}/reslice/sri24/affine/${dti_dir}/${dti}_${map}.nii.gz
    if LWDP_needs_update_and_lock ${output} ${input} ${xfm_t1_sri24} ${xfm_bl_t1} ${fa_atlas} ${xfm_t1_dwi}; then
      ants antsApplyTransforms -d 3 -n Linear -i ${input} -r ${fa_atlas} -o ${output} -t ${sri24_t1_mtx_affine} ${t1_b0_mtx}
      c3d c3d ${output} -type float -o ${output}
      LWDP_lockfile_delete ${output}
    fi
  done
}

reslice_scalar_to_atlas freewater fwdti_te fwdti
reslice_scalar_to_atlas freewater fwdti_te dti
reslice_scalar_to_atlas freewater fwdti_te_csf fwdti
reslice_scalar_to_atlas freewater fwdti_te_csf dti

#
# Reslice scalar maps to subject T1w space (for subcortical tissue segmentation etc.)
#

reslice_scalar_to_t1w()
{
  local branch=$1
  local dti_dir=$2
  local dti=$3
  local t1_mrbias=$(LWDP_get_override_file ${WORKDIR}/structural/mrbias/t1.nii.gz)
  if [ "${dti}" == "dti" ]; then
    map_list="fa md l1 lt"
  else
    map_list="fa md l1 lt f"
  fi

  for map in ${map_list}; do
    local input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/${dti_dir}/${dti}_${map}.nii.gz)
    local output=${DIFFUSION_DIR}/${branch}/reslice/subject_t1/${dti_dir}/${dti}_${map}.nii.gz
    if LWDP_needs_update_and_lock ${output} ${input} ${t1_mrbias} ${b0_t1_mtx}; then
      ants antsApplyTransforms -d 3 -n Linear -i ${input} -r ${t1_mrbias} -o ${output} -t ${t1_b0_mtx}
      c3d c3d ${output} -type float -o ${output}
      LWDP_lockfile_delete ${output}
    fi
  done
}

reslice_scalar_to_t1w freewater fwdti_te fwdti
reslice_scalar_to_t1w freewater fwdti_te dti
reslice_scalar_to_t1w freewater fwdti_te_csf fwdti
reslice_scalar_to_t1w freewater fwdti_te_csf dti

