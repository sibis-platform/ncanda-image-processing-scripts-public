#
# measure mean intensity
#

for branch in pepolar; do
  fa_atlas=${DATA_DIR}/sri24/sri24_fa.nii.gz
  roi_image=${DATA_DIR}/sri24/parcellation/sri24_parc116.nii.gz
  roi_label=${DATA_DIR}/sri24/parcellation/sri24_parc116.txt

  if [ "${branch}" == "pepolar" ]; then
    bAverage_aligned_to_atlas=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/bAverage.nii.gz
    roi_measure=${DIFFUSION_DIR}/${branch}/measures/sri24/warp_refine/parc116_bAverage.csv
  fi
  #
  if LWDP_needs_update_and_lock ${roi_measure} ${roi_image} ${bAverage_aligned_to_atlas}; then
    if [ -e ${roi_measure} ]; then
      rm -f ${roi_measure}
    fi

    echo "label,volume,mean" >> ${roi_measure}

    roi_vol=`cmtk vol2csv ${roi_image} ${bAverage_aligned_to_atlas}`
    roi_vol_num=`echo ${roi_vol} | wc -w`
    roi_label_list=`cat ${roi_label} | tr -s "\t" " " | cut -d " " -f1,2 --output-delimiter=","`

    for roi_vol_idx in `seq 3 ${roi_vol_num}`; do
      roi_vol_i=`echo ${roi_vol} | cut -d " " -f${roi_vol_idx} | cut -d "," -f1`

      found=0
      for roi in ${roi_label_list}; do
        roi_idx=`echo ${roi} | cut -d "," -f1`
        roi_text=`echo ${roi} | cut -d "," -f2`
        if [ ${roi_vol_i} -eq ${roi_idx} ]; then
          found=1
          break
        fi
      done
      if [ ${found} -eq 0 ]; then
        continue
      fi

      num=`echo ${roi_vol} | cut -d " " -f${roi_vol_idx} | cut -d "," -f2`
      sum=`echo ${roi_vol} | cut -d " " -f${roi_vol_idx} | cut -d "," -f3`
      num=`printf "%.0f" ${num}`
      sum=`printf "%.6f" ${sum}`
      roi_val=`printf "%.6f" $(bc -l <<< ${sum}/${num})`
      echo "\"${roi_text}\",${num},${roi_val}" >> ${roi_measure}
    done

    LWDP_lockfile_delete ${roi_measure}
  fi
done

#
# Do skeletonization for TBSS
#

tbss_compute_mean_masked()
{
  local input_mod=$1
  local mean_fa_mask=$2
  local output_mod_mean_masked=$3

  local tmpdir=$(mktemp -d)

  X=$(fsl fslval ${input_mod} dim1); X=$(echo "$X 2 - p" | dc -)
  Y=$(fsl fslval ${input_mod} dim2); Y=$(echo "$Y 2 - p" | dc -)
  Z=$(fsl fslval ${input_mod} dim3); Z=$(echo "$Z 2 - p" | dc -)
  fsl fslmaths ${input_mod} -min 1 -ero -roi 1 $X 1 $Y 1 $Z 0 1 ${tmpdir}/mod
  fsl fslmaths ${tmpdir}/mod -mas ${mean_fa_mask} ${output_mod_mean_masked}

  rm -rf ${tmpdir}
}

tbss_generate_skeleton()
{
  local branch=$1
  local tbss_template=$2

  if [ "${branch}" == "pepolar" ] || [ "${branch}" == "pepolar_long" ]; then
    # factors computed by djk on 8/23/16 with new pipeline for eddy ffd_refine
    #global_factor=("0.905606" "1.044563" "0.996833" "1.101418")
    #global_add_factor=("-0.0524966" "0.0000354" "-0.0000045" "0.0001058")
    # factors computed by djk on 9/08/16 with new pipeline for eddy warp
    #global_factor=("0.928264" "1.031227" "1.002093" "1.062373")
    #global_add_factor=("-0.0380634" "0.0000252" "0.0000025" "0.0000685")
    # factors computed by djk on 9/16/16 with new pipeline for eddy warp_refine
    global_factor=("0.926079" "1.041556" "1.007434" "1.079210")
    global_add_factor=("-0.0393084" "0.0000336" "0.0000098" "0.0000866")
    local_mul_factor[0]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/fa_GE_Siemens_local_mul.nii.gz
    local_mul_factor[1]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/md_GE_Siemens_local_mul.nii.gz
    local_mul_factor[2]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/l1_GE_Siemens_local_mul.nii.gz
    local_mul_factor[3]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/lt_GE_Siemens_local_mul.nii.gz
    local_add_factor[0]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/fa_GE_Siemens_local_add.nii.gz
    local_add_factor[1]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/md_GE_Siemens_local_add.nii.gz
    local_add_factor[2]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/l1_GE_Siemens_local_add.nii.gz
    local_add_factor[3]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/lt_GE_Siemens_local_add.nii.gz
  fi

  # these are some conservative maximum values for each mod
  clip_max=("1" "0.003" "0.004" "0.005")

  if [ "${branch}" == "pepolar" ]; then
    local tbss_template_dir=${DATA_DIR}/tbss/${branch}/${tbss_template}
    local tbss_out_dir=${DIFFUSION_DIR}/${branch}/tbss/sri24/warp_refine/${tbss_template}
  elif [ "${branch}" == "pepolar_long" ]; then
    local tbss_template_dir=${DATA_DIR}/tbss/pepolar/${tbss_template}
    local tbss_out_dir=${DIFFUSION_DIR}/pepolar/longitudinal/tbss/sri24/warp_refine/${tbss_template}
  fi

  # this is copied from stats_all with no correction factor
  local mean_fa=${tbss_template_dir}/mean_FA.nii.gz
  local mean_fa_mask=${tbss_template_dir}/mean_FA_mask.nii.gz
  local mean_fa_skel_dst=${tbss_template_dir}/mean_FA_skeleton_mask_dst.nii.gz
  local sri_cingulum=${DATA_DIR}/tbss/sri_cingulum.nii.gz

  local mean_fa_corrected[1]=${tbss_template_dir}/mean_FA_corrected_global.nii.gz
  local mean_fa_corrected[2]=${tbss_template_dir}/mean_FA_corrected_global.nii.gz
  local mean_fa_corrected[3]=${tbss_template_dir}/mean_FA_corrected_local_mul.nii.gz
  local mean_fa_corrected[4]=${tbss_template_dir}/mean_FA_corrected_local_mul.nii.gz
  local mean_fa_corrected_skel_dst[1]=${tbss_template_dir}/mean_FA_corrected_global_skeleton_mask_dst.nii.gz
  local mean_fa_corrected_skel_dst[2]=${tbss_template_dir}/mean_FA_corrected_global_skeleton_mask_dst.nii.gz
  local mean_fa_corrected_skel_dst[3]=${tbss_template_dir}/mean_FA_corrected_local_mul_skeleton_mask_dst.nii.gz
  local mean_fa_corrected_skel_dst[4]=${tbss_template_dir}/mean_FA_corrected_local_mul_skeleton_mask_dst.nii.gz

  # Generate FA projection first
  if [ "${branch}" == "pepolar" ]; then
    local input_fa=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/fa.nii)
  elif [ "${branch}" == "pepolar_long" ]; then
    local input_fa=$(LWDP_get_override_file ${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/fa.nii)
  fi
  local fa_mean_masked=${tbss_out_dir}/fa_mean_masked.nii.gz
  if LWDP_needs_update_and_lock ${fa_mean_masked} ${input_fa} ${mean_fa_mask}; then
    tbss_compute_mean_masked ${input_fa} ${mean_fa_mask} ${fa_mean_masked}
    LWDP_lockfile_delete ${fa_mean_masked}
  fi

  local fa_skeleton=${tbss_out_dir}/fa_skeleton.nii.gz
  if LWDP_needs_update_and_lock ${fa_skeleton} ${mean_fa} ${mean_fa_skel_dst} ${fa_mean_masked} ${sri_cingulum}; then
    fsl tbss_skeleton -i ${mean_fa} -p 0.2 ${mean_fa_skel_dst} ${sri_cingulum} ${fa_mean_masked} ${fa_skeleton}
    LWDP_lockfile_delete ${fa_skeleton}
  fi

  local fa_corrected_mean_masked[1]=${tbss_out_dir}/fa_corrected_global_mean_masked.nii.gz
  local fa_corrected_mean_masked[2]=${tbss_out_dir}/fa_corrected_global_add_mean_masked.nii.gz
  local fa_corrected_mean_masked[3]=${tbss_out_dir}/fa_corrected_local_mul_mean_masked.nii.gz
  local fa_corrected_mean_masked[4]=${tbss_out_dir}/fa_corrected_local_add_mean_masked.nii.gz
  local fa_corrected_skeleton[1]=${tbss_out_dir}/fa_corrected_global_skeleton.nii.gz
  local fa_corrected_skeleton[2]=${tbss_out_dir}/fa_corrected_global_add_skeleton.nii.gz
  local fa_corrected_skeleton[3]=${tbss_out_dir}/fa_corrected_local_mul_skeleton.nii.gz
  local fa_corrected_skeleton[4]=${tbss_out_dir}/fa_corrected_local_add_skeleton.nii.gz
  for corr_idx in 1 2 3 4; do
    if LWDP_needs_update_and_lock ${fa_corrected_mean_masked[${corr_idx}]} ${fa_mean_masked}; then
      if [ "${SITE}" == "A" -o "${SITE}" == "D" ]; then
        if [ ${corr_idx} -eq 1 ]; then
          # fsl fslmaths  ${fa_mean_masked} -mul 0.911261182 ${fa_corrected_mean_masked[${corr_idx}]}
          # Factor published in NI:
          # fsl fslmaths  ${fa_mean_masked} -mul 0.916201 ${fa_corrected_mean_masked[${corr_idx}]}
          fsl fslmaths  ${fa_mean_masked} -mul ${global_factor[0]} ${fa_corrected_mean_masked[${corr_idx}]}
        elif [ ${corr_idx} -eq 2 ]; then
          fsl fslmaths  ${fa_mean_masked} -add ${global_add_factor[0]} ${fa_corrected_mean_masked[${corr_idx}]}
        elif [ ${corr_idx} -eq 3 ]; then
          # multiply local factor and clip intensities
          c3d c3d ${fa_mean_masked} ${local_mul_factor[0]} -multiply -clip 0 ${clip_max[0]} -o ${fa_corrected_mean_masked[${corr_idx}]}
        elif [ ${corr_idx} -eq 4 ]; then
          # add local factor and clip intensities
          c3d c3d ${fa_mean_masked} ${local_add_factor[0]} -add -clip 0 ${clip_max[0]} -o ${fa_corrected_mean_masked[${corr_idx}]}
        fi
      else
        cp ${fa_mean_masked} ${fa_corrected_mean_masked[${corr_idx}]}
      fi
      LWDP_lockfile_delete ${fa_corrected_mean_masked[${corr_idx}]}
    fi
    if LWDP_needs_update_and_lock ${fa_corrected_skeleton[${corr_idx}]} ${mean_fa_corrected[${corr_idx}]} ${mean_fa_corrected_skel_dst[${corr_idx}]} ${sri_cingulum} ${fa_corrected_mean_masked[${corr_idx}]}; then
      fsl tbss_skeleton -i ${mean_fa_corrected[${corr_idx}]} -p 0.2 ${mean_fa_corrected_skel_dst[${corr_idx}]} ${sri_cingulum} ${fa_corrected_mean_masked[${corr_idx}]} ${fa_corrected_skeleton[${corr_idx}]}
      LWDP_lockfile_delete ${fa_corrected_skeleton[${corr_idx}]}
    fi
  done

  # Now project the other diffusion measures
  for mod in md l1 lt; do
    if [ "${branch}" == "pepolar" ]; then
      local input_mod=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/${mod}.nii)
    elif [ "${branch}" == "pepolar_long" ]; then
      local input_mod=$(LWDP_get_override_file ${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/${mod}.nii)
    fi
    local output_mean_masked=${tbss_out_dir}/${mod}_mean_masked.nii.gz

    if LWDP_needs_update_and_lock ${output_mean_masked} ${input_mod} ${mean_fa_mask}; then
      tbss_compute_mean_masked ${input_mod} ${mean_fa_mask} ${output_mean_masked}
      LWDP_lockfile_delete ${output_mean_masked}
    fi

    local output_mod=${tbss_out_dir}/${mod}_skeleton.nii.gz
    if LWDP_needs_update_and_lock ${output_mod} ${mean_fa} ${mean_fa_skel_dst} ${sri_cingulum} ${fa_mean_masked} ${output_mean_masked} ; then
      fsl tbss_skeleton -i ${mean_fa} -p 0.2 ${mean_fa_skel_dst} ${sri_cingulum} ${fa_mean_masked} ${output_mod} -a ${output_mean_masked}
      LWDP_lockfile_delete ${output_mod}
    fi

    local output_corrected_mod[1]=${tbss_out_dir}/${mod}_corrected_global_skeleton.nii.gz
    local output_corrected_mod[2]=${tbss_out_dir}/${mod}_corrected_global_add_skeleton.nii.gz
    local output_corrected_mod[3]=${tbss_out_dir}/${mod}_corrected_local_mul_skeleton.nii.gz
    local output_corrected_mod[4]=${tbss_out_dir}/${mod}_corrected_local_add_skeleton.nii.gz
    for corr_idx in 1 2 3 4; do
      # test code
      if [ ${corr_idx} -eq 1 ]; then
        local mod_corrected=${tbss_out_dir}/${mod}_corrected_global_mean_masked.nii.gz
        if LWDP_needs_update_and_lock ${mod_corrected} ${output_mean_masked}; then
          if [ "${SITE}" == "A" -o "${SITE}" == "D" ]; then
            if [ "$mod" == "md" ]; then
              fsl fslmaths ${output_mean_masked} -mul ${global_factor[1]} ${mod_corrected}
            elif [ "$mod" == "l1" ]; then
              fsl fslmaths ${output_mean_masked} -mul ${global_factor[2]} ${mod_corrected}
            elif [ "$mod" == "lt" ]; then
              fsl fslmaths ${output_mean_masked} -mul ${global_factor[3]} ${mod_corrected}
            fi
          else
            cp ${output_mean_masked} ${mod_corrected}
          fi
          LWDP_lockfile_delete ${mod_corrected}
        fi
      fi
      #
      if LWDP_needs_update_and_lock ${output_corrected_mod[${corr_idx}]} ${output_mean_masked} ${mean_fa_corrected[${corr_idx}]} ${mean_fa_corrected_skel_dst[${corr_idx}]} ${sri_cingulum} ${fa_corrected_mean_masked[${corr_idx}]}; then
        tmpdir=$(mktemp -d)

        if [ "${SITE}" == "A" -o "${SITE}" == "D" ]; then
          local mod_corrected=${tmpdir}/${mod}_mean_masked_corrected.nii.gz

          if [ "$mod" == "md" ]; then
            if [ ${corr_idx} -eq 1 ]; then
              # factor=1.040387696
              # Factor published in NI:
              # factor=1.035314
              fsl fslmaths ${output_mean_masked} -mul ${global_factor[1]} ${mod_corrected}
            elif [ ${corr_idx} -eq 2 ]; then
              fsl fslmaths ${output_mean_masked} -add ${global_add_factor[1]} ${mod_corrected}
            elif [ ${corr_idx} -eq 3 ]; then
              # multiply local factor and clip intensities
              c3d c3d ${output_mean_masked} ${local_mul_factor[1]} -multiply -clip 0 ${clip_max[1]} -o ${mod_corrected}
            elif [ ${corr_idx} -eq 4 ]; then
              # add local factor and clip intensities
              c3d c3d ${output_mean_masked} ${local_add_factor[1]} -add -clip 0 ${clip_max[1]} -o ${mod_corrected}
            fi
          fi
          if [ "$mod" == "l1" ]; then
            if [ ${corr_idx} -eq 1 ]; then
              # factor=0.99854109
              # Factor published in NI:
              # factor=0.996488
              fsl fslmaths ${output_mean_masked} -mul ${global_factor[2]} ${mod_corrected}
            elif [ ${corr_idx} -eq 2 ]; then
              fsl fslmaths ${output_mean_masked} -add ${global_add_factor[2]} ${mod_corrected}
            elif [ ${corr_idx} -eq 3 ]; then
              # multiply local factor and clip intensities
              c3d c3d ${output_mean_masked} ${local_mul_factor[2]} -multiply -clip 0 ${clip_max[2]} -o ${mod_corrected}
            elif [ ${corr_idx} -eq 4 ]; then
              # add local factor and clip intensities
              c3d c3d ${output_mean_masked} ${local_add_factor[2]} -add -clip 0 ${clip_max[2]} -o ${mod_corrected}
            fi
          fi
          if [ "$mod" == "lt" ]; then
            if [ ${corr_idx} -eq 1 ]; then
              # factor=1.085982038
              # Factor published in NI:
              # factor= 1.077257
              fsl fslmaths ${output_mean_masked} -mul ${global_factor[3]} ${mod_corrected}
            elif [ ${corr_idx} -eq 2 ]; then
              fsl fslmaths ${output_mean_masked} -add ${global_add_factor[3]} ${mod_corrected}
            elif [ ${corr_idx} -eq 3 ]; then
              # multiply local factor and clip intensities
              c3d c3d ${output_mean_masked} ${local_mul_factor[3]} -multiply -clip 0 ${clip_max[3]} -o ${mod_corrected}
            elif [ ${corr_idx} -eq 4 ]; then
              # add local factor and clip intensities
              c3d c3d ${output_mean_masked} ${local_add_factor[3]} -add -clip 0 ${clip_max[3]} -o ${mod_corrected}
            fi
          fi
        else
          mod_corrected=${output_mean_masked}
        fi

        fsl tbss_skeleton -i ${mean_fa_corrected[${corr_idx}]} -p 0.2 ${mean_fa_corrected_skel_dst[${corr_idx}]} ${sri_cingulum} ${fa_corrected_mean_masked[${corr_idx}]} ${output_corrected_mod[${corr_idx}]} -a ${mod_corrected}

        rm -rf ${tmpdir}
        LWDP_lockfile_delete ${output_corrected_mod[${corr_idx}]}
      fi
    done
  done

  ## phantoms use symbolic links which LWDP_needs_update_and_lock cannot deal with so check it this way
  # local fa_skeleton_correction_factor=$3
  # local fa_skeleton_corrected=${tbss_out_dir}/fa_skeleton_corrected.nii.gz
  # if LWDP_needs_update_and_lock ${fa_skeleton_corrected} ${fa_skeleton}; then
  #   if [ "${SITE}" == "A" -o "${SITE}" == "D" ]; then
  #     CMD="fsl fslmaths ${fa_skeleton} -mul ${fa_skeleton_correction_factor} ${fa_skeleton_corrected}"
  #   else
  #     CMD="cp ${fa_skeleton} ${fa_skeleton_corrected}"
  #   fi
  #   log_and_execute "$CMD" ${fa_skeleton_corrected}
  #   LWDP_lockfile_delete ${fa_skeleton_corrected}
  # fi
}

TBSS_TEMPLATE_DIR=${DATA_DIR}/tbss/pepolar/ncanda_baseline_meet_criteria
if [ -e "${TBSS_TEMPLATE_DIR}/mean_FA.nii.gz" ]; then
  tbss_generate_skeleton pepolar ncanda_baseline_meet_criteria
  if [ "${VISIT}" != "${VISIT_REF}" ]; then
    tbss_generate_skeleton pepolar_long ncanda_baseline_meet_criteria
  fi
else
  echo "INFO: ${TBSS_TEMPLATE_DIR} not found; skipping TBSS skeleton projection"
fi

#
# Generate measures
#

measure_noise()
{
  local branch=$1

  SEG=${DIFFUSION_DIR}/${branch}/reslice/b0_unwarp/sri24_parc116.nii.gz
  B0=${DIFFUSION_DIR}/${branch}/corrected/final/dti60-01.nii.gz
  OUT=${DIFFUSION_DIR}/${branch}/measures/final_b0_corpus_noise.csv

  if LWDP_needs_update_and_lock ${OUT} ${SEG} ${B0}; then
    tmpdir=$(mktemp -d)

    cmtk convertx --set-padding 0 --thresh-below-to-padding 134 --thresh-above-to-padding 134 --map-values-only 134:1 $SEG  ${tmpdir}/bin.nii.gz

    STATS=`cmtk statistics --mask  ${tmpdir}/bin.nii.gz ${B0} | sed '1d' | sed '2d' | tr $'\t' ,`
    rm -rf $tmpdir

    VALUES=`echo "$STATS" | tail -n1`
    MEAN=`echo "$VALUES" | cut -d, -f4`

    SDEV=`echo "$VALUES" | cut -d, -f5`
    SNR=`python3 -c "print (${MEAN}/${SDEV})"`

    # Rotation and tranlation component
    traList=""
    rotList=""
    for bXname in `cat ${DIFFUSION_DIR}/${branch}/camino/inclusion_list.txt`; do
      if [ "${branch}" == "pepolar" ]; then
        idx=`echo ${bXname} | cut -d "-" -f2`
        params=`sed "${idx}q;d" ${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp.eddy_parameters | tr -s " "`

        trans_x=`echo ${params} | cut -d " " -f1`
        trans_y=`echo ${params} | cut -d " " -f2`
        trans_z=`echo ${params} | cut -d " " -f3`
        rot_x=`echo ${params} | cut -d " " -f4`
        rot_y=`echo ${params} | cut -d " " -f5`
        rot_z=`echo ${params} | cut -d " " -f6`

        # sumTrans=`python3 -c "a = [${trans_x},${trans_y},${trans_z}]; import numpy.linalg as np; print np.norm(a)"`
        sumTrans=`python3 -c "import numpy.linalg as np; a = [${trans_x},${trans_y},${trans_z}]; print(np.norm(a))"`
        sumRot=`python3 -c "a = [${rot_x},${rot_y},${rot_z}]; print (sum(abs(x) for x in a))"`
      fi
      if [ "${traList}" == "" ]; then
        traList="${sumTrans}"
        rotList="${sumRot}"
      else
        traList+=",${sumTrans}"
        rotList+=",${sumRot}"
      fi
    done
    avgTrans=`python3 -c "a = [${traList}]; print (sum(a)/len(a))"`
    maxTrans=`python3 -c "x = [${traList}]; print (max(x))"`
    avgRot=`python3 -c "a = [${rotList}]; print (sum(a)/len(a))"`
    maxRot=`python3 -c "x = [${rotList}]; print (max(x))"`

    echo "`echo "${STATS}" | head -n1 | sed -e "s/,/,B0_cc_/g" | cut -d, -f2-`,B0_cc_signal_to_noise_ratio,avg_sum_norm_translation,max_sum_norm_translation,avg_sum_abs_rotation,max_sum_abs_rotation" > ${OUT}
    echo "`echo ${VALUES} | cut -d, -f2-`,${SNR},${avgTrans},${maxTrans},${avgRot},${maxRot}" >> ${OUT}

    LWDP_lockfile_delete ${OUT}
  fi
}

measure_noise pepolar

measure_mori_values()
{
  local input_pfx=$1
  local input_sfx=$2
  local smask=$3
  local output_pfx=$4
  local output_sfx=$5

  local mori_roi=${DATA_DIR}/sri24/parcellation/sri24_mori_roi_bilat_shifted.nii.gz
  local mori_roi_bin=${DATA_DIR}/sri24/parcellation/sri24_mori_roi_bilat_shifted_bin.nii.gz
  local mori_label=${DATA_DIR}/sri24/parcellation/sri24_mori_roi_bilat_shifted_short.txt
  local map=("fa" "md" "l1" "lt")
  local map_idx

  if LWDP_needs_update_and_lock ${output_pfx}${map[0]}${output_sfx} ${input_pfx}${map[0]}${input_sfx} ${input_pfx}${map[1]}${input_sfx} ${input_pfx}${map[2]}${input_sfx} ${input_pfx}${map[3]}${input_sfx} ${mori_roi} ${smask}; then
    tmpdir=$(mktemp -d)

    # init header
    header="subject,arm,visit"
    for map_idx in 0 1 2 3; do
      values[${map_idx}]="${SUBJECT},${ARM},${VISIT}"
    done

    # prepare masks
    if [ "${smask}" != "" ]; then
      c3d c3d ${mori_roi} ${smask} -multiply -o ${tmpdir}/mori_roi.nii.gz
      c3d c3d ${mori_roi_bin} ${smask} -multiply -o ${tmpdir}/mori_roi_bin.nii.gz
      mori_roi=${tmpdir}/mori_roi.nii.gz
      mori_roi_bin=${tmpdir}/mori_roi_bin.nii.gz
    fi

    # global mori
    header="${header},global_mori"
    for map_idx in 0 1 2 3; do
      input=${input_pfx}${map[${map_idx}]}${input_sfx}
      roi_val=`fsl fslstats ${input} -k ${mori_roi_bin} -m | tr -d " "`
      values[${map_idx}]="${values[${map_idx}]},${roi_val}"
    done

    # roi mori
    for map_idx in 0 1 2 3; do
      input=${input_pfx}${map[${map_idx}]}${input_sfx}
      roi_vol[${map_idx}]=`cmtk vol2csv ${mori_roi} ${input}`
    done

    roi_vol_idx=1
    for roi in `cat ${mori_label}`; do
      roi_idx=`echo ${roi} | cut -d "," -f1`
      roi_text=`echo ${roi} | cut -d "," -f2`
      let roi_vol_idx++

      if [ ${roi_idx} == "00" ]; then
        continue
      fi

      header="${header},${roi_text}"
      for map_idx in 0 1 2 3; do
        num=`echo ${roi_vol[${map_idx}]} | cut -d " " -f${roi_vol_idx} | cut -d "," -f2`
        sum=`echo ${roi_vol[${map_idx}]} | cut -d " " -f${roi_vol_idx} | cut -d "," -f3`
        roi_val=`printf "%.6f" $(bc -l <<< ${sum}/${num})`
        values[${map_idx}]="${values[${map_idx}]},${roi_val}"
      done
    done

    for map_idx in 0 1 2 3; do
      output=${output_pfx}${map[${map_idx}]}${output_sfx}
      if [ -e ${output} ]; then
        rm -f ${output}
      fi
      echo ${header} >> ${output}
      echo ${values[${map_idx}]} >> ${output}
    done

    rm -rf ${tmpdir}

    LWDP_lockfile_delete ${output_pfx}${map[0]}${output_sfx}
  fi
}

for branch in pepolar pepolar_long; do
  
  if [ "${branch}" == "pepolar" ]; then
    smask=${DATA_DIR}/tbss/${branch}/ncanda_baseline_meet_criteria/mean_FA_skeleton_mask.nii.gz
    smask_corrected_global=${DATA_DIR}/tbss/${branch}/ncanda_baseline_meet_criteria/mean_FA_corrected_global_skeleton_mask.nii.gz
    smask_corrected_local_mul=${DATA_DIR}/tbss/${branch}/ncanda_baseline_meet_criteria/mean_FA_corrected_local_mul_skeleton_mask.nii.gz

    measure_mori_values "${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/" ".nii.gz" "" "${DIFFUSION_DIR}/${branch}/measures/mori_warp_refine_" ".csv"
    if [ -e "${TBSS_TEMPLATE_DIR}/mean_FA.nii.gz" ]; then
    measure_mori_values "${DIFFUSION_DIR}/${branch}/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_global_mean_masked.nii.gz" "" "${DIFFUSION_DIR}/${branch}/measures/mori_warp_refine_corrected_global_" ".csv"

    measure_mori_values "${DIFFUSION_DIR}/${branch}/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_skeleton.nii.gz" "${smask}" "${DIFFUSION_DIR}/${branch}/measures/mori_ncanda_baseline_meet_criteria_" "_skeleton.csv"
    measure_mori_values "${DIFFUSION_DIR}/${branch}/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_global_skeleton.nii.gz" "${smask_corrected_global}" "${DIFFUSION_DIR}/${branch}/measures/mori_ncanda_baseline_meet_criteria_" "_corrected_global_skeleton.csv"
    measure_mori_values "${DIFFUSION_DIR}/${branch}/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_global_add_skeleton.nii.gz" "${smask_corrected_global}" "${DIFFUSION_DIR}/${branch}/measures/mori_ncanda_baseline_meet_criteria_" "_corrected_global_add_skeleton.csv"
    measure_mori_values "${DIFFUSION_DIR}/${branch}/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_local_mul_skeleton.nii.gz" "${smask_corrected_local_mul}" "${DIFFUSION_DIR}/${branch}/measures/mori_ncanda_baseline_meet_criteria_" "_corrected_local_mul_skeleton.csv"
    measure_mori_values "${DIFFUSION_DIR}/${branch}/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_local_add_skeleton.nii.gz" "${smask_corrected_local_mul}" "${DIFFUSION_DIR}/${branch}/measures/mori_ncanda_baseline_meet_criteria_" "_corrected_local_add_skeleton.csv"
    fi
  elif [ "${branch}" == "pepolar_long" ] && [ "${VISIT}" != "${VISIT_REF}" ]; then
    smask=${DATA_DIR}/tbss/pepolar/ncanda_baseline_meet_criteria/mean_FA_skeleton_mask.nii.gz
    smask_corrected_global=${DATA_DIR}/tbss/pepolar/ncanda_baseline_meet_criteria/mean_FA_corrected_global_skeleton_mask.nii.gz
    smask_corrected_local_mul=${DATA_DIR}/tbss/pepolar/ncanda_baseline_meet_criteria/mean_FA_corrected_local_mul_skeleton_mask.nii.gz

    measure_mori_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/" ".nii.gz" "" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/mori_warp_refine_" ".csv"
    if [ -e "${TBSS_TEMPLATE_DIR}/mean_FA.nii.gz" ]; then
    measure_mori_values "${DIFFUSION_DIR}/pepolar/longitudinal/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_global_mean_masked.nii.gz" "" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/mori_warp_refine_corrected_global_" ".csv"

    measure_mori_values "${DIFFUSION_DIR}/pepolar/longitudinal/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_skeleton.nii.gz" "${smask}" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/mori_ncanda_baseline_meet_criteria_" "_skeleton.csv"
    measure_mori_values "${DIFFUSION_DIR}/pepolar/longitudinal/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_global_skeleton.nii.gz" "${smask_corrected_global}" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/mori_ncanda_baseline_meet_criteria_" "_corrected_global_skeleton.csv"
    measure_mori_values "${DIFFUSION_DIR}/pepolar/longitudinal/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_global_add_skeleton.nii.gz" "${smask_corrected_global}" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/mori_ncanda_baseline_meet_criteria_" "_corrected_global_add_skeleton.csv"
    measure_mori_values "${DIFFUSION_DIR}/pepolar/longitudinal/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_local_mul_skeleton.nii.gz" "${smask_corrected_local_mul}" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/mori_ncanda_baseline_meet_criteria_" "_corrected_local_mul_skeleton.csv"
    measure_mori_values "${DIFFUSION_DIR}/pepolar/longitudinal/tbss/sri24/warp_refine/ncanda_baseline_meet_criteria/" "_corrected_local_add_skeleton.nii.gz" "${smask_corrected_local_mul}" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/mori_ncanda_baseline_meet_criteria_" "_corrected_local_add_skeleton.csv"
    fi
  fi
done

#
# Apply local correction factors
#

for branch in pepolar pepolar_long; do
  if [ "${branch}" == "pepolar_long" ] && [ "${VISIT}" == "${VISIT_REF}" ]; then
    continue
  fi
  if [ "${SITE}" == "A" -o "${SITE}" == "D" ]; then
    map=("fa" "md" "l1" "lt")
    # these are some conservative maximum values for each mod
    clip_max=("1" "0.003" "0.004" "0.005")

    for params in alpha_tv alpha_add_tv local_mul local_add local_avg_mul local_avg_add local_avg_whole_mul local_avg_whole_add; do
      if [ "${branch}" == "pepolar" ] || [ "${branch}" == "pepolar_long" ]; then
        # for ffd_refine
        # for warp
        # for warp refine
        local_factor[0]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/fa_GE_Siemens_${params}.nii.gz
        local_factor[1]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/md_GE_Siemens_${params}.nii.gz
        local_factor[2]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/l1_GE_Siemens_${params}.nii.gz
        local_factor[3]=${DATA_DIR}/dti_mfc_correction/pepolar/ncanda_human_phantoms/lt_GE_Siemens_${params}.nii.gz
      fi
      if [ ! -e ${local_factor[0]} ]; then
        continue
      fi

      if [ "${branch}" == "pepolar" ]; then
        corrected_dir=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/corrected/${params}
      elif [ "${branch}" == "pepolar_long" ]; then
        corrected_dir=${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/corrected/${params}
      fi
      [ -d ${corrected_dir} ] || mkdir -p ${corrected_dir}

      for map_idx in 0 1 2 3; do
        if [ "${branch}" == "pepolar" ]; then
          mod_input=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/${map[${map_idx}]}.nii.gz
        elif [ "${branch}" == "pepolar_long" ]; then
          mod_input=${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/${map[${map_idx}]}.nii.gz
        fi
        mod_corrected=${corrected_dir}/${map[${map_idx}]}.nii.gz
        if LWDP_needs_update_and_lock ${mod_corrected} ${mod_input} ${local_factor[${map_idx}]}; then
          if [ "${params}" == "alpha_tv" ] || [ "${params}" == "local_mul" ] || [ "${params}" == "local_avg_mul" ] || [ "${params}" == "local_avg_whole_mul" ]; then
            c3d c3d ${mod_input} ${local_factor[${map_idx}]} -multiply -clip 0 ${clip_max[${map_idx}]} -o ${mod_corrected}
          elif [ "${params}" == "alpha_add_tv" ] || [ "${params}" == "local_add" ] || [ "${params}" == "local_avg_add" ] || [ "${params}" == "local_avg_whole_add" ]; then
            c3d c3d ${mod_input} ${local_factor[${map_idx}]} -add -clip 0 ${clip_max[${map_idx}]} -o ${mod_corrected}
          fi
          LWDP_lockfile_delete ${mod_corrected}
        fi
      done

      if [ "${branch}" == "pepolar" ]; then
        measure_mori_values "${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/corrected/${params}/" ".nii.gz" "" "${DIFFUSION_DIR}/${branch}/measures/mori_warp_refine_corrected_${params}_" ".csv"
      elif [ "${branch}" == "pepolar_long" ]; then
        measure_mori_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/corrected/${params}/" ".nii.gz" "" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/mori_warp_refine_corrected_${params}_" ".csv"
      fi
    done
  fi
done

#
# measure global difference of aligned maps between baseline and followup
#

if [ "${VISIT}" != "baseline" ] && [ "${VISIT}" != "${VISIT_REF}" ]; then
  sri24_brainmask=${DATA_DIR}/sri24/sri24_brainmask.nii.gz
  map=("fa" "md" "l1" "lt")

  for branch in pepolar; do
    for map_idx in 0 1 2 3; do
      mod_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../${VISIT_REF}/diffusion/${branch}/reslice/sri24/warp_refine/${map[${map_idx}]}.nii.gz)
      mod=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/${map[${map_idx}]}.nii.gz
      out=${DIFFUSION_DIR}/${branch}/measures/sri24/warp_refine/${map[${map_idx}]}_baseline_diff_avg.csv
      if LWDP_needs_update_and_lock ${out} ${mod_at_baseline} ${mod}; then
        tmpdir=$(mktemp -d)
        afni 3dcalc -a ${mod} -b ${mod_at_baseline} -c ${sri24_brainmask} -expr 'abs(a-b)*c' -prefix ${tmpdir}/${map[${map_idx}]}_diff.nii.gz
        diff_avg=`afni 3dmaskave -mask ${sri24_brainmask} -q ${tmpdir}/${map[${map_idx}]}_diff.nii.gz`
        echo ${map[${map_idx}]}_baseline_diff_avg > ${out}
        echo ${diff_avg} >> ${out}
        rm -rf ${tmpdir}
        LWDP_lockfile_delete ${out}
      fi
    done

    fa_baseline_diff_avg_file=${DIFFUSION_DIR}/${branch}/measures/sri24/warp_refine/fa_baseline_diff_avg.csv
    fa_baseline_diff_avg=`cat ${fa_baseline_diff_avg_file} | tail -n1`
    # Q3 + IQS*3 = 0.05935
    if [ $(echo "${fa_baseline_diff_avg} > 0.065" | bc) -eq 1 ]; then
	PASS=${DIFFUSION_DIR}/${branch}/measures/sri24/warp_refine/fa_baseline_diff_avg.pass
	if [ -e ${DIFFUSION_DIR}/${branch}/measures/sri24/warp_refine/fa_baseline_diff_avg.pass -a $fa_baseline_diff_avg_file -ot $PASS ]; then 
 	    echo "INFO:$WORKDIR:fa_baseline_diff_avg = ${fa_baseline_diff_avg} > 0.065 is ignored !" 
	else
	    echo "ERROR: ${WORKDIR}: fa_baseline_diff_avg = ${fa_baseline_diff_avg} > 0.065: compare ${WORKDIR}/../${VISIT_REF}/diffusion/${branch}/reslice/sri24/warp_refine/fa.nii.gz with ${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/fa.nii.gz fa to see if  ${VISIT} fa image looks corrupt!"
	    exit 1 
	fi
    fi
  done
fi

#
# CONNECTOME ANALYSIS
#

if [ "$VISIT" != "baseline" ]; then 
    if [ `echo $VISIT | cut -d_ -f2 | cut -dy -f1` -gt 6 ]; then 
      echo "DEBUG:${WORKDIR}:Skipping connectivity analysis!"
      exit 0
    fi 
fi 




branch=pepolar
#
# BEDPOST  
#


function run_bedpost {
   nf=3
   bpx_dir=${DIFFUSION_DIR}/${branch}/bedpostx_nf${nf}
   bpx_data=${bpx_dir}/data.nii.gz
   bpx_mask=${bpx_dir}/nodif_brain_mask.nii.gz
   bpx_bvecs=${bpx_dir}/bvecs
   bpx_bvals=${bpx_dir}/bvals
   if LWDP_needs_update_and_lock ${bpx_data} ${included_volumes_file} ${bval_file} ${dwi_unwarp_bvecs}; then
     included_volumes_list=`cat ${included_volumes_file}`
     bval_list=$(cat ${bval_file})
     bvec_x_list=`sed "1q;d" ${dwi_unwarp_bvecs} | tr -s " "`
     bvec_y_list=`sed "2q;d" ${dwi_unwarp_bvecs} | tr -s " "`
     bvec_z_list=`sed "3q;d" ${dwi_unwarp_bvecs} | tr -s " "`
     #
     idx=1
     bpx_data_list=
     bpx_bval_list=
     bpx_bvec_x_list=
     bpx_bvec_y_list=
     bpx_bvec_z_list=
     for bX in ${bXlist}; do
       volume_name=`basename ${bX} | cut -d "." -f1`
       is_included=N
       for f in ${included_volumes_list}; do
         if [ "${volume_name}" == "${f}" ]; then
           is_included=Y
           break
         fi
       done
       if [ "${is_included}" == "Y" ]; then
         bpx_data_list="${bpx_data_list} ${DIFFUSION_DIR}/${branch}/corrected/unwarp/${f}.nii.gz"
         bval=`echo ${bval_list} | cut -d " " -f${idx}`
         bvec_x=`echo ${bvec_x_list} | cut -d " " -f${idx}`
         bvec_y=`echo ${bvec_y_list} | cut -d " " -f${idx}`
         bvec_z=`echo ${bvec_z_list} | cut -d " " -f${idx}`
         # flip y and z directions
         bvec_y=`python3 -c "print (-1.0 * ${bvec_y})"`
         bvec_z=`python3 -c "print (-1.0 * ${bvec_z})"`
         #
         if [ "${bpx_bval_list}" == "" ]; then
           bpx_bval_list="${bval}"
           bpx_bvec_x_list="${bvec_x}"
           bpx_bvec_y_list="${bvec_y}"
           bpx_bvec_z_list="${bvec_z}"
         else
           bpx_bval_list="${bpx_bval_list} ${bval}"
           bpx_bvec_x_list="${bpx_bvec_x_list} ${bvec_x}"
           bpx_bvec_y_list="${bpx_bvec_y_list} ${bvec_y}"
           bpx_bvec_z_list="${bpx_bvec_z_list} ${bvec_z}"
         fi
       fi
       let idx++
     done
   
     fsl fslmerge -t ${bpx_data} ${bpx_data_list}
     echo ${bpx_bval_list} > ${bpx_bvals}
     echo ${bpx_bvec_x_list} > ${bpx_bvecs}
     echo ${bpx_bvec_y_list} >> ${bpx_bvecs}
     echo ${bpx_bvec_z_list} >> ${bpx_bvecs}
   
     LWDP_lockfile_delete ${bpx_data}
   fi

   if LWDP_needs_update_and_lock ${bpx_mask} ${b0_brainmask}; then
     c3d c3d ${b0_brainmask} -o ${bpx_mask}
     LWDP_lockfile_delete ${bpx_mask}
   fi

   # run dtifit to check tensor directions
   bpx_tensor_v1=${bpx_dir}/dtifit_V1.nii.gz
   if LWDP_needs_update_and_lock ${bpx_tensor_v1} ${bpx_data} ${bpx_bvecs} ${bpx_bvals} ${bpx_mask}; then
     fsl dtifit -k ${bpx_data} -r ${bpx_bvecs} -b ${bpx_bvals} -m ${bpx_mask} -o ${bpx_dir}/dtifit
     LWDP_lockfile_delete ${bpx_tensor_v1}
   fi

   # Has to be run all together as we delete afterwards temp results 
   bpx_mean_S0samples=${bpx_dir}/mean_S0samples.nii.gz
   if LWDP_needs_update_and_lock ${bpx_mean_S0samples} ${bpx_data} ${bpx_mask}; then
       bpx_tmp_dir=${bpx_dir}/tmp

       # bedpostx_preproc     
       [ -d ${bpx_tmp_dir}/preproc ] || mkdir -p ${bpx_tmp_dir}/preproc       
       bpx_data_slice_pre=${bpx_tmp_dir}/preproc/data
       bpx_data_slice=${bpx_data_slice_pre}_slice_0000.nii.gz
       if LWDP_needs_update_and_lock ${bpx_data_slice} ${bpx_data}; then
	   fsl fslslice ${bpx_data} ${bpx_data_slice_pre}
	   LWDP_lockfile_delete ${bpx_data_slice}
       fi

       bpx_mask_slice_pre=${bpx_tmp_dir}/preproc/nodif_brain_mask
       bpx_mask_slice=${bpx_mask_slice_pre}_slice_0000.nii.gz
       if LWDP_needs_update_and_lock ${bpx_mask_slice} ${bpx_mask}; then
	   fsl fslslice ${bpx_mask} ${bpx_mask_slice_pre}
	   LWDP_lockfile_delete ${bpx_mask_slice}
       fi
       
       # bedpostx_single_slice
       [ -d ${bpx_tmp_dir}/diff_slices ] || mkdir -p ${bpx_tmp_dir}/diff_slices
       nslices=`fsl fslval ${bpx_data} dim3`
       nslices_1=`expr ${nslices} - 1`
       idx=0
       for slice in `seq 0 ${nslices_1}`; do
	   slicezp=`fsl zeropad ${slice} 4`
	   data_slice=${bpx_data_slice_pre}_slice_${slicezp}.nii.gz
	   mask_slice=${bpx_mask_slice_pre}_slice_${slicezp}.nii.gz
	   data_slice_dyads1=${bpx_tmp_dir}/diff_slices/data_slice_${slicezp}/dyads1.nii.gz
	   log_out_tmp=${bpx_tmp_dir}/diff_slices/data_slice_${slicezp}.log
	   if LWDP_needs_update ${data_slice_dyads1} ${data_slice} ${mask_slice}; then
               #echo "processing slice ${slice}"
               fsl xfibres --data=${data_slice} --mask=${mask_slice} -b ${bpx_dir}/bvals -r ${bpx_dir}/bvecs --forcedir --logdir=${bpx_tmp_dir}/diff_slices/data_slice_${slicezp} --nf=${nf} --fudge=1 --bi=1000 --nj=1250 --se=25 --model=1 --cnonlinear  &> ${log_out_tmp} &
	   else
               #echo "skipping slice ${slice}"
               continue
	   fi
	   let idx++
	   if [ `expr ${idx} % ${CMTK_NUM_THREADS}` == 0 ]; then
               wait
	   fi
       done
       wait

       # checking output
       for slice in `seq 0 ${nslices_1}`; do
	   slicezp=`fsl zeropad ${slice} 4`
	   data_slice_dyads1=${bpx_tmp_dir}/diff_slices/data_slice_${slicezp}/dyads1.nii.gz
	   if [ ! -e ${data_slice_dyads1} ]; then
               echo "ERROR:$ missing results for slice ${slice}"
               LWDP_lockfile_delete ${data_slice_diff_multi_flag}
               exit 1
	   fi
       done
  
       # bedpostx_postproc

       numfib=`fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_0000/f*samples* | wc -w | awk '{print $1}'`
       if [ `fsl imtest ${bpx_tmp_dir}/diff_slices/data_slice_0000/f0samples` -eq 1 ]; then
	   numfib=$((${numfib} - 1))
       fi

       fib=1
       while [ ${fib} -le ${numfib} ]; do
	   fsl fslmerge -z ${bpx_dir}/merged_th${fib}samples `fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_*/th${fib}samples*`
	   fsl fslmerge -z ${bpx_dir}/merged_ph${fib}samples `fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_*/ph${fib}samples*`
	   fsl fslmerge -z ${bpx_dir}/merged_f${fib}samples  `fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_*/f${fib}samples*`
	   fsl fslmaths ${bpx_dir}/merged_th${fib}samples -Tmean ${bpx_dir}/mean_th${fib}samples
	   fsl fslmaths ${bpx_dir}/merged_ph${fib}samples -Tmean ${bpx_dir}/mean_ph${fib}samples
	   fsl fslmaths ${bpx_dir}/merged_f${fib}samples -Tmean ${bpx_dir}/mean_f${fib}samples
     
	   fsl make_dyadic_vectors ${bpx_dir}/merged_th${fib}samples ${bpx_dir}/merged_ph${fib}samples ${bpx_dir}/nodif_brain_mask ${bpx_dir}/dyads${fib}
	   if [ ${fib} -ge 2 ];then
               fsl maskdyads ${bpx_dir}/dyads${fib} ${bpx_dir}/mean_f${fib}samples
	   fi
	   fib=$((${fib} + 1))
       done
       if [ `fsl imtest ${bpx_dir}/mean_f1samples` -eq 1 ];then
	   fsl fslmaths ${bpx_dir}/mean_f1samples -mul 0 ${bpx_dir}/mean_fsumsamples
	   fib=1
	   while [ $fib -le $numfib ]; do
               fsl fslmaths ${bpx_dir}/mean_fsumsamples -add ${bpx_dir}/mean_f${fib}samples ${bpx_dir}/mean_fsumsamples
               fib=$((${fib} + 1))
	   done
       fi
       if [ `fsl imtest ${bpx_tmp_dir}/diff_slices/data_slice_0000/mean_dsamples` -eq 1 ];then
	   fsl fslmerge -z ${bpx_dir}/mean_dsamples `fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_*/mean_dsamples*`
       else 
	   echo "ERROR:$WORKDIR:fsl imtest ${bpx_tmp_dir}/diff_slices/data_slice_0000/mean_dsamples failed!"
	   LWDP_lockfile_delete ${bpx_mean_S0samples}
	   exit 1
       fi 

       if [ `fsl imtest ${bpx_tmp_dir}/diff_slices/data_slice_0000/mean_S0samples` -eq 1 ];then
	   fsl fslmerge -z ${bpx_dir}/mean_S0samples `fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_*/mean_S0samples*`
       else 
	   echo "ERROR:$WORKDIR:fsl imtest ${bpx_tmp_dir}/diff_slices/data_slice_0000/mean_S0samples failed!"
	   LWDP_lockfile_delete ${bpx_mean_S0samples}
	   exit 1
       fi 

       # these are not produced by the ncanda pipeline but left them in for completness 
       if [ `fsl imtest ${bpx_tmp_dir}/diff_slices/data_slice_0000/mean_d_stdsamples` -eq 1 ];then
	   fsl fslmerge -z ${bpx_dir}/mean_d_stdsamples `fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_*/mean_d_stdsamples*`
       fi
       if [ `fsl imtest ${bpx_tmp_dir}/diff_slices/data_slice_0000/mean_f0samples` -eq 1 ];then
	   fsl fslmerge -z ${bpx_dir}/mean_f0samples `fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_*/mean_f0samples*`
       fi
       if [ `fsl imtest ${bpx_tmp_dir}/diff_slices/data_slice_0000/mean_tausamples` -eq 1 ];then
	   fsl fslmerge -z ${bpx_dir}/mean_tausamples `fsl imglob ${bpx_tmp_dir}/diff_slices/data_slice_*/mean_tausamples*`
       fi
   
       # Check that it was successfull  
       if [ `fsl imtest ${bpx_dir}/merged_th1samples` -eq 1 ];then
	   if [ `fsl imtest ${bpx_dir}/merged_ph1samples` -eq 1 ];then
               if [ `fsl imtest ${bpx_dir}/merged_f1samples` -eq 1 ];then
		   # Everything ran successfull so those are not needed anymore 
		   rm -rf ${bpx_tmp_dir}
               fi
	   fi
       fi
       
       LWDP_lockfile_delete ${bpx_mean_S0samples}
   fi

   # not sure why this is needed    
   xfms_eye=${bpx_dir}/xfms/eye.mat
   if LWDP_needs_update_and_lock ${xfms_eye} ${bpx_data}; then
     echo 1 0 0 0 > ${xfms_eye}
     echo 0 1 0 0 >> ${xfms_eye}
     echo 0 0 1 0 >> ${xfms_eye}
     echo 0 0 0 1 >> ${xfms_eye}
     LWDP_lockfile_delete ${xfms_eye}
   fi
}

run_bedpost

#
# Separate the cortical White Matter from Gray Matter
#

function cortical_whitematter_graymatter_separation {

  atropos_t1_ven_parc=${WORKDIR}/structural/segment/subject_t1/atropos/t1_ven_parc.nii.gz
  atropos_b0_ven_parc=${DIFFUSION_DIR}/${branch}/reslice/b0_unwarp/ven_parc.nii.gz
  if LWDP_needs_update_and_lock $atropos_b0_ven_parc ${atropos_t1_ven_parc} ${b0Unwarp} ${b0_t1_mtx}; then     
      ants antsApplyTransforms -n MultiLabel -i ${atropos_t1_ven_parc} -r ${b0Unwarp} -o ${atropos_b0_ven_parc} -t ${b0_t1_mtx}
      LWDP_lockfile_delete ${atropos_b0_ven_parc}
  fi

  ROI_DIR=${CONNECTOME_DIR}/roi
  [ -d $ROI_DIR ] || mkdir -p $ROI_DIR

  # Create smooth white matter mask with subcortical and ventricals filled in 
  atropos_t1_seg_clean=${WORKDIR}/structural/segment/subject_t1/atropos/t1_seg_clean.nii.gz
  atropos_t1_gm_parc=${WORKDIR}/structural/segment/subject_t1/atropos/t1_gm_parc.nii.gz
  b0_wm_filled_smooth_mask=${ROI_DIR}/wm_filled_smooth_mask.nii.gz
  if LWDP_needs_update_and_lock ${b0_wm_filled_smooth_mask} ${b0_t1_mtx} ${b0Unwarp} $atropos_b0_ven_parc ${atropos_t1_seg_clean} ${atropos_t1_gm_parc}; then

    ########
    # -----------------------------------------------------------------
    ## cortical regions: extract from the atlas mask (sri24_parc116 parcellation), map to b0 image, and dilate
    tmpdir=$(mktemp -d)

    # vox_resolution2=$(echo "`fsl fslinfo ${b0Unwarp} | grep pixdim1 | tr -s [:blank:] | cut -d ' ' -f 2`*2" | bc)
    vox_resolution2=$(echo "`fsl fslval ${b0Unwarp} pixdim1 | tr -d ' '`*2" | bc)
    
    # ------------------
    # white matter (WM): extract from the atlas mask, map to b0 image, and dilate
    b0_atropos_seg=${tmpdir}/seg.nii.gz
    ants antsApplyTransforms -n MultiLabel -i ${atropos_t1_seg_clean} -r ${b0Unwarp} -o ${b0_atropos_seg} -t ${b0_t1_mtx} &> ${tmpdir}/seg.log
    b0_wm_mask=${tmpdir}/wm_mask.nii.gz
    # -thr  : use following number to threshold current image (zero anything below the number)
    fsl fslmaths ${b0_atropos_seg} -thr 3 -bin ${b0_wm_mask}

    b0_atropos_ven=${tmpdir}/ven.nii.gz
    fsl fslmaths $atropos_b0_ven_parc -bin -kernel sphere ${vox_resolution2} -dilD $b0_atropos_ven

    # ------------------
    # subcortex: extract from the atlas mask, map to b0 image, and dilate
    b0_atropos_sub=${tmpdir}/sub.nii.gz
    ants antsApplyTransforms -n MultiLabel -i ${atropos_t1_gm_parc} -r ${b0Unwarp} -o ${tmpdir}/gm_parc.nii.gz -t ${b0_t1_mtx} &> ${tmpdir}/gm_parc.log
    # replace all subcortical roi intensities with value 1000
    c3d c3d ${tmpdir}/gm_parc.nii.gz -replace 37 1000 38 1000 71 1000 72 1000 73 1000 74 1000 75 1000 76 1000 77 1000 78 1000 133 1000 134 1000 ${b0_atropos_sub}
    fsl fslmaths ${b0_atropos_sub} -thr 999 -bin  -kernel sphere ${vox_resolution2} -dilD ${b0_atropos_sub}

    # ------------------
    # join together the above-extracted areas from WM, ventricles, and subcortex
    b0_wm_filled_mask=${tmpdir}/wm_filled_mask.nii.gz
    fsl fslmaths ${b0_atropos_sub} -add ${b0_atropos_ven} -add ${b0_wm_mask} -bin -kernel sphere 2.75 -ero -dilM ${tmpdir}/wm_filled_mask_temp.nii.gz
    if [ "$SLICER_CLI" == "" ]; then
      echo "ERROR: Load slicer"
      exit 1
    fi
    ${SLICER_CLI}/IslandRemoval -m 20 ${tmpdir}/wm_filled_mask_temp.nii.gz ${b0_wm_filled_smooth_mask}
    fsl fslcpgeom ${tmpdir}/wm_filled_mask_temp.nii.gz ${b0_wm_filled_smooth_mask}

    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${b0_wm_filled_smooth_mask}
  fi

  # Extract boundary and parcellate it  
  wm_gm_boundary=${ROI_DIR}/wm_gm_boundary_parc.nii.gz
  if LWDP_needs_update_and_lock ${wm_gm_boundary} ${b0_parc} ${b0Unwarp} ${b0_wm_filled_smooth_mask}; then 
    tmpdir=$(mktemp -d)  
    # vox_resolution=$(fsl fslinfo ${b0Unwarp} | grep pixdim1 | tr -s [:blank:] | cut -d ' ' -f 2)
    vox_resolution=$(fsl fslval ${b0Unwarp} pixdim1 | tr -d ' ')
    vox_resolution2=$(echo "$vox_resolution*2" | bc)    
    
    # -replace I1 J1 I2 J2 ... Replace intensity I1 by J1, I2 by J2 and so on
    c3d c3d ${b0_parc} -replace 37 0 38 0 71 0 72 0 73 0 74 0 75 0 76 0 77 0 78 0 ${tmpdir}/parc_dil_tmp.nii.gz

    # filter out above percentile -uthr : use following number to upper-threshold current image (zero anything above the number)
    # -kernel sphere <size>   : all voxels in a sphere of radius <size> mm centered on target voxel
    # -dilD    : Modal Dilation of non-zero voxels
    fsl fslmaths ${tmpdir}/parc_dil_tmp.nii.gz -uthr 90.5 -kernel sphere ${vox_resolution2} -dilD ${tmpdir}/parc_dil.nii.gz

    ########
    # -----------------------------------------------------------------
    ## extract parcellated wm/gm boundary ##
    fsl fslmaths  ${b0_wm_filled_smooth_mask} -edge -bin -kernel sphere ${vox_resolution} -dilM -mul  ${b0_wm_filled_smooth_mask} -mul ${tmpdir}/parc_dil.nii.gz ${wm_gm_boundary}

    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${wm_gm_boundary}
  fi

  if [ ! -e $wm_gm_boundary ]; then 
      echo "ERROR:$WORKDIR: $wm_gm_boundary is missing !"
      exit 1
  fi 

  # Create ROI Label Maps 
  for ROI in $ROI_LIST; do 
      ROI_MAP=${ROI_DIR}/roi_`printf %02d $ROI`.nii.gz
      if LWDP_needs_update_and_lock ${ROI_MAP} $wm_gm_boundary; then 
	  c3d c3d $wm_gm_boundary -thresh $ROI $ROI 1 0 -type short ${ROI_MAP} 
	  LWDP_lockfile_delete ${ROI_MAP}
      fi
  done 
}

CONNECTOME_DIR=${DIFFUSION_DIR}/pepolar/connectome
ROI_LIST="$(seq 1 36) $(seq 39 70) $(seq 79 90)"

cortical_whitematter_graymatter_separation

#
# Perform connectivity analysis 
#

# function converts hex or decimal numbers to decimal numbers 
function convert_hex_to_dec {
    infile=$1
    if [ "$infile" == "" ]; then
	echo "ERROR:$WORKDIR:check input of convert_hex_to_dec"
	return 1 
    fi 
    if [ ! -e $infile ]; then 
	echo "ERROR:$WORKDIR:convert_hex_to_dec:$infile does not exist!"
	return 1 
    fi
   
    # check if it is hex or dec 
    firstNum=`head -n1 $infile | cut -d' ' -f1`
    if [ "$firstNum" == `printf "%.0f" "$firstNum"` ]; then 
	# is already dec so just return 
	return 0 
    fi

    echo "INFO:$WORKDIR:Turning $infile from hexadecimal to decimal!"    
    mv $infile ${infile}.orig

    # Transfer number
    while read line; do
      for number in $line; do
	# add free space bc that is how fsl writes it out 
        printf "%.0f  " "$number" >> $infile
      done
      echo >> $infile
    done < ${infile}.orig

    return 0
} 

function probtrackx_seed_to_target {
  SEED=$1
  # Target has to be defined otherwise probtrackx2 does not work
  TARGET_MAP_LIST="$2"
  TYPE=$3
  WAYPOINTS=$4

  seed_map=${ROI_DIR}/${SEED}.nii.gz
  prob_map_dir=${PROBTRACK_DIR}/${SEED}
  waytotal=${prob_map_dir}/waytotal

  seed_to_target_statistics=${prob_map_dir}/matrix_seeds_to_all_targets
  if LWDP_needs_update_and_lock ${seed_to_target_statistics} ${tensor_map}_f1samples.nii.gz ${b0_wm_filled_smooth_mask} ${seed_map} $TARGET_MAP_LIST ${atropos_b0_ven_parc} $WAYPOINTS; then

    num_samples=`fsl fslstats ${seed_map} -l 0 -u 2  -v | cut -d' ' -f1 | gawk '{ print int(10000 / $1) }'`

    target_file=${prob_map_dir}/targets.txt
    echo "$TARGET_MAP_LIST" | tr ' ' '\n' > ${target_file}
    
    CMD="fsl probtrackx2 -s ${tensor_map} -m ${b0_wm_filled_smooth_mask} --avoid=${atropos_b0_ven_parc} -x ${seed_map} --dir=${prob_map_dir} --forcedir --opd -o fdt_paths --targetmasks=${target_file} --os2t --s2tastext -l --nsamples=${num_samples}"

    if [ $TYPE == "stop" ]; then
      CMD="$CMD --stop=${target_file}"
    fi

    if  [ "$WAYPOINTS" != "" ]; then
      waypoints_file=${prob_map_dir}/waypoints.txt
      echo "$WAYPOINTS" | tr ' ' '\n' > ${waypoints_file}
      CMD="$CMD --waypoints=${waypoints_file} --waycond=AND"
    fi
    echo "$CMD" > ${prob_map_dir}/probtrackx.cmd
    $CMD &> ${prob_map_dir}/probtrackx.log
    grep -i -e ERROR -e Missing ${prob_map_dir}/probtrackx.log
    rm -f ${prob_map_dir}/seeds_to_roi_*.nii.gz

    # do to bug in fsl sometimes writes out hex numbers
    if ! convert_hex_to_dec $waytotal; then 
	echo "ERROR:$WORKDIR:convert_hex_to_dec $waytotal failed !"
	# so it is repeating analysis 
	rm -f ${seed_to_target_statistics}
	LWDP_lockfile_delete ${seed_to_target_statistics}
	exit 1 
    fi

    if ! convert_hex_to_dec ${seed_to_target_statistics}; then 
	echo "ERROR:$WORKDIR:convert_hex_to_dec ${seed_to_target_statistics} failed !"
	# so it is repeating analysis 
	rm -f ${seed_to_target_statistics}
	LWDP_lockfile_delete ${seed_to_target_statistics}
	exit 1 
    fi

    LWDP_lockfile_delete ${seed_to_target_statistics}
  fi

  seed_to_target_perc=${prob_map_dir}/all_targets_success_perc
  if LWDP_needs_update_and_lock ${seed_to_target_perc}.csv ${seed_to_target_statistics} ${prob_map_dir}/targets.txt $waytotal; then
    prob_map_dir_rel=${prob_map_dir#"${WORKDIR}/"}
    CMD="${NCANDA_SOURCE_DIR}/utils/probtrackx_comp_perc.py $WORKDIR ${prob_map_dir_rel}"
    $CMD &> ${seed_to_target_perc}.log
    grep -i ERROR ${seed_to_target_perc}.log
    LWDP_lockfile_delete ${seed_to_target_perc}.csv
  fi
}

#
# TEST PHASE
#

PROBTRACK_DIR=${CONNECTOME_DIR}/probtrackx
[ -d $PROBTRACK_DIR ] || mkdir ${PROBTRACK_DIR}

tensor_map=${bpx_dir}/merged

for ROI in $ROI_LIST; do 
      SEED=roi_`printf %02d $ROI`
      TARGETS=""
      for TAR in $ROI_LIST; do 
	  if [ $TAR -eq $ROI ]; then 
	      continue 
	  fi 
	  TARGETS="${TARGETS}${ROI_DIR}/roi_`printf %02d $TAR`.nii.gz "
      done
      probtrackx_seed_to_target $SEED "${TARGETS}" stop 
      if [ ! -e ${seed_to_target_perc}.csv ]; then 
	  echo "ERROR:$WORKDIR:failed to generate ${seed_to_target_perc}.csv!"
	  exit 1 
      fi 

done
