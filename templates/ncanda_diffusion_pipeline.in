for map_idx in 0 1 2 3; do
  input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/${map[${map_idx}]}.nii.gz)
  output=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/${map[${map_idx}]}.nii.gz
  if LWDP_needs_update_and_lock ${output} ${input} ${sri24_padded_t1_brain} ${b0_t1_mtx}; then
    ants antsApplyTransforms -d 3 -n Linear -i ${input} -r ${sri24_padded_t1_brain} -o ${output} -t ${sri24_padded_to_t1_rigid} ${t1_b0_mtx}
    c3d c3d ${output} -type float -o ${output}
    LWDP_lockfile_delete ${output}
  fi
done

input[1]=${DIFFUSION_DIR}/${branch}/corrected/final/dti60-01.nii.gz
input[2]=${DIFFUSION_DIR}/${branch}/corrected/final/bAverage.nii.gz
output[1]=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/b0.nii.gz
output[2]=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/bAverage.nii.gz
for i in 1 2; do
  if LWDP_needs_update_and_lock ${output[${i}]} ${input[${i}]} ${sri24_padded_t1_brain} ${sri24_padded_to_t1_rigid} ${b0_t1_mtx}; then
    ants antsApplyTransforms -n BlackmanWindowedSinc -i ${input[${i}]} -r ${sri24_padded_t1_brain} -o ${output[${i}]} -t ${sri24_padded_to_t1_rigid} ${t1_b0_mtx}
    c3d c3d ${output[${i}]} -clip 0 inf -type float -o ${output[${i}]}
    LWDP_lockfile_delete ${output[${i}]}
  fi
done

#
# Reslice fiber tracking ROIs to subject DWI space
#

fa_subject_upsampled=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/fa_1_25mm.nii.gz)

if [ "${branch}" == "pepolar" ]; then
  for seedfile in ${DATA_DIR}/sri24/fiber_masks/*/seeds.nii*; do
    roiname=$(echo $seedfile | sed 's/.*fiber_masks\///g; s/\/seeds.*//g')
    output=${DIFFUSION_DIR}/${branch}/reslice/dwi/warp_refine/${roiname}/seeds.nii.gz
    #if LWDP_needs_update_and_lock ${output} ${b0fa_sri24_warp} ${seedfile} ${fa_subject_upsampled}; then
    if LWDP_needs_update_and_lock ${output} ${b0fa_sri24_warp} ${seedfile} ${fa_subject}; then
      # choose MultiLabel params which preserves boundaries close to NN, but applying some mild smoothness
      #ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${seedfile} -r ${fa_subject_upsampled} -o ${output} -t ${b0fa_sri24_warp}
      ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${seedfile} -r ${fa_subject} -o ${output} -t ${b0fa_sri24_warp}
      c3d c3d ${output} -type uchar -o ${output}
      LWDP_lockfile_delete ${output}
    fi

    exclude_template=${DATA_DIR}/sri24/fiber_masks/${roiname}/exclude.nii.gz
    if [ ! -s ${exclude_template} ]; then
      exclude_template=""
    fi

    for waypoints in ${DATA_DIR}/sri24/fiber_masks/${roiname}/waypoints*.nii* ${exclude_template}; do
      output=${DIFFUSION_DIR}/${branch}/reslice/dwi/warp_refine/${roiname}/$(basename $waypoints)
      if LWDP_needs_update_and_lock ${output} ${b0fa_sri24_warp} ${waypoints} ${fa_subject}; then
        # choose MultiLabel params which preserves boundaries close to NN, but applying some mild smoothness
        ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${waypoints} -r ${fa_subject} -o ${output} -t  ${b0fa_sri24_warp}
        c3d c3d ${output} -type uchar -o ${output}
        LWDP_lockfile_delete ${output}
      fi
    done
  done
fi

