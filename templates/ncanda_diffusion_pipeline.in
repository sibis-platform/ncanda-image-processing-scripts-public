#
# Initialization
#

NCANDA_BINARY_DIR=@NCANDA_BINARY_DIR_CONFIG@
NCANDA_SOURCE_DIR=@NCANDA_SOURCE_DIR_CONFIG@
DATA_DIR=@DATA_DIR_CONFIG@
export SVN_VERSION=`echo "$Revision$" | cut -d ' ' -f 2`

source ${NCANDA_BINARY_DIR}/ncanda_setup.sh $*

export DIFFUSION_DIR=${WORKDIR}/diffusion

export DWI6_DIR=${DIFFUSION_DIR}/native/dti6b500pepolar
export DWI60_DIR=${DIFFUSION_DIR}/native/dti60b1000

if [ ! -d ${DWI6_DIR} -o ! -d ${DWI60_DIR} ]; then
  # echo "ERROR: ${WORKDIR}: No DTI data: ${WORKDIR}"
  exit 1
fi

t1_mrbias=$(LWDP_get_override_file ${WORKDIR}/structural/mrbias/t1.nii.gz)
t2_mrbias=$(LWDP_get_override_file ${WORKDIR}/structural/mrbias/t2.nii.gz)

if [ ! -e ${t1_mrbias} -o ! -e ${t2_mrbias} ]; then
  echo "ERROR: ${WORKDIR}: No structural images: ${WORKDIR}"
  exit 1
fi

VISIT_REF=baseline
if [ "${VISIT}" != "baseline" ]; then
  followup_year=`echo ${VISIT} | cut -d "_" -f2 | cut -d "y" -f1`
  if [ ! -d ${WORKDIR}/../baseline/diffusion/native/dti6b500pepolar -o ! -d ${WORKDIR}/../baseline/diffusion/native/dti60b1000 ]; then
    for year in `seq 1 ${followup_year}`; do
      if [ -d ${WORKDIR}/../followup_${year}y/diffusion/native/dti6b500pepolar -o ! -d ${WORKDIR}/../followup_${year}y/diffusion/native/dti60b1000 ]; then
        VISIT_REF=followup_${year}y
        break
      fi
    done
  fi
  if [ "${VISIT_REF}" != "baseline" ]; then
    echo "WARNING: ${WORKDIR}: the reference visit is ${VISIT_REF}"
  fi
fi

#
# Main program
#

#
# Catch cases where DTI60 was acquired at twice the DTI6 in-plane resolution and correct that
#

# make sure geomatch exists otherwise logic is broken below and causes all kinds of problems
# Earlier versions of CMTK do not contain geomatch
if [ ! -e `which geomatch` ]; then
  ERRTXT="ERROR: ${WORKDIR}: Newer version of CMTK required: geomatch is missing"
  echo "$ERRTXT"
  #echo "$ERRTXT" | ncanda_error_email $(basename $0)
  exit 1
fi

if ! cmtk geomatch --no-check-xforms $(LWDP_get_override_file ${DWI6_DIR}/dti6-1.nii.gz) $(LWDP_get_override_file ${DWI60_DIR}/dti60-01.nii.gz); then
  echo "ERROR: ${WORKDIR}: cmtk geomatch failed"
  exit 1
  #for f in $(cd ${DWI60_DIR}; ls *.nii.gz); do
  #  # First resample the original image to the (hopefully correct) resolution
  #  original=$(LWDP_get_override_file ${DWI60_DIR}/$f)
  #  resample=${DIFFUSION_DIR}/resampled/dti60b1000/$f
  #  if LWDP_needs_update_and_lock ${resample} ${original}; then
  #    # Select-downsampling would change the pixel locations, so to average-downsampling, which does not (and gives better SNR)
  #    cmtk convertx --downsample-average 2,2,1 ${original} ${resample}
  #    LWDP_lockfile_delete ${resample}
  #  fi

  #  # Second, bring along the XML sidecar files
  #  basename_xml=$(echo $f | sed 's/\.nii.*/.nii.xml/g')
  #  original_xml=$(LWDP_get_override_file ${DWI60_DIR}/${basename_xml})
  #  resample_xml=${DIFFUSION_DIR}/resampled/dti60b1000/${basename_xml}
  #  if LWDP_needs_update_and_lock ${resample_xml} ${original_xml}; then
  #    cp ${original_xml} ${resample_xml}
  #    LWDP_lockfile_delete ${resample_xml}
  #  fi
  #done
fi

#
# Check whether the DTI6 and DTI60 truly have reversed Phase Encode w.r.t. each other
#

pe_sign_dti6=$(fgrep phaseEncodeDirectionSign ${DWI6_DIR}/dti6-1.nii.xml | sed 's/^.*<phaseEncodeDirectionSign>\(.*\)<\/phaseEncodeDirectionSign>.*$/\1/')
pe_sign_dti60=$(fgrep phaseEncodeDirectionSign ${DWI60_DIR}/dti60-01.nii.xml | sed 's/^.*<phaseEncodeDirectionSign>\(.*\)<\/phaseEncodeDirectionSign>.*$/\1/')

if [ "${pe_sign_dti6}" != "" -a "${pe_sign_dti60}" != "" ]; then
  if [ "${pe_sign_dti6}" == "${pe_sign_dti60}" ]; then
    echo "ERROR: ${WORKDIR}: both DWI series have the same phase encode direction, \"${pe_sign_dti6}\", in ${DIFFUSION_DIR}"
    #echo "ERROR: both DWI series have the same phase encode direction, \"${pe_sign_dti6}\", in ${DIFFUSION_DIR}" | ncanda_error_email $(basename $0)
    exit 1
  fi
fi

#
# 0 - mask bad slices with negative value (-1) to exclude from registration and tensor fitting
#

# Do this for both the 6-direction PEpolar and the 60-direction series
for series in dti6b500pepolar dti60b1000; do
  if [ -d ${DIFFUSION_DIR}/native/${series} ]; then
    outdir=${DIFFUSION_DIR}/badmasked/${series}
    outStats=${outdir}/bad_slices.csv
    # Check if there is a "resampled/" directory for this series and use the contents of that, if there is.
    inpdir=${DIFFUSION_DIR}/resampled/${series}
    [ -d ${inpdir} ] || inpdir=${DIFFUSION_DIR}/native/${series}

    inputs=$(ls ${inpdir}/*.nii* | fgrep -v xml)
    inputs=$(LWDP_get_override_files_list ${inputs})

    # How many b=0 images? These MUST be first in the series!
    b0count=$(fgrep '<bValue>0</bValue>' ${inpdir}/*.nii.xml | wc -l)

    # Create bad slice-masked images

    if LWDP_needs_update_and_lock ${outdir} ${inputs}; then
      if cmtk dwi_mask_bad_slices --short --padding-value -1 --b0count ${b0count} --bad-slice-statistics ${outStats} -o ${outdir} ${inputs}; then
        # succeeded - so make sure outdir has the correct time stamp
        touch -c ${outdir}
      else
        # you need to exit as otherwise the pipeline will just use the old files !
        LWDP_lockfile_delete ${outdir}
        exit 1
      fi
      LWDP_lockfile_delete ${outdir}
    fi

    # This can later be erassed - we just put it in there right now so that case that had not bad_slices.csv created do so now
    if LWDP_needs_update_and_lock ${outStats} ${inputs}; then
      cmtk dwi_mask_bad_slices --short --padding-value -1 --b0count ${b0count} --bad-slice-statistics ${outStats} ${inputs}
      LWDP_lockfile_delete ${outStats}
    fi

    # Check badmasked images are actually generated
    outCount=$(ls ${outdir}/*.nii* | wc -l)
    if [ ${outCount} -le 0 ]; then
      echo "ERROR: ${WORKDIR}: there's no image generated in ${outdir}."
      # remove outdir if unsuccessful as we check outdir when running again
      rm -rf ${outdir}
      exit 1
    fi

    # Also copy along the XML files so the motion correction script can adjust the gradient orientations
    for f in $(cd ${outdir}; ls *.nii* | sed 's/\.nii.*/.nii.xml/g'); do
      in_xml=${inpdir}/${f}
      out_xml=${outdir}/${f}
      if LWDP_needs_update_and_lock ${out_xml} ${in_xml}; then
        cp ${in_xml} ${out_xml}
        LWDP_lockfile_delete ${out_xml}
      fi
    done
  fi
done

#
# Prepare structural transformations
#

t1_sri24_affine=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_0GenericAffine.mat)
t1_sri24_warp=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_1Warp.nii.gz)
t1_sri24_warp_inv=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_1InverseWarp.nii.gz)
if [ ! -e  ${t1_sri24_affine} ] ; then
  echo "ERROR: ${WORKDIR}: ${t1_sri24_affine} is missing."
  exit 1
fi
if [ ! -e  ${t1_sri24_warp} ] ; then
  echo "ERROR: ${WORKDIR}: ${t1_sri24_warp} is missing."
  exit 1
fi
if [ ! -e  ${t1_sri24_warp_inv} ] ; then
  echo "ERROR: ${WORKDIR}: ${t1_sri24_warp_inv} is missing."
  exit 1
fi
if [ "${VISIT}" == "baseline" ]; then
  t1_sri24_mtx="${t1_sri24_warp} ${t1_sri24_affine}"
  t1_sri24_mtx_affine="${t1_sri24_affine}"
  sri24_t1_mtx="[${t1_sri24_affine},1] ${t1_sri24_warp_inv}"
  sri24_t1_mtx_affine="[${t1_sri24_affine},1]"
  #
  sri24_padded_t1_brain=${WORKDIR}/structural/reslice/sri24_padded/t1_brain.nii.gz
  sri24_padded_to_t1_rigid=${WORKDIR}/structural/registration/sri24_padded_to_t1/ants_rigid_0GenericAffine.mat
else
  t1_brain_to_baseline_affine=$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline/ants_0GenericAffine.mat)
  t1_brain_to_baseline_warp=$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline/ants_1Warp.nii.gz)
  t1_brain_to_baseline_warp_inv=$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline/ants_1InverseWarp.nii.gz)
  if [ ! -e  ${t1_brain_to_baseline_affine} ] ; then
    echo "ERROR: ${WORKDIR}: ${t1_brain_to_baseline_affine} is missing."
    exit 1
  fi
  if [ ! -e  ${t1_brain_to_baseline_warp} ] ; then
    echo "ERROR: ${WORKDIR}: ${t1_brain_to_baseline_warp} is missing."
    exit 1
  fi
  if [ ! -e  ${t1_brain_to_baseline_warp_inv} ] ; then
    echo "ERROR: ${WORKDIR}: ${t1_brain_to_baseline_warp_inv} is missing."
    exit 1
  fi
  t1_sri24_mtx="${t1_brain_to_baseline_warp} ${t1_brain_to_baseline_affine} ${t1_sri24_warp} ${t1_sri24_affine}"
  t1_sri24_mtx_affine="${t1_brain_to_baseline_warp} ${t1_brain_to_baseline_affine} ${t1_sri24_affine}"
  sri24_t1_mtx="[${t1_sri24_affine},1] ${t1_sri24_warp_inv} [${t1_brain_to_baseline_affine},1] ${t1_brain_to_baseline_warp_inv}"
  sri24_t1_mtx_affine="[${t1_sri24_affine},1] [${t1_brain_to_baseline_affine},1] ${t1_brain_to_baseline_warp_inv}"
  #
  sri24_padded_t1_brain=${WORKDIR}/structural/reslice/sri24_padded/corrected/t1_brain.nii.gz
  sri24_padded_to_t1_rigid=${WORKDIR}/structural/longitudinal/registration/baseline_sri24_padded_to_t1/ants_rigid_0GenericAffine.mat
fi

convert_ants_warp_to_cmtk_nrrd()
{
  local warp=$1
  local ref_image=$2
  local inp_image=$3
  local output_nrrd=$4

  local tmpdir=$(mktemp -d)

  # fix header information
  c3d c3d ${ref_image} -o ${tmpdir}/ref_image.nii.gz
  c3d c3d ${inp_image} -o ${tmpdir}/inp_image.nii.gz
  ref_image=${tmpdir}/ref_image.nii.gz
  inp_image=${tmpdir}/inp_image.nii.gz

  c3d c3d -mcs ${warp} -oo ${tmpdir}/warp_x.nii ${tmpdir}/warp_y.nii ${tmpdir}/warp_z.nii

  ref_orient=`c3d c3d ${ref_image} -info-full | grep -i orient | cut -d ":" -f2 | tr -d " "`
  ref_dim_x=`fsl fslval ${ref_image} dim1 | tr -d " "`
  ref_dim_y=`fsl fslval ${ref_image} dim2 | tr -d " "`
  ref_dim_z=`fsl fslval ${ref_image} dim3 | tr -d " "`
  ref_spacing_x=`fsl fslval ${ref_image} pixdim1 | tr -d " "`
  ref_spacing_y=`fsl fslval ${ref_image} pixdim2 | tr -d " "`
  ref_spacing_z=`fsl fslval ${ref_image} pixdim3 | tr -d " "`
  ref_origin_x=`c3d c3d ${ref_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f1`
  ref_origin_y=`c3d c3d ${ref_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f2`
  ref_origin_z=`c3d c3d ${ref_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f3`
  inp_orient=`c3d c3d ${inp_image} -info-full | grep -i orient | cut -d ":" -f2 | tr -d " "`
  inp_origin_x=`c3d c3d ${inp_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f1`
  inp_origin_y=`c3d c3d ${inp_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f2`
  inp_origin_z=`c3d c3d ${inp_image} -info-full | grep -i bounding | cut -d "[" -f2 | cut -d "]" -f1 | tr -s " " | cut -d " " -f3`
  if [[ "${ref_orient}" == *"L"*  && "${inp_orient}" == *"R"* ]]; then
    expr_x="${ref_dim_x}*${ref_spacing_x}-(a+(${ref_origin_x})-(${inp_origin_x}))"
  elif [[ "${ref_orient}" == *"R"*  && "${inp_orient}" == *"L"* ]]; then
    expr_x="${ref_dim_x}*${ref_spacing_x}+(a+(${ref_origin_x})-(${inp_origin_x}))"
  else
    # this function is not verified for L to L or R to R cases
    echo "WARNING: ${WORKDIR}: convert_warp_to_cmtk_nrrd is not verified for ${ref_orient} to ${inp_orient} cases."
    expr_x="a+(${ref_origin_x})-(${inp_origin_x})"
  fi
  if [[ "${ref_orient}" == *"P"*  && "${inp_orient}" == *"A"* ]]; then
    expr_y="${ref_dim_y}*${ref_spacing_y}-(a+(${ref_origin_y})-(${inp_origin_y}))"
  elif [[ "${ref_orient}" == *"A"*  && "${inp_orient}" == *"P"* ]]; then
    expr_y="${ref_dim_y}*${ref_spacing_y}+(a+(${ref_origin_y})-(${inp_origin_y}))"
  else
    # this function is not verified for P to A or A to P cases
    echo "WARNING: ${WORKDIR}: convert_warp_to_cmtk_nrrd is not verified for ${ref_orient} to ${inp_orient} cases."
    expr_y="a+(${ref_origin_y})-(${inp_origin_y})"
  fi
  if [[ "${ref_orient}" == *"S"*  && "${inp_orient}" == *"I"* ]]; then
    # this function is not verified for S to I cases
    echo "WARNING: ${WORKDIR}: convert_warp_to_cmtk_nrrd is not verified for ${ref_orient} to ${inp_orient} cases."
    expr_z="${ref_dim_z}*${ref_spacing_z}-(a+(${ref_origin_z})-(${inp_origin_z}))"
  elif [[ "${ref_orient}" == *"I"*  && "${inp_orient}" == *"S"* ]]; then
    # this function is not verified for I to S cases
    echo "WARNING: ${WORKDIR}: convert_warp_to_cmtk_nrrd is not verified for ${ref_orient} to ${inp_orient} cases."
    expr_z="${ref_dim_z}*${ref_spacing_z}+(a+(${ref_origin_z})-(${inp_origin_z}))"
  else
    expr_z="a+(${ref_origin_z})-(${inp_origin_z})"
  fi

  afni 3dcalc -a ${tmpdir}/warp_x.nii -expr "${expr_x}" -prefix ${tmpdir}/warp_x_fixed.nii
  afni 3dcalc -a ${tmpdir}/warp_y.nii -expr "${expr_y}" -prefix ${tmpdir}/warp_y_fixed.nii
  afni 3dcalc -a ${tmpdir}/warp_z.nii -expr "${expr_z}" -prefix ${tmpdir}/warp_z_fixed.nii

  c3d c3d ${tmpdir}/warp_x_fixed.nii -origin 0x0x0mm -o ${tmpdir}/warp_x_fixed_o.nii
  c3d c3d ${tmpdir}/warp_y_fixed.nii -origin 0x0x0mm -o ${tmpdir}/warp_y_fixed_o.nii
  c3d c3d ${tmpdir}/warp_z_fixed.nii -origin 0x0x0mm -o ${tmpdir}/warp_z_fixed_o.nii

  c3d c3d ${tmpdir}/warp_x_fixed_o.nii ${tmpdir}/warp_y_fixed_o.nii ${tmpdir}/warp_z_fixed_o.nii -omc ${output_nrrd}

  rm -rf ${tmpdir}
}

#
# 1 - Correct DWI motion and distortion
#
# for pepolar branch
# pepolar branch doen't use badmasked images for input
# Check if there is a "resampled/" directory for this series and use the contents of that, if there is.
branch=pepolar
if [ -d ${DIFFUSION_DIR}/resampled/dti60b1000 ]; then
      b0Fwd=$(LWDP_get_override_file ${DIFFUSION_DIR}/resampled/dti60b1000/dti60-01.nii.gz)
      bXlist=$(LWDP_get_override_files_list ${DIFFUSION_DIR}/resampled/dti60b1000/dti60-*.nii.gz)
else
      b0Fwd=$(LWDP_get_override_file ${DIFFUSION_DIR}/native/dti60b1000/dti60-01.nii.gz)
      bXlist=$(LWDP_get_override_files_list ${DIFFUSION_DIR}/native/dti60b1000/dti60-*.nii.gz)
fi
if [ -d ${DIFFUSION_DIR}/resampled/dti6b500pepolar ]; then
      b0Rev=$(LWDP_get_override_file ${DIFFUSION_DIR}/resampled/dti6b500pepolar/dti6-1.nii.gz)
else
      b0Rev=$(LWDP_get_override_file ${DIFFUSION_DIR}/native/dti6b500pepolar/dti6-1.nii.gz)
fi
#
topup_acqparams=${DIFFUSION_DIR}/${branch}/corrected/acqparams.txt
if LWDP_needs_update_and_lock ${topup_acqparams} ${b0Fwd} ${b0Rev}; then
      rotime=0.1
      rotime_pepolar=0.1
      echo "0 1 0 $rotime" > ${topup_acqparams}
      echo "0 -1 0 $rotime_pepolar" >> ${topup_acqparams}
      LWDP_lockfile_delete ${topup_acqparams}
fi
topup_fieldcoef=${DIFFUSION_DIR}/${branch}/corrected/topup_fieldcoef.nii.gz
if LWDP_needs_update_and_lock ${topup_fieldcoef} ${topup_acqparams} ${b0Fwd} ${b0Rev}; then
      tmpdir=$(mktemp -d)
      fsl fslmerge -t ${tmpdir}/topup_input.nii.gz ${b0Fwd} ${b0Rev}
      fsl topup --imain=${tmpdir}/topup_input.nii.gz --datain=${topup_acqparams} --config=b02b0.cnf --out=${DIFFUSION_DIR}/${branch}/corrected/topup --iout=${DIFFUSION_DIR}/${branch}/corrected/b0_fwd_rev
      rm -rf ${tmpdir}
      LWDP_lockfile_delete ${topup_fieldcoef}
fi
topup_aligned=${DIFFUSION_DIR}/${branch}/corrected/b0_fwd_rev.nii.gz

# originally b0_mean - recompute this way so that we do not get in problems with timestamp as it is now oleder than b0_mean_orig if computed before 02/29/2024
b0_mean_pre=${DIFFUSION_DIR}/${branch}/corrected/b0_mean
b0_mean_flip=${b0_mean_pre}_flip.nii.gz
b0_mean_flip_sim=${b0_mean_pre}_flip.csv
if LWDP_needs_update_and_lock ${b0_mean_flip_sim} ${topup_aligned} ${b0Fwd}; then
    fsl fslmaths ${topup_aligned} -Tmean ${b0_mean_flip}
    c3d c3d ${b0_mean_flip} -flip x -type float -o ${b0_mean_flip}
    c3d c3d ${b0Fwd} ${b0_mean_flip} -copy-transform -o ${b0_mean_flip}
    cmtk similarity ${b0_mean_flip} ${b0Fwd} | grep SIM | tr '\t' ' ' | tr -s ' ' | tr ' ' ',' > ${b0_mean_flip_sim}
    LWDP_lockfile_delete ${b0_mean_flip_sim}
fi

b0_mean_orig=${b0_mean_pre}_orig.nii.gz
b0_mean_orig_sim=${b0_mean_pre}_orig.csv
if LWDP_needs_update_and_lock ${b0_mean_orig_sim} ${topup_aligned} ${b0Fwd}; then
    fsl fslmaths ${topup_aligned} -Tmean ${b0_mean_orig}
    c3d c3d ${b0Fwd} ${b0_mean_orig} -copy-transform -o ${b0_mean_orig}
    cmtk similarity ${b0_mean_orig} ${b0Fwd} | grep SIM | tr '\t' ' ' | tr -s ' ' | tr ' ' ',' > ${b0_mean_orig_sim}
    # done so nothing would be recomputed later as we changed standard pipeline (take out after run on everybody) 
    touch -r ${b0_mean_flip} ${b0_mean_orig}
    touch -r ${b0_mean_flip_sim} ${b0_mean_orig_sim}
    LWDP_lockfile_delete ${b0_mean_orig_sim}
fi

b0_mean=${b0_mean_pre}.nii.gz
b0_mean_sim=${b0_mean_pre}.csv

# above 0.85 are differences due to correction 
NCC_THR=0.85
if LWDP_needs_update_and_lock ${b0_mean_sim} ${b0_mean_orig_sim} ${b0_mean_flip_sim}; then
    NCC_orig=`tail -n1 ${b0_mean_orig_sim} | cut -d, -f7`
    NCC_flip=`tail -n1 ${b0_mean_flip_sim} | cut -d, -f7`
    # FLIP is the default
    if [ $(echo "${NCC_orig} < ${NCC_flip}" | bc) -eq 1 ]; then
	cp ${b0_mean_flip} ${b0_mean} 
	cp ${b0_mean_flip_sim} ${b0_mean_sim}
	touch ${b0_mean_pre}.flip
    else 
        # If FLIP already meets threshold then check to see if it is okay to use non-flip
	# otherwise simply use non-flip ORIG does too 
	if [ $(echo "${NCC_flip} < ${NCC_THR}" | bc) -eq 0 ]; then
	    # If not check if we should use original orientation (without flip)
	    PASS=${DIFFUSION_DIR}/${branch}/corrected/b0_mean_orig.pass
	    if [ -e $PASS -a $b0_mean_orig_sim -ot $PASS -a $b0_mean_flip_sim -ot $PASS ]; then 
 		echo "INFO:$WORKDIR:Using ORIG(${NCC_orig}) as it is higher than FLIP($NCC_flip), which is above threshold (0.85)!"
	    else
		echo "ERROR:$WORKDIR:Non-flip(${NCC_orig}) is higher than the default FLIP($NCC_flip), which is above threshold (0.85)! Manually compare ${b0_mean_pre}_{flip,orig}.nii.gz ${b0Fwd} and touch ${DIFFUSION_DIR}/${branch}/corrected/b0_mean_orig.pass if original (not the FLIP version) should be used."
		# need to create logic if flipped should be used 
		LWDP_lockfile_delete ${b0_mean_sim}
		exit 1
	    fi
	fi
	cp ${b0_mean_orig} ${b0_mean} 
	cp ${b0_mean_orig_sim} ${b0_mean_sim} 
	echo "INFO:$WORKDIR:b0_mean is based on non-flip!"
	touch ${b0_mean_pre}.orig 
    fi
    LWDP_lockfile_delete ${b0_mean_sim}
fi 

NCC=`tail -n1 ${b0_mean_sim} | cut -d, -f7`
if [ $(echo "${NCC} < ${NCC_THR}" | bc) -eq 1 ]; then
	checkFile=${DIFFUSION_DIR}/${branch}/corrected/b0_mean_check.pass 
	if [ -e  $checkFile -a ${b0_mean_sim} -ot $checkFile   ]; then
		echo "Warning:${WORKDIR}:ignoring insufficient overlap between corrected and original b0 image (NCC = ${NCC} < ${NCC_THR})"
	else 
	    MSG="ERROR:${WORKDIR}:"
	    if [ -e  $checkFile ]; then
		MSG="$MSG" + "${checkFile} is older than ${b0_mean_sim} and " 
	    fi
	    MSG="${MSG}insufficient overlap between corrected and original b0 image (NCC = ${NCC} < ${NCC_THR})!  Check $WORKDIR/diffusion/pepolar/corrected/b0_mean.nii.gz $WORKDIR/diffusion/native/dti60b1000/dti60-01.nii.gz. If insufficient overlap should be ignored, 'touch ${checkFile}'!"
	    if [ -e ${b0_mean_pre}.orig ]; then 
		echo "${MSG} Note, ORIG (not the default FLIP) is used for ${b0_mean_pre}"
	    else 
		echo "${MSG} Note, the default FLIP is used for ${b0_mean_pre} !"
	    fi
	    echo "${MSG}" | ncanda_error_email $(basename $0)
	    # delete any files afterwards via 
	    #for CASE in `ls -d $WORKDIR/diffusion/pepolar/* | grep -v corrected`; do rm -rf $CASE; done
	    exit 1
	fi
fi

b0Unwarp=${DIFFUSION_DIR}/${branch}/corrected/b0_unwarp.nii.gz
if LWDP_needs_update_and_lock ${b0Unwarp} ${b0_mean}; then
    # make sure everything other than this directory is removed 
    for DIR in `ls -d ${DIFFUSION_DIR}/${branch}/* | grep -v ${branch}/corrected`; do 
	echo "INFO:$WORKDIR:Removing $DIR!"
	rm -rf $DIR
    done
    mkdir ${DIFFUSION_DIR}/${branch}/corrected/keep
    mv ${DIFFUSION_DIR}/${branch}/corrected/b0* ${DIFFUSION_DIR}/${branch}/corrected/topup*  ${DIFFUSION_DIR}/${branch}/corrected/acqparams.txt ${DIFFUSION_DIR}/${branch}/corrected/keep/.
    
    for DIR in `ls -d ${DIFFUSION_DIR}/${branch}/corrected/* | grep -v -e corrected/keep -e ${b0Unwarp}.lock`; do 
	echo "INFO:$WORKDIR:Removing $DIR!"
	rm -rf $DIR
    done
    mv ${DIFFUSION_DIR}/${branch}/corrected/keep/* ${DIFFUSION_DIR}/${branch}/corrected/. 
    rm -rf ${DIFFUSION_DIR}/${branch}/corrected/keep
    rm -rf ${DIFFUSION_DIR}/${branch}/corrected/b0_mean_mask.nii.gz

    if [ ! -e ${b0_mean} ]; then 
	echo "ERROR:$WORKDIR:something went wrong with cleaning up corrected!"
	LWDP_lockfile_delete ${b0Unwarp}
	exit 1 
    fi

    dim1=`fsl fslval ${b0_mean} dim1 | tr -d " "`
    dim2=`fsl fslval ${b0_mean} dim2 | tr -d " "`
    dim3=`fsl fslval ${b0_mean} dim3 | tr -d " "`
    if [ ${dim1} -ne 128 ] || [ ${dim2} -ne 128 ]; then
        # resample to 128x128 slice
        c3d c3d ${b0_mean} -interpolation Sinc -resample 128x128x${dim3}vox -clip 0 inf -type float -o ${b0Unwarp}
    else
        c3d c3d ${b0_mean} -o ${b0Unwarp}
    fi
    touch -r ${b0Unwarp}

    LWDP_lockfile_delete ${b0Unwarp}
fi

#
# Align with structural data
#

b0_t1_pfx=${DIFFUSION_DIR}/${branch}/registration/b0_t1/ants_
b0_t1_affine=${b0_t1_pfx}0GenericAffine.mat
if LWDP_needs_update_and_lock ${b0_t1_affine} ${b0Unwarp} ${t2_mrbias}; then
  log_out=${b0_t1_pfx}0GenericAffine.log
  ants antsRegistration -d 3 -r [${b0Unwarp},${t2_mrbias},1] -t Rigid[0.1] -m MI[${b0Unwarp},${t2_mrbias},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${b0Unwarp},${t2_mrbias},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${b0_t1_pfx} > ${log_out}
  LWDP_lockfile_delete ${b0_t1_affine}
fi
export b0_t1_affine=$(LWDP_get_override_file ${b0_t1_affine})

b0_t1_warp=${b0_t1_pfx}1Warp.nii.gz
if LWDP_needs_update_and_lock ${b0_t1_warp} ${b0Unwarp} ${t2_mrbias}; then
  log_out=${b0_t1_pfx}1Warp.log
  ants antsRegistration -d 3 --initial-moving-transform ${b0_t1_affine} -t SyN[0.5,3,0.5] -m CC[${b0Unwarp},${t2_mrbias},1,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${b0_t1_pfx} > ${log_out}
  LWDP_lockfile_delete ${b0_t1_warp}
fi
export b0_t1_warp=$(LWDP_get_override_file ${b0_t1_warp})

b0_t1_warp_inv=${b0_t1_pfx}1InverseWarp.nii.gz
export b0_t1_warp_inv=$(LWDP_get_override_file ${b0_t1_warp_inv})

b0_t1_mtx="${b0_t1_warp} ${b0_t1_affine}"
t1_b0_mtx="[${b0_t1_affine},1] ${b0_t1_warp_inv}"

#
# Reformat brain mask
#

t1_brainmask=$(LWDP_get_override_file ${WORKDIR}/structural/stripped/t1_brain_mask.nii.gz)
b0_brainmask=${DIFFUSION_DIR}/${branch}/reslice/b0_unwarp/brainmask.nii.gz
#if LWDP_needs_update_and_lock ${b0_brainmask} ${t1_brainmask} ${b0_t1_mtx} ${b0Unwarp}; then
#  ants antsApplyTransforms -n NearestNeighbor -i ${t1_brainmask} -r ${b0Unwarp} -o ${b0_brainmask} -t ${b0_t1_mtx}
#  c3d c3d ${b0_brainmask} -type uchar -o ${b0_brainmask}
#  LWDP_lockfile_delete ${b0_brainmask}
#f
# djk: using t2_brain_exp_mask to remove out non-csf regions
t2_brain_exp_mask=$(LWDP_get_override_file ${WORKDIR}/structural/reslice/subject_t1/t2_brain_exp_mask.nii.gz)
if LWDP_needs_update_and_lock ${b0_brainmask} ${t1_brainmask} ${t2_brain_exp_mask} ${b0_t1_mtx} ${b0Unwarp}; then
  tmpdir=$(mktemp -d)
  ants antsApplyTransforms -n NearestNeighbor -i ${t1_brainmask} -r ${b0Unwarp} -o ${tmpdir}/t1_mask.nii.gz -t ${b0_t1_mtx}
  ants antsApplyTransforms -n NearestNeighbor -i ${t2_brain_exp_mask} -r ${b0Unwarp} -o ${tmpdir}/t2_mask.nii.gz -t ${b0_t1_mtx}
  #
  #c3d c3d ${tmpdir}/t2_mask.nii.gz -holefill 1 0 -o ${tmpdir}/t2_mask.nii.gz
  c3d c3d ${tmpdir}/t2_mask.nii.gz -dilate 1 1x1x1vox -o ${tmpdir}/t2_mask_d.nii.gz
  c3d c3d ${tmpdir}/t2_mask_d.nii.gz -holefill 1 0 -o ${tmpdir}/t2_mask_d_h.nii.gz
  c3d c3d ${tmpdir}/t2_mask_d_h.nii.gz -erode 1 1x1x1vox -o ${tmpdir}/t2_mask.nii.gz
  #
  c3d c3d ${tmpdir}/t1_mask.nii.gz ${tmpdir}/t2_mask.nii.gz -multiply -type uchar -o ${b0_brainmask}
  rm -rf ${tmpdir}
  LWDP_lockfile_delete ${b0_brainmask}
fi
export b0_brainmask=$(LWDP_get_override_file ${b0_brainmask})

b0_brain=${DIFFUSION_DIR}/${branch}/reslice/b0_unwarp/b0_brain.nii.gz
if LWDP_needs_update_and_lock ${b0_brain} ${b0_Unwarp} ${b0_brainmask}; then
  c3d c3d ${b0Unwarp} ${b0_brainmask} -multiply -o ${b0_brain}
  LWDP_lockfile_delete ${b0_brain}
fi
export b0_brain=$(LWDP_get_override_file ${b0_brain})

sri24_parc=${DATA_DIR}/sri24/parcellation/sri24_parc116.nii.gz
b0_parc=${DIFFUSION_DIR}/${branch}/reslice/b0_unwarp/sri24_parc116.nii.gz
if LWDP_needs_update_and_lock ${b0_parc} ${sri24_parc} ${b0Unwarp} ${b0_t1_mtx} ${t1_sri24_mtx}; then
  # choose MultiLabel params which preserves boundaries close to NN, but applying some mild smoothness
  ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${sri24_parc} -r ${b0Unwarp} -o ${b0_parc} -t ${b0_t1_mtx} ${t1_sri24_mtx}
  c3d c3d ${b0_parc} -type short -o ${b0_parc}
  LWDP_lockfile_delete ${b0_parc}
fi
export b0_parc=$(LWDP_get_override_file ${b0_parc})

# transform b0 to t1 space for testing
b0_aligned_to_t1=${DIFFUSION_DIR}/${branch}/reslice/subject_t1/b0.nii.gz
if LWDP_needs_update_and_lock ${b0_aligned_to_t1} ${b0Unwarp} ${t2_mrbias} ${b0_t1_affine} ${b0_t1_warp_inv}; then
  ants antsApplyTransforms -n linear -i ${b0Unwarp} -r ${t2_mrbias} -o ${b0_aligned_to_t1} -t ${t1_b0_mtx}
  c3d c3d ${b0_aligned_to_t1} -type float -o ${b0_aligned_to_t1}
  LWDP_lockfile_delete ${b0_aligned_to_t1}
fi
b0_brain_aligned_to_t1=${DIFFUSION_DIR}/${branch}/reslice/subject_t1/b0_brain.nii.gz
if LWDP_needs_update_and_lock ${b0_brain_aligned_to_t1} ${b0_aligned_to_t1} ${t1_brainmask}; then
  c3d c3d ${b0_aligned_to_t1} ${t1_brainmask} -multiply -o ${b0_brain_aligned_to_t1}
  LWDP_lockfile_delete ${b0_brain_aligned_to_t1}
fi

if [ "${branch}" == "pepolar" ]; then
  # generate mask for b0_mean
  b0_mean_mask=${DIFFUSION_DIR}/${branch}/corrected/b0_mean_mask.nii.gz
  if LWDP_needs_update_and_lock ${b0_mean_mask} ${t1_brainmask} ${b0_t1_mtx} ${b0_mean}; then
    ants antsApplyTransforms -n NearestNeighbor -i ${t1_brainmask} -r ${b0_mean} -o ${b0_mean_mask} -t ${b0_t1_mtx}
    c3d c3d ${b0_mean_mask} -type uchar -o ${b0_mean_mask}
    LWDP_lockfile_delete ${b0_mean_mask}
  fi
  #
  bval_file=${DIFFUSION_DIR}/${branch}/corrected/bval.txt
  bvec_file=${DIFFUSION_DIR}/${branch}/corrected/bvec.txt
  idx_file=${DIFFUSION_DIR}/${branch}/corrected/idx.txt
  if LWDP_needs_update_and_lock ${bval_file} ${bXlist}; then
    bval_list=
    bvec_x_list=
    bvec_y_list=
    bvec_z_list=
    idx_list=
    for bX in ${bXlist}; do
      xml_file="$(echo ${bX} | sed 's/\.gz//g').xml"
      bval=`fgrep bValue ${xml_file} | sed 's/^[^<]*<[^<]*>//g; s/<[^<]*>[^<]*$//g' | tr -d " "`
      bvec=`fgrep bVectorImage ${xml_file} | sed 's/^[^<]*<[^<]*>//g; s/<[^<]*>[^<]*$//g' | tr -s " "`
      bvec_x=`echo ${bvec} | cut -d " " -f1`
      bvec_y=`echo ${bvec} | cut -d " " -f2`
      bvec_z=`echo ${bvec} | cut -d " " -f3`
      if [ "${bval_list}" == "" ]; then
        bval_list="${bval}"
        bvec_x_list="${bvec_x}"
        bvec_y_list="${bvec_y}"
        bvec_z_list="${bvec_z}"
        idx_list="1"
      else
        bval_list="${bval_list} ${bval}"
        bvec_x_list="${bvec_x_list} ${bvec_x}"
        bvec_y_list="${bvec_y_list} ${bvec_y}"
        bvec_z_list="${bvec_z_list} ${bvec_z}"
        idx_list="${idx_list} 1"
      fi
      echo ${bval_list} > ${bval_file}
      echo ${bvec_x_list} > ${bvec_file}
      echo ${bvec_y_list} >> ${bvec_file}
      echo ${bvec_z_list} >> ${bvec_file}
      echo ${idx_list} > ${idx_file}
    done
    LWDP_lockfile_delete ${bval_file}
  fi
  dwi_unwarp=${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp.nii.gz
  dwi_unwarp_params=${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp.eddy_parameters
  dwi_unwarp_bvecs=${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp.eddy_rotated_bvecs
  dwi_unwarp_movement_rms=${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp.eddy_movement_rms
  dwi_unwarp_outlier_map=${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp.eddy_outlier_map
  if LWDP_needs_update_and_lock ${dwi_unwarp} ${bXlist} ${b0_mean_mask} ${topup_acqparams} ${bval_file} ${bvec_file} ${idx_file}; then
    tmpdir=$(mktemp -d)
    fsl fslmerge -t ${tmpdir}/dwi.nii.gz ${bXlist}
    # eddy_openmp is from fsl 5.0.8 Centos6 version
    #fsl eddy_openmp --imain=${tmpdir}/dwi --mask=${b0_mean_mask} --acqp=${topup_acqparams} --index=${idx_file} --bvecs=${bvec_file} --bvals=${bval_file} --topup=${DIFFUSION_DIR}/${branch}/corrected/topup --out=${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp
    CMD="$fsl_eddy --imain=${tmpdir}/dwi --mask=${b0_mean_mask} --acqp=${topup_acqparams} --index=${idx_file} --bvecs=${bvec_file} --bvals=${bval_file} --topup=${DIFFUSION_DIR}/${branch}/corrected/topup --out=${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp"
    if $CMD; then
	  rm -rf ${tmpdir}
    else
	  echo "ERROR:$WORKDIR:The following command failed '$CMD' !"
	  rm -rf ${tmpdir}
	  LWDP_lockfile_delete ${dwi_unwarp}
	  exit 1
    fi
    LWDP_lockfile_delete ${dwi_unwarp}
  fi

  if [ `grep p+0 ${dwi_unwarp_params}  | wc -l` -gt 0 ]; then 
	# happens if job is run on node09 
	echo "ERROR:$WORKDIR:${dwi_unwarp_params} seems to contain non-numeric value:"
	cat ${dwi_unwarp_params}
	echo "ERROR:$WORKDIR:Try running one node02 "
	echo "  rm -f ${dwi_unwarp}"
	echo "  $NCANDA_BINARY_DIR/ncanda_diffusion_pipeline $WORKDIR"
	if false; then 
	    echo "===== ${topup_acqparams}"
	    cat ${topup_acqparams}
	    echo "===== ${idx_file}"
	    cat ${idx_file}
	    echo "===== ${bvec_file}"
	    cat ${bvec_file} 
	    echo "===== ${bval_file}"
	    cat ${bval_file}
	fi
	exit 1
  fi

  # if dti_rotate_bvec.py returns error message pops up that "dwi_unwarp.eddy_parameters contains non float values"
  # then delete dwi_unwarp.* and execute on a different machine
  if LWDP_needs_update_and_lock ${dwi_unwarp_bvecs} ${dwi_unwarp}; then
    ${NCANDA_SOURCE_DIR}/utils/dti_rotate_bvec.py -b ${bvec_file} -e ${dwi_unwarp_params} -o ${dwi_unwarp_bvecs} -r ${dwi_unwarp_movement_rms}
    LWDP_lockfile_delete ${dwi_unwarp_bvecs}
  fi
  bad_slices=${DIFFUSION_DIR}/badmasked/dti60b1000/bad_slices.csv
  if LWDP_needs_update_and_lock ${dwi_unwarp_outlier_map} ${dwi_unwarp} ${bad_slices}; then
    dim3=`fsl fslval ${dwi_unwarp} dim3 | tr -d " "`
    dim4=`fsl fslval ${dwi_unwarp} dim4 | tr -d " "`
    ${NCANDA_SOURCE_DIR}/utils/dti_make_outlier_map.py -b ${bad_slices} -s ${dim3} -v ${dim4} -o ${dwi_unwarp_outlier_map}
    LWDP_lockfile_delete ${dwi_unwarp_outlier_map}
  fi
  unwarp=${DIFFUSION_DIR}/${branch}/corrected/unwarp/dti60-01.nii.gz
  unwarp_average=${DIFFUSION_DIR}/${branch}/corrected/unwarp/bAverage.nii.gz
  if LWDP_needs_update_and_lock ${unwarp} ${bXlist} ${dwi_unwarp} ${bval_file}; then
    tmpdir=$(mktemp -d)
    fsl fslsplit ${dwi_unwarp} ${tmpdir}/dwi_unwarp_ -t
    bval_list=$(cat ${bval_file})
    bdir_list=
    idx=0
    for bX in ${bXlist}; do
      bXname=`basename ${bX}`
      idxf=`printf "%04d" ${idx}`
      let idx++
      bval=`echo ${bval_list} | cut -d " " -f${idx}`
      dim1=`fsl fslval ${tmpdir}/dwi_unwarp_${idxf}.nii.gz dim1 | tr -d " "`
      dim2=`fsl fslval ${tmpdir}/dwi_unwarp_${idxf}.nii.gz dim2 | tr -d " "`
      dim3=`fsl fslval ${tmpdir}/dwi_unwarp_${idxf}.nii.gz dim3 | tr -d " "`
      if [ ${dim1} -ne 128 ] || [ ${dim2} -ne 128 ]; then
        # resample to 128x128 slice
        c3d c3d ${tmpdir}/dwi_unwarp_${idxf}.nii.gz -interpolation Sinc -resample 128x128x${dim3}vox -clip 0 inf -type float -o ${DIFFUSION_DIR}/${branch}/corrected/unwarp/${bXname}
      else
        c3d c3d ${tmpdir}/dwi_unwarp_${idxf}.nii.gz -type float -o ${DIFFUSION_DIR}/${branch}/corrected/unwarp/${bXname}
      fi
      if [ ${bval} -ne 0 ]; then
        bdir_list="${bdir_list} ${DIFFUSION_DIR}/${branch}/corrected/unwarp/${bXname}"
      fi
    done
    fsl fsladd ${unwarp_average} -m ${bdir_list}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${unwarp}
  fi
  final=${DIFFUSION_DIR}/${branch}/corrected/final/dti60-01.nii.gz
  if LWDP_needs_update_and_lock ${final} ${bXlist} ${dwi_unwarp} ${dwi_unwarp_outlier_map}; then
    bval_list=$(cat ${bval_file})
    idx=1
    for bX in ${bXlist}; do
      bXname=`basename ${bX}`
      bval=`echo ${bval_list} | cut -d " " -f${idx}`
      let idx++
      outlier_list=`sed "${idx}q;d" ${dwi_unwarp_outlier_map} | tr -s " "`
      slice_idx=0
      outlier_txt=
      is_outlier_prev=0
      for outlier in ${outlier_list};do
        if [ "${outlier}" == "1" ]; then
          if [ "${outlier_txt}" == "" ]; then
            outlier_txt="iszero(k-${slice_idx}-1),iszero(k-${slice_idx}),iszero(k-${slice_idx}+1)"
          else
            if [ ${is_outlier_prev} -eq 1 ]; then
              outlier_txt="${outlier_txt},iszero(k-${slice_idx}+1)"
            else
              outlier_txt="${outlier_txt},iszero(k-${slice_idx}-1),iszero(k-${slice_idx}),iszero(k-${slice_idx}+1)"
            fi
          fi
          is_outlier_prev=1
        else
          is_outlier_prev=0
        fi
        let slice_idx++
      done
      if [ "${outlier_txt}" == "" ]; then
        c3d c3d ${DIFFUSION_DIR}/${branch}/corrected/unwarp/${bXname} -o ${DIFFUSION_DIR}/${branch}/corrected/final/${bXname}
      else
        afni 3dcalc -a ${DIFFUSION_DIR}/${branch}/corrected/unwarp/${bXname} -expr "-1*or(${outlier_txt})+a*(1-or(${outlier_txt}))" -prefix ${DIFFUSION_DIR}/${branch}/corrected/final/${bXname} -overwrite
      fi
    done
    LWDP_lockfile_delete ${final}
  fi
  gradient=${DIFFUSION_DIR}/${branch}/corrected/final/dti60-01.gradient
  if LWDP_needs_update_and_lock ${gradient} ${bXlist} ${dwi_unwarp_bvecs}; then
    bvec_x_list=`sed "1q;d" ${dwi_unwarp_bvecs} | tr -s " "`
    bvec_y_list=`sed "2q;d" ${dwi_unwarp_bvecs} | tr -s " "`
    bvec_z_list=`sed "3q;d" ${dwi_unwarp_bvecs} | tr -s " "`
    idx=1
    for bv in ${bvec_x_list}; do
      bvec_x[${idx}]=${bv}
      let idx++
    done
    idx=1
    for bv in ${bvec_y_list}; do
      bvec_y[${idx}]=${bv}
      let idx++
    done
    idx=1
    for bv in ${bvec_z_list}; do
      bvec_z[${idx}]=${bv}
      let idx++
    done
    idx=1
    for bX in ${bXlist}; do
      bXname=`basename ${bX}`
      out_file="$(echo ${bXname} | sed 's/\..*//g').gradient"
      echo "${bvec_x[${idx}]} ${bvec_y[${idx}]} ${bvec_z[${idx}]}" > ${DIFFUSION_DIR}/${branch}/corrected/final/${out_file}
      let idx++
    done
    LWDP_lockfile_delete ${gradient}
  fi
  # make inclusion_list for camino
  included_volumes_file=${DIFFUSION_DIR}/${branch}/camino/inclusion_list.txt
  in_final_list=$(ls ${DIFFUSION_DIR}/${branch}/corrected/final/dti60-??.nii.gz | sort)
  final_average=${DIFFUSION_DIR}/${branch}/corrected/final/bAverage.nii.gz
  if LWDP_needs_update_and_lock ${included_volumes_file} ${dwi_unwarp_movement_rms} ${dwi_unwarp_outlier_map} ${in_final_list}; then
    rm -f ${included_volumes_file}
    bval_list=$(cat ${bval_file})
    bdir_list=
    excluded_num=0
    idx=1
    for bX in ${in_final_list}; do
      dwi_image=$(echo ${bX} | sed 's/.*\/final\///g; s/\..*//g')
      bval=`echo ${bval_list} | cut -d " " -f${idx}`
      #
      rms_list=`sed "${idx}q;d" ${dwi_unwarp_movement_rms} | tr -s " "`
      rms_t=`echo ${rms_list} | cut -d " " -f1`
      rms_t=`printf "%f" ${rms_t}`
      rms_r=`echo ${rms_list} | cut -d " " -f2`
      rms_r=`printf "%f" ${rms_r}`
      rms_check=`bc -l <<< "${rms_t} > 1.5 || ${rms_r} > 1.5"`
      let idx++
      outlier_num=0
      outlier_list=`sed "${idx}q;d" ${dwi_unwarp_outlier_map} | tr -s " "`
      for outlier in ${outlier_list}; do
        if [ "${outlier}" == "1" ]; then
          let outlier_num++
        fi
      done
      outlier_check_1=`bc -l <<< "${outlier_num} > 8"`
      outlier_check_2=`bc -l <<< "${outlier_num} > 2"`
      if [ ${outlier_check_1} -eq 1 ]; then
        echo "INFO: ${WORKDIR}: ${dwi_image} excluded: rms_t = ${rms_t}, rms_r = ${rms_r}, outlier_num = ${outlier_num}"
        let excluded_num++
        continue
      fi
      if [ ${outlier_check_2} -eq 1 ] && [ ${rms_check} -eq 1 ]; then
        echo "INFO: ${WORKDIR}: ${dwi_image} excluded: rms_t = ${rms_t}, rms_r = ${rms_r}, outlier_num = ${outlier_num}"
        let excluded_num++
        continue
      fi
      echo ${dwi_image} >> ${included_volumes_file}
      if [ ${bval} -ne 0 ]; then
        bdir_list="${bdir_list} ${bX}"
      fi
    done
    cmtk imagemath --set-padding-value -1 --in ${bdir_list} --average --out ${final_average}
    if [ ${excluded_num} -gt 6 ]; then
      echo "WARNING: ${WORKDIR}: excluded number = ${excluded_num} is larger than 6 (10%)"
    fi
    LWDP_lockfile_delete ${included_volumes_file}
  fi
fi

included_volumes_file=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/inclusion_list.txt)

#
# 2 - Make Camino voxel file
#

in_nii_list=$(cat ${included_volumes_file} | while read f; do echo ${DIFFUSION_DIR}/${branch}/corrected/final/${f}.nii.gz; done)
number_of_images=$(echo ${in_nii_list} | wc -w)
out_voxels=${DIFFUSION_DIR}/${branch}/camino/voxels.short
if LWDP_needs_update_and_lock ${out_voxels} ${b0Unwarp} ${in_nii_list} ${included_volumes_file}; then
  nvoxels=$(cmtk describe ${b0Unwarp} | awk '/voxels/ {print $1 * $3 * $5}')
  scanner2voxel="camino scanner2voxel -voxels ${nvoxels} -components ${number_of_images} -inputdatatype short -outputdatatype short"
  if !(cmtk stream_pixels --convert short --change-endian ${in_nii_list} | ${scanner2voxel} > ${out_voxels}); then
    rm ${out_voxels}
  fi
  if [ -s ${out_voxels} ]; then
    gzip -9f ${out_voxels}
  else
    rm -f ${out_voxels}
  fi
  LWDP_lockfile_delete ${out_voxels}
fi

#
# 3 - Make camino scheme file
#

gradient_file_list=$(cat ${included_volumes_file} | while read f; do echo ${DIFFUSION_DIR}/${branch}/corrected/final/${f}.gradient; done)
scheme_file=${DIFFUSION_DIR}/${branch}/camino/scheme
if LWDP_needs_update_and_lock ${scheme_file} ${gradient_file_list} ${included_volumes_file}; then
  cat ${gradient_file_list} | camino pointset2scheme -bvalue 1000 > ${scheme_file}
  # File is empty 
  if [ ! -s ${scheme_file} ]; then 
	echo "ERROR:$WORKDIR:camino pointset2scheme failed to produce scheme file!" 
	rm -f ${scheme_file}
	exit 1 
  fi 
  LWDP_lockfile_delete ${scheme_file}
fi

#
# 4 - Make Camino tensor file
#

voxels_file=${DIFFUSION_DIR}/${branch}/camino/voxels.short
for number_and_model in 1/ldt; do ##  2/pospos 3/pospospos ## We MUST do "ldt" because for now it's the only one that will ignore negative (masked-out) values in the DWI
  ntens=$(echo $number_and_model | cut -d/ -f1)
  model=$(echo $number_and_model | cut -d/ -f2)
  out_tensors=${DIFFUSION_DIR}/${branch}/camino/tensors_${ntens}.Bdouble
  if LWDP_needs_update_and_lock ${out_tensors} ${scheme_file} ${voxels_file} ${b0_brainmask}; then
    dtfit="camino modelfit -bgthresh 1 -inputdatatype short -model ${model} -schemefile ${scheme_file} -bgmask ${b0_brainmask}"
    if ! (gzip -fcd ${voxels_file} | ${dtfit} > ${out_tensors}); then
      rm ${out_tensors}
    fi
    if [ -s ${out_tensors} ]; then
      gzip -9f ${out_tensors}
    else
      echo "ERROR: ${WORKDIR}: Failed to create ${out_tensors} on host ${HOSTNAME}"
      rm ${out_tensors}
    fi
    LWDP_lockfile_delete ${out_tensors}
  fi
done

#
# 5 - Make Camino scalar maps
#

map=("fa" "md" "l1" "lt")
# these are some conservative maximum values for each mod
clip_max=("1" "0.003" "0.004" "0.005")

tensors_file=${DIFFUSION_DIR}/${branch}/camino/tensors_1.Bdouble.gz
for map_idx in 0 1; do
  out_map=${DIFFUSION_DIR}/${branch}/camino/${map[${map_idx}]}.nii
  if LWDP_needs_update_and_lock ${out_map} ${tensors_file} ${b0Unwarp}; then
    tmpdir=$(mktemp -d)
    gzip -cd ${tensors_file} | camino ${map[${map_idx}]} -outputdatatype float > ${tmpdir}/raw

    cmtk mk_nifti_hdr --attached --import ${b0Unwarp} --float ${tmpdir}/${map[${map_idx}]}.nii
    cat ${tmpdir}/raw | camino shredder 0 -4 0 >> ${tmpdir}/${map[${map_idx}]}.nii

    cmtk convertx --set-padding 0 --replace-inf-nan 0 --thresh-below 0 --thresh-above ${clip_max[${map_idx}]} ${tmpdir}/${map[${map_idx}]}.nii ${out_map}
    rm -rf ${tmpdir}

    LWDP_lockfile_delete ${out_map}
  fi
done

# Check for override files
subject_md=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/md.nii)
subject_fa=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/fa.nii)

# Make eigenvalue maps, l1 and lt
subject_l1=${DIFFUSION_DIR}/${branch}/camino/l1.nii
if LWDP_needs_update_and_lock ${subject_l1} ${tensors_file}; then
  tmpdir=$(mktemp -d)
  gzip -cd ${tensors_file} | camino dteig -outputdatatype float > ${tmpdir}/dteig

  cmtk mk_nifti_hdr --attached --import ${b0Unwarp} --float ${tmpdir}/l1.nii
  cat ${tmpdir}/dteig | camino shredder 0 -4 44 >> ${tmpdir}/l1.nii

  cmtk convertx --set-padding 0 --replace-inf-nan 0 --thresh-below 0 --thresh-above ${clip_max[2]} ${tmpdir}/l1.nii ${subject_l1}

  rm -rf ${tmpdir}
  LWDP_lockfile_delete ${subject_l1}
fi
subject_l1=$(LWDP_get_override_file ${subject_l1})

subject_lt=${DIFFUSION_DIR}/${branch}/camino/lt.nii
if LWDP_needs_update_and_lock ${subject_lt} ${subject_md} ${subject_l1}; then
  cmtk imagemath --float --in ${subject_md} --scalar-mul 3 --in ${subject_l1} --scalar-mul -1 --add --thresh-below 0 --thresh-above ${clip_max[3]} --out ${subject_lt}
  LWDP_lockfile_delete ${subject_lt}
fi
subject_lt=$(LWDP_get_override_file ${subject_lt})

# Create upsampled FA image - this will be used for creating fiber tracking seed images
subject_fa_upsample=${DIFFUSION_DIR}/${branch}/camino/fa_1_25mm.nii
if LWDP_needs_update_and_lock ${subject_fa_upsample} ${subject_fa}; then
  cmtk convertx --resample 1.24 ${subject_fa} ${subject_fa_upsample}
  LWDP_lockfile_delete ${subject_fa_upsample}
fi

#
# Refine alignment with SRI24 atlas based on FA map
#

fa_subject=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/fa.nii.gz)
fa_atlas=${DATA_DIR}/sri24/sri24_fa.nii.gz

if [ "${branch}" == "pepolar" ]; then
  ## warp scheme
  ## refine t1 to b0 registration using sri24 b0
  #sri24_b0=${DATA_DIR}/sri24/sri24_dwi_b0.nii.gz
  #sri24_b0_aligned_to_t1=${DIFFUSION_DIR}/${branch}/reslice/subject_t1/sri24_dwi_b0.nii.gz
  #if LWDP_needs_update_and_lock ${sri24_b0_aligned_to_t1} ${sri24_b0} ${t2_mrbias} ${t1_sri24_mtx}; then
  #  ants antsApplyTransforms -d 3 -n BlackmanWindowedSinc -i ${sri24_b0} -r ${t2_mrbias} -o ${sri24_b0_aligned_to_t1} -t ${t1_sri24_mtx}
  #  c3d c3d ${sri24_b0_aligned_to_t1} -clip 0 inf -type float -o ${sri24_b0_aligned_to_t1}
  #  LWDP_lockfile_delete ${sri24_b0_aligned_to_t1}
  #fi
  ##
  #b0_t1_refine_pfx=${DIFFUSION_DIR}/${branch}/registration/b0_t1_refine/ants_
  #b0_t1_refine_affine=${b0_t1_refine_pfx}0GenericAffine.mat
  #if LWDP_needs_update_and_lock ${b0_t1_refine_affine} ${b0_brain} ${sri24_b0_aligned_to_t1}; then
  #  log_out=${b0_t1_refine_pfx}0GenericAffine.log
  #  ants antsRegistration -d 3 -r [${b0_brain},${sri24_b0_aligned_to_t1},1] -t Rigid[0.1] -m MI[${b0_brain},${sri24_b0_aligned_to_t1},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${b0_brain},${sri24_b0_aligned_to_t1},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${b0_t1_refine_pfx} > ${log_out}
  #  LWDP_lockfile_delete ${b0_t1_refine_affine}
  #fi
  #export b0_t1_refine_affine=$(LWDP_get_override_file ${b0_t1_refine_affine})
  #
  #b0_t1_refine_warp=${b0_t1_refine_pfx}1Warp.nii.gz
  #if LWDP_needs_update_and_lock ${b0_t1_refine_warp} ${b0_brain} ${sri24_b0_aligned_to_t1}; then
  #  log_out=${b0_t1_refine_pfx}1Warp.log
  #  ants antsRegistration -d 3 --initial-moving-transform ${b0_t1_refine_affine} -t SyN[0.5,3,0.5] -m CC[${b0_brain},${sri24_b0_aligned_to_t1},1,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${b0_t1_refine_pfx} > ${log_out}
  #  LWDP_lockfile_delete ${b0_t1_refine_warp}
  #fi
  #export b0_t1_refine_warp=$(LWDP_get_override_file ${b0_t1_refine_warp})
  #
  #b0_t1_refine_warp_inv=${b0_t1_refine_pfx}1InverseWarp.nii.gz
  #export b0_t1_refine_warp_inv=$(LWDP_get_override_file ${b0_t1_refine_warp_inv})
  #
  #b0_t1_refine_mtx="${b0_t1_refine_warp} ${b0_t1_refine_affine}"
  #t1_b0_refine_mtx="[${b0_t1_refine_affine},1] ${b0_t1_refine_warp_inv}"

  #sri24_b0_warp=${DIFFUSION_DIR}/${branch}/registration/sri24_b0/ants_0Warp.nii.gz
  #if LWDP_needs_update_and_lock ${sri24_b0_warp} ${fa_subject} ${fa_atlas} ${b0_t1_refine_mtx} ${t1_sri24_mtx}; then
  #  ants antsApplyTransforms -d 3 -o [${sri24_b0_warp},1] -r ${fa_atlas} -t ${sri24_t1_mtx} ${t1_b0_refine_mtx}
  #  LWDP_lockfile_delete ${sri24_b0_warp}
  #fi
  #export sri24_b0_warp=$(LWDP_get_override_file ${sri24_b0_warp})

  #b0_sri24_warp=${DIFFUSION_DIR}/${branch}/registration/b0_sri24/ants_0Warp.nii.gz
  #if LWDP_needs_update_and_lock ${b0_sri24_warp} ${fa_subject} ${fa_atlas} ${b0_t1_refine_mtx} ${t1_sri24_mtx}; then
  #  ants antsApplyTransforms -d 3 -o [${b0_sri24_warp},1] -r ${fa_subject} -t ${b0_t1_refine_mtx} ${t1_sri24_mtx}
  #  LWDP_lockfile_delete ${b0_sri24_warp}
  #fi
  #export b0_sri24_warp=$(LWDP_get_override_file ${b0_sri24_warp})

  # warp_refine scheme
  if [ "${VISIT}" == "${VISIT_REF}" ]; then
    # refine t1 to b0 registration using sri24 t2 & fa
    sri24_t2=${DATA_DIR}/sri24/sri24_t2.nii.gz
    sri24_t2_aligned_to_t1=${DIFFUSION_DIR}/${branch}/reslice/subject_t1/sri24_t2.nii.gz
    if LWDP_needs_update_and_lock ${sri24_t2_aligned_to_t1} ${sri24_t2} ${t2_mrbias} ${t1_sri24_mtx}; then
      ants antsApplyTransforms -d 3 -n BlackmanWindowedSinc -i ${sri24_t2} -r ${t2_mrbias} -o ${sri24_t2_aligned_to_t1} -t ${t1_sri24_mtx}
      c3d c3d ${sri24_t2_aligned_to_t1} -clip 0 inf -type float -o ${sri24_t2_aligned_to_t1}
      LWDP_lockfile_delete ${sri24_t2_aligned_to_t1}
    fi
    sri24_fa_aligned_to_t1=${DIFFUSION_DIR}/${branch}/reslice/subject_t1/sri24_fa.nii.gz
    if LWDP_needs_update_and_lock ${sri24_fa_aligned_to_t1} ${fa_atlas} ${t2_mrbias} ${t1_sri24_mtx}; then
      ants antsApplyTransforms -d 3 -n BlackmanWindowedSinc -i ${fa_atlas} -r ${t2_mrbias} -o ${sri24_fa_aligned_to_t1} -t ${t1_sri24_mtx}
      c3d c3d ${sri24_fa_aligned_to_t1} -clip 0 inf -type float -o ${sri24_fa_aligned_to_t1}
      LWDP_lockfile_delete ${sri24_fa_aligned_to_t1}
    fi
    #
    b0fa_t1_refine_pfx=${DIFFUSION_DIR}/${branch}/registration/b0fa_t1_refine/ants_
    b0fa_t1_refine_affine=${b0fa_t1_refine_pfx}0GenericAffine.mat
    if LWDP_needs_update_and_lock ${b0fa_t1_refine_affine} ${b0_brain} ${sri24_t2_aligned_to_t1}; then
      log_out=${b0fa_t1_refine_pfx}0GenericAffine.log
      ants antsRegistration -d 3 -r [${b0_brain},${sri24_t2_aligned_to_t1},1] -t Rigid[0.1] -m MI[${b0_brain},${sri24_t2_aligned_to_t1},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${b0_brain},${sri24_t2_aligned_to_t1},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${b0fa_t1_refine_pfx} > ${log_out}
      LWDP_lockfile_delete ${b0fa_t1_refine_affine}
    fi
    export b0fa_t1_refine_affine=$(LWDP_get_override_file ${b0fa_t1_refine_affine})

    b0fa_t1_refine_warp=${b0fa_t1_refine_pfx}1Warp.nii.gz
    if LWDP_needs_update_and_lock ${b0fa_t1_refine_warp} ${b0_brain} ${fa_subject} ${sri24_t2_aligned_to_t1} ${sri24_fa_aligned_to_t1}; then
      log_out=${b0fa_t1_refine_pfx}1Warp.log
      ants antsRegistration -d 3 --initial-moving-transform ${b0fa_t1_refine_affine} -t SyN[0.5,3,0.5] -m CC[${b0_brain},${sri24_t2_aligned_to_t1},0.5,4] -m CC[${fa_subject},${sri24_fa_aligned_to_t1},0.5,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${b0fa_t1_refine_pfx} > ${log_out}
      LWDP_lockfile_delete ${b0fa_t1_refine_warp}
    fi
    export b0fa_t1_refine_warp=$(LWDP_get_override_file ${b0fa_t1_refine_warp})

    b0fa_t1_refine_warp_inv=${b0fa_t1_refine_pfx}1InverseWarp.nii.gz
    export b0fa_t1_refine_warp_inv=$(LWDP_get_override_file ${b0fa_t1_refine_warp_inv})

    b0fa_t1_refine_mtx="${b0fa_t1_refine_warp} ${b0fa_t1_refine_affine}"
    t1_b0fa_refine_mtx="[${b0fa_t1_refine_affine},1] ${b0fa_t1_refine_warp_inv}"

    sri24_b0fa_warp=${DIFFUSION_DIR}/${branch}/registration/sri24_b0fa/ants_0Warp.nii.gz
    if LWDP_needs_update_and_lock ${sri24_b0fa_warp} ${fa_subject} ${fa_atlas} ${b0fa_t1_refine_mtx} ${t1_sri24_mtx}; then
      ants antsApplyTransforms -d 3 -o [${sri24_b0fa_warp},1] -r ${fa_atlas} -t ${sri24_t1_mtx} ${t1_b0fa_refine_mtx}
      LWDP_lockfile_delete ${sri24_b0fa_warp}
    fi
    export sri24_b0fa_warp=$(LWDP_get_override_file ${sri24_b0fa_warp})

    b0fa_sri24_warp=${DIFFUSION_DIR}/${branch}/registration/b0fa_sri24/ants_0Warp.nii.gz
    if LWDP_needs_update_and_lock ${b0fa_sri24_warp} ${fa_subject} ${fa_atlas} ${b0fa_t1_refine_mtx} ${t1_sri24_mtx}; then
      ants antsApplyTransforms -d 3 -o [${b0fa_sri24_warp},1] -r ${fa_subject} -t ${b0fa_t1_refine_mtx} ${t1_sri24_mtx}
      LWDP_lockfile_delete ${b0fa_sri24_warp}
    fi
    export b0fa_sri24_warp=$(LWDP_get_override_file ${b0fa_sri24_warp})
  else
    # align with baseline fa
    fa_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../${VISIT_REF}/diffusion/${branch}/camino/fa.nii.gz)
    sri24_b0fa_warp_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../${VISIT_REF}/diffusion/${branch}/registration/sri24_b0fa/ants_0Warp.nii.gz)
    b0fa_sri24_warp_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../${VISIT_REF}/diffusion/${branch}/registration/b0fa_sri24/ants_0Warp.nii.gz)

    fa_to_baseline_pfx=${DIFFUSION_DIR}/${branch}/longitudinal/registration/fa_to_baseline/ants_
    fa_to_baseline_affine=${fa_to_baseline_pfx}0GenericAffine.mat
    if LWDP_needs_update_and_lock ${fa_to_baseline_affine} ${fa_subject} ${fa_at_baseline}; then
      log_out=${fa_to_baseline_pfx}0GenericAffine.log
      ants antsRegistration -d 3 -u -w [0.005,0.995] -r [${fa_subject},${fa_at_baseline},1] -t Rigid[0.1] -m MI[${fa_subject},${fa_at_baseline},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${fa_subject},${fa_at_baseline},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${fa_to_baseline_pfx} > ${log_out}
      LWDP_lockfile_delete ${fa_to_baseline_affine}
    fi
    fa_to_baseline_affine=$(LWDP_get_override_file ${fa_to_baseline_affine})

    fa_to_baseline_warp=${fa_to_baseline_pfx}1Warp.nii.gz
    if LWDP_needs_update_and_lock ${fa_to_baseline_warp} ${fa_subject} ${fa_at_baseline}; then
      log_out=${fa_to_baseline_pfx}1Warp.log
      ants antsRegistration -d 3 -u -w [0.005,0.995] --initial-moving-transform ${fa_to_baseline_affine} -t SyN[0.5,3,0.5] -m CC[${fa_subject},${fa_at_baseline},0.5,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${fa_to_baseline_pfx} > ${log_out}
      LWDP_lockfile_delete ${fa_to_baseline_warp}
    fi
    export fa_to_baseline_warp=$(LWDP_get_override_file ${fa_to_baseline_warp})

    fa_to_baseline_warp_inv=${fa_to_baseline_pfx}1InverseWarp.nii.gz
    export fa_to_baseline_warp_inv=$(LWDP_get_override_file ${fa_to_baseline_warp_inv})

    sri24_b0fa_warp=${DIFFUSION_DIR}/${branch}/registration/sri24_b0fa/ants_0Warp.nii.gz
    if LWDP_needs_update_and_lock ${sri24_b0fa_warp} ${fa_subject} ${fa_atlas} ${sri24_b0fa_warp_at_baseline} ${fa_to_baseline_affine} ${fa_to_baseline_warp_inv}; then
      ants antsApplyTransforms -d 3 -o [${sri24_b0fa_warp},1] -r ${fa_atlas} -t ${sri24_b0fa_warp_at_baseline} [${fa_to_baseline_affine},1] ${fa_to_baseline_warp_inv}
      LWDP_lockfile_delete ${sri24_b0fa_warp}
    fi
    export sri24_b0fa_warp=$(LWDP_get_override_file ${sri24_b0fa_warp})

    b0fa_sri24_warp=${DIFFUSION_DIR}/${branch}/registration/b0fa_sri24/ants_0Warp.nii.gz
    if LWDP_needs_update_and_lock ${b0fa_sri24_warp} ${fa_subject} ${fa_atlas} ${fa_to_baseline_warp} ${fa_to_baseline_affine} ${b0fa_sri24_warp_at_baseline}; then
      ants antsApplyTransforms -d 3 -o [${b0fa_sri24_warp},1] -r ${fa_subject} -t ${fa_to_baseline_warp} ${fa_to_baseline_affine} ${b0fa_sri24_warp_at_baseline}
      LWDP_lockfile_delete ${b0fa_sri24_warp}
    fi
    export b0fa_sri24_warp=$(LWDP_get_override_file ${b0fa_sri24_warp})
  fi
fi

#
# Reslice scalar maps to atlas space
#

for map_idx in 0 1 2 3; do
  input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/${map[${map_idx}]}.nii.gz)
  output=${DIFFUSION_DIR}/${branch}/reslice/sri24/affine/${map[${map_idx}]}.nii.gz
  if LWDP_needs_update_and_lock ${output} ${input} ${xfm_t1_sri24} ${xfm_bl_t1} ${fa_atlas} ${xfm_t1_dwi}; then
    ants antsApplyTransforms -d 3 -n Linear -i ${input} -r ${fa_atlas} -o ${output} -t ${sri24_t1_mtx_affine} ${t1_b0_mtx}
    c3d c3d ${output} -type float -o ${output}
    LWDP_lockfile_delete ${output}
  fi
done

if [ "${branch}" == "pepolar" ]; then
  ## for warp
  #for map_idx in 0 1 2 3; do
  #  input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/${map[${map_idx}]}.nii.gz)
  #  output=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp/${map[${map_idx}]}.nii.gz
  #  if LWDP_needs_update_and_lock ${output} ${input} ${sri24_b0_warp} ${fa_atlas}; then
  #    ants antsApplyTransforms -n Linear -i ${input} -r ${fa_atlas} -o ${output} -t ${sri24_b0_warp}
  #    c3d c3d ${output} -type float -o ${output}
  #    LWDP_lockfile_delete ${output}
  #  fi
  #done

  #input[1]=${DIFFUSION_DIR}/${branch}/corrected/final/dti60-01.nii.gz
  #input[2]=${DIFFUSION_DIR}/${branch}/corrected/final/bAverage.nii.gz
  #output[1]=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp/b0.nii.gz
  #output[2]=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp/bAverage.nii.gz
  #for i in 1 2; do
  #  if LWDP_needs_update_and_lock ${output[${i}]} ${input[${i}]} ${sri24_b0_warp} ${fa_atlas}; then
  #    ants antsApplyTransforms -n BlackmanWindowedSinc -i ${input[${i}]} -r ${fa_atlas} -o ${output[${i}]} -t ${sri24_b0_warp}
  #    c3d c3d ${output[${i}]} -clip 0 inf -type float -o ${output[${i}]}
  #    LWDP_lockfile_delete ${output[${i}]}
  #  fi
  #done

  # for warp_refine
  for map_idx in 0 1 2 3; do
    input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/${map[${map_idx}]}.nii.gz)
    output=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/${map[${map_idx}]}.nii.gz
    if LWDP_needs_update_and_lock ${output} ${input} ${sri24_b0fa_warp} ${fa_atlas}; then
      ants antsApplyTransforms -n Linear -i ${input} -r ${fa_atlas} -o ${output} -t ${sri24_b0fa_warp}
      c3d c3d ${output} -type float -o ${output}
      LWDP_lockfile_delete ${output}
    fi
  done

  input[1]=${DIFFUSION_DIR}/${branch}/corrected/final/dti60-01.nii.gz
  input[2]=${DIFFUSION_DIR}/${branch}/corrected/final/bAverage.nii.gz
  output[1]=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/b0.nii.gz
  output[2]=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/bAverage.nii.gz
  for i in 1 2; do
    if LWDP_needs_update_and_lock ${output[${i}]} ${input[${i}]} ${sri24_b0fa_warp} ${fa_atlas}; then
      ants antsApplyTransforms -n BlackmanWindowedSinc -i ${input[${i}]} -r ${fa_atlas} -o ${output[${i}]} -t ${sri24_b0fa_warp}
      c3d c3d ${output[${i}]} -clip 0 inf -type float -o ${output[${i}]}
      LWDP_lockfile_delete ${output[${i}]}
    fi
  done

  if [ "${VISIT}" != "${VISIT_REF}" ]; then
    # Correct inhomogeneity for followups
    for map_idx in 0 1 2 3; do
      smooth_width=6
      pbmap_wm=${DATA_DIR}/sri24/sri24_pbmap_WM.nii.gz
      input_b=${WORKDIR}/../${VISIT_REF}/diffusion/${branch}/reslice/sri24/warp_refine/${map[${map_idx}]}.nii.gz
      input=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/${map[${map_idx}]}.nii.gz
      bias=${DIFFUSION_DIR}/${branch}/longitudinal/reslice/sri24/warp_refine/${map[${map_idx}]}_bias_s${smooth_width}.nii.gz
      if LWDP_needs_update_and_lock ${bias} ${input} ${input_b} ${pbmap_wm}; then
        tmpdir=$(mktemp -d)
        caret7 wb_command -volume-smoothing ${input_b} ${smooth_width} ${tmpdir}/image_b.nii.gz
        caret7 wb_command -volume-smoothing ${input} ${smooth_width} ${tmpdir}/image_a.nii.gz
        fsl fslcpgeom ${input_b} ${tmpdir}/image_b.nii.gz
        fsl fslcpgeom ${input_b} ${tmpdir}/image_a.nii.gz
        afni 3dcalc -a ${tmpdir}/image_a.nii.gz -b ${tmpdir}/image_b.nii.gz -c ${pbmap_wm} -expr "c*(b-a)" -prefix ${bias}
        c3d c3d ${bias} -type float -o ${bias}
        rm -rf ${tmpdir}
        LWDP_lockfile_delete ${bias}
      fi
      output=${DIFFUSION_DIR}/${branch}/longitudinal/reslice/sri24/warp_refine/${map[${map_idx}]}.nii.gz
      if LWDP_needs_update_and_lock ${output} ${input} ${bias}; then
        c3d c3d ${input} ${bias} -add -type float -o ${output}
        LWDP_lockfile_delete ${output}
      fi
    done
  fi
fi

#
# Reslice scalar maps to subject T1w space (for subcortical tissue segmentation etc.)
#

for map_idx in 0 1 2 3; do
  input=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/${map[${map_idx}]}.nii.gz)
  output=${DIFFUSION_DIR}/${branch}/reslice/subject_t1/${map[${map_idx}]}.nii.gz
  if LWDP_needs_update_and_lock ${output} ${input} ${t2_mrbias} ${b0_t1_mtx}; then
    ants antsApplyTransforms -d 3 -n Linear -i ${input} -r ${t2_mrbias} -o ${output} -t ${t1_b0_mtx}
    c3d c3d ${output} -type float -o ${output}
    LWDP_lockfile_delete ${output}
  fi
done

