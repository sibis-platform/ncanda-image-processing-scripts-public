NCANDA_BINARY_DIR=@NCANDA_BINARY_DIR_CONFIG@
#
# Setup input and output
#

# remove trailing "/"
if [ "${1: -1:1}" == "/" ]; then
  export WORKDIR=${1:: -1}
else
  export WORKDIR=${1}
fi

FREESURFER_LONGITUDINAL_FLAG=$2 
bash ${NCANDA_BINARY_DIR}/ncanda_structural_all_pipelines ${WORKDIR} ${FREESURFER_LONGITUDINAL_FLAG}
if [ $? -ne 0 ] ; then
  echo "Warning: ncanda_all_pipelines: $WORKDIR skipping rest of pipeline!"  
  exit 1
fi 

bash ${NCANDA_BINARY_DIR}/ncanda_diffusion_pipeline ${WORKDIR}
bash ${NCANDA_BINARY_DIR}/ncanda_restingstate_pipeline ${WORKDIR}
# just to make sure that ncanda_all_visits behaves correctly 
if [ $? -ne 0 ] ; then
  exit 0 
fi 
