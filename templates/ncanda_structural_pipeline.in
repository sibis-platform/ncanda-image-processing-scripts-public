#
# 12 - reformat SRI24 parcellation maps and tissue priors
#

# get t2_brain_exp_mask - removes dark t2 regions from t1_brainmask
t2_brain_exp_mask=${WORKDIR}/structural/reslice/subject_t1/t2_brain_exp_mask.nii.gz
if LWDP_needs_update_and_lock ${t2_brain_exp_mask} ${t2_brain} ${t1_brainmask}; then
  mean=`fsl fslstats ${t2_brain} -k ${t1_brainmask} -m | tr -d " "`
  mean_1=`bc -l <<< 1/${mean}`
  echo "INFO: ${WORKDIR}: t2_brain: mean=${mean}, 1/mean=${mean_1}"
  # thresh 0.8 cuts 20% of the mean
  c3d c3d ${t2_brain} -scale -${mean_1} -exp -thresh 0.8 inf 0 1 -o ${t2_brain_exp_mask}
  LWDP_lockfile_delete ${t2_brain_exp_mask}
fi
export t2_brain_exp_mask=$(LWDP_get_override_file ${t2_brain_exp_mask})
#
t2_affine_brain_exp_mask=${WORKDIR}/structural/reslice/subject_t1/t2_affine_brain_exp_mask.nii.gz
if LWDP_needs_update_and_lock ${t2_affine_brain_exp_mask} ${t2_affine_brain} ${t1_brainmask}; then
  mean=`fsl fslstats ${t2_affine_brain} -k ${t1_brainmask} -m | tr -d " "`
  mean_1=`bc -l <<< 1/${mean}`
  echo "INFO: ${WORKDIR}: t2_affine_brain: mean=${mean}, 1/mean=${mean_1}"
  c3d c3d ${t2_affine_brain} -scale -${mean_1} -exp -thresh 0.8 inf 0 1 -o ${t2_affine_brain_exp_mask}
  LWDP_lockfile_delete ${t2_affine_brain_exp_mask}
fi
export t2_affine_brain_exp_mask=$(LWDP_get_override_file ${t2_affine_brain_exp_mask})

PARCELLATIONS="parc116 wm400 ventricles suptent parc_cortical icv inftent suptent2 postfossa_dmid"

inp[1]=${DATA_DIR}/sri24/parcellation/sri24_parc116.nii.gz
inp[2]=${DATA_DIR}/sri24/parcellation/sri24_wm400.nii.gz
inp[3]=${DATA_DIR}/sri24/parcellation/sri24_ventricles.nii.gz
inp[4]=${DATA_DIR}/sri24/parcellation/sri24_suptent.nii.gz
inp[5]=${DATA_DIR}/sri24/parcellation/sri24_parc_cortical.nii.gz
inp[6]=${DATA_DIR}/sri24/sri24_pbmap_CSF.nii.gz
inp[7]=${DATA_DIR}/sri24/sri24_pbmap_GM.nii.gz
inp[8]=${DATA_DIR}/sri24/sri24_pbmap_WM.nii.gz
inp[9]=${DATA_DIR}/sri24/parcellation/sri24_inftent.nii.gz
inp[10]=${DATA_DIR}/sri24/parcellation/sri24_suptent2.nii.gz
inp[11]=${DATA_DIR}/sri24/parcellation/sri24_postfossa_dmid.nii.gz

out[1]=${WORKDIR}/structural/reslice/subject_t1/sri24/parc116.nii.gz
out[2]=${WORKDIR}/structural/reslice/subject_t1/sri24/wm400.nii.gz
out[3]=${WORKDIR}/structural/reslice/subject_t1/sri24/ventricles.nii.gz
out[4]=${WORKDIR}/structural/reslice/subject_t1/sri24/suptent.nii.gz
out[5]=${WORKDIR}/structural/reslice/subject_t1/sri24/parc_cortical.nii.gz
out[6]=${WORKDIR}/structural/reslice/subject_t1/sri24/pbmap_CSF.nii.gz
out[7]=${WORKDIR}/structural/reslice/subject_t1/sri24/pbmap_GM.nii.gz
out[8]=${WORKDIR}/structural/reslice/subject_t1/sri24/pbmap_WM.nii.gz
out[9]=${WORKDIR}/structural/reslice/subject_t1/sri24/inftent.nii.gz
out[10]=${WORKDIR}/structural/reslice/subject_t1/sri24/suptent2.nii.gz
out[11]=${WORKDIR}/structural/reslice/subject_t1/sri24/postfossa_dmid.nii.gz

for i in 1; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${t1_sri24_mtx} ${t1_brain}; then
    # choose MultiLabel params which preserves boundaries close to NN, but applying some mild smoothness
    ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${inp[${i}]} -r ${t1_brain} -o ${out[${i}]} -t ${t1_sri24_mtx}
    c3d c3d ${out[${i}]} -type short -o ${out[${i}]}
    LWDP_lockfile_delete ${out[${i}]}
  fi
done
for i in 2 3 4 5; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${t1_sri24_mtx} ${t1_brain}; then
    ants antsApplyTransforms -n NearestNeighbor -i ${inp[${i}]} -r ${t1_brain} -o ${out[${i}]} -t ${t1_sri24_mtx}
    c3d c3d ${out[${i}]} -type short -o ${out[${i}]}
    LWDP_lockfile_delete ${out[${i}]}
  fi
done
for i in 6 7 8; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${t1_sri24_mtx}  ${t1_brain} ${t1_brainmask}; then
    ants antsApplyTransforms -n BlackmanWindowedSinc -i ${inp[${i}]} -r ${t1_brain} -o ${out[${i}]} -t ${t1_sri24_mtx}
    c3d c3d ${out[${i}]} ${t1_brainmask} -multiply -clip 0 inf -type float -o ${out[${i}]}
    LWDP_lockfile_delete ${out[${i}]}
  fi
done
for i in 9 10 11; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${t1_sri24_mtx} ${t1_brain} ${t1_brainmask} ${t2_affine_brain_exp_mask}; then
    ants antsApplyTransforms -n NearestNeighbor -i ${inp[${i}]} -r ${t1_brain} -o ${out[${i}]} -t ${t1_sri24_mtx}
    c3d c3d ${out[${i}]} ${t1_brainmask} -multiply ${t2_affine_brain_exp_mask} -multiply -type short -o ${out[${i}]}
    LWDP_lockfile_delete ${out[${i}]}
  fi
done

t1_sri_parc=${out[1]}
t1_sri_wm=${out[2]}
t1_sri_ven=${out[3]}
t1_prior_CSF=${out[6]}
t1_prior_GM=${out[7]}
t1_prior_WM=${out[8]}

# Copy brainmask and pretend it's a parcellation map also - this is for whole-brain (ICV) tissue volumes
icv_mask=${WORKDIR}/structural/reslice/subject_t1/sri24/icv.nii.gz
if LWDP_needs_update_and_lock ${icv_mask} ${t1_brainmask}; then
  cmtk convertx ${t1_brainmask} ${icv_mask}
  LWDP_lockfile_delete ${icv_mask}
fi

#
# 13 - Tissue classification
#

function segment_fast
{
  local in_image_num=${1}
  local in_images=${2}
  local in_prefix=${3}
  local in_prior_CSF=${4}
  local in_prior_GM=${5}
  local in_prior_WM=${6}
  local in_sri_ven=${7}
  local in_sri_parc=${8}
  local in_sri_wm=${9}

  seg=${in_prefix}_seg.nii.gz
  if [ "${in_image_num}" == "1" ]; then
    if LWDP_needs_update_and_lock ${seg} ${in_prior_CSF} ${in_prior_GM} ${in_prior_WM} ${in_images}; then
      fsl fast -A ${in_prior_CSF} ${in_prior_GM} ${in_prior_WM} -a ${FSLDIR}/src/fsl-flirt/flirtsch/ident.mat -P -v -o ${in_prefix} ${in_images} && cmtk convertx --byte ${seg} ${seg}
      # remove again-reformatted priors
      rm ${in_prefix}_*_stdspace.*
      LWDP_lockfile_delete ${seg}
    fi
  else
    echo "ERROR: ${WORKDIR}: Not supported yet"
    return
  fi

  seg_clean=${in_prefix}_seg_clean.nii.gz
  if LWDP_needs_update_and_lock ${seg_clean} ${seg}; then
    ${SLICER_CLI}/IslandRemoval -m 25 ${seg} ${seg_clean} 
    fsl fslcpgeom ${seg} ${seg_clean}
    LWDP_lockfile_delete ${seg_clean}
  fi
  
  ven_parc=${in_prefix}_ven_parc.nii.gz
  if LWDP_needs_update_and_lock ${ven_parc} ${seg_clean} ${in_sri_ven}; then
    fsl fslmaths ${seg_clean} -thr 1 -uthr 1 -bin -mul ${in_sri_ven} ${ven_parc}
    LWDP_lockfile_delete ${ven_parc}
  fi 
  gm_parc=${in_prefix}_gm_parc.nii.gz
  if LWDP_needs_update_and_lock ${gm_parc} ${seg_clean} ${in_sri_parc}; then
    fsl fslmaths ${seg_clean} -thr 2 -uthr 2 -bin -mul ${in_sri_parc} ${gm_parc}
    LWDP_lockfile_delete ${gm_parc}
  fi 
  wm_parc=${in_prefix}_wm_parc.nii.gz
  if LWDP_needs_update_and_lock ${wm_parc} ${seg_clean} ${in_sri_wm}; then
    fsl fslmaths ${seg_clean} -thr 3 -uthr 3 -bin -mul ${in_sri_wm} ${wm_parc}
    LWDP_lockfile_delete ${wm_parc}
  fi
}

function segment_atropos
{
  local in_image_num=${1}
  local in_images=${2}
  local in_mask=${3}
  local in_prefix=${4}
  local in_prior_CSF=${5}
  local in_prior_GM=${6}
  local in_prior_WM=${7}
  local in_sri_ven=${8}
  local in_sri_parc=${9}
  local in_sri_wm=${10}

  seg=${in_prefix}_seg.nii.gz
  if [ "${in_image_num}" == "1" ] || [ "${in_image_num}" == "2" ]; then
    if LWDP_needs_update_and_lock ${seg} ${in_prior_CSF} ${in_prior_GM} ${in_prior_WM} ${in_images}; then
      tmpdir=$(mktemp -d)

      idx=1
      for FILE in ${in_prior_CSF} ${in_prior_GM} ${in_prior_WM}; do 
	  cp ${FILE} ${tmpdir}/pbmap_${idx}.nii.gz
	  # if tmp dir does not have enough space - this will give you an error 
	  if [ "`diff ${FILE} ${tmpdir}/pbmap_${idx}.nii.gz 2>&1`" != "" ]; then
	      echo "ERROR:$WORKDIR:Problem with copying data to tmpdir !"
	      rm -rf ${tmpdir}
	      LWDP_lockfile_delete ${seg}
	      exit 1 
	  fi
	  let idx++ 
      done
	
    
      CMD="ants Atropos -d 3 -x ${in_mask} -c [5,0.0] -a ${in_images} -i PriorProbabilityImages[3,${tmpdir}/pbmap_%d.nii.gz,0.0] -k HistogramParzenWindows -m [0.05,1x1x1] -o [${seg},${in_prefix}_posteriors_%d.nii.gz] -r 0 -p Socrates[1] --use-partial-volume-likelihoods 1 -s 1x2 -s 2x3"
      $CMD 
    
      rm -rf ${tmpdir}
      LWDP_lockfile_delete ${seg}
    fi
  else
    echo "ERROR: ${WORKDIR}: Not supported yet"
    return
  fi

  seg_clean=${in_prefix}_seg_clean.nii.gz
  if LWDP_needs_update_and_lock ${seg_clean} ${seg}; then
    ${SLICER_CLI}/IslandRemoval -m 25 ${seg} ${seg_clean} 
    fsl fslcpgeom ${seg} ${seg_clean}
    LWDP_lockfile_delete ${seg_clean}
  fi
  
  ven_parc=${in_prefix}_ven_parc.nii.gz
  if LWDP_needs_update_and_lock ${ven_parc} ${seg_clean} ${in_sri_ven}; then
    fsl fslmaths ${seg_clean} -thr 1 -uthr 1 -bin -mul ${in_sri_ven} ${ven_parc}
    LWDP_lockfile_delete ${ven_parc}
  fi 
  gm_parc=${in_prefix}_gm_parc.nii.gz
  if LWDP_needs_update_and_lock ${gm_parc} ${seg_clean} ${in_sri_parc}; then
    fsl fslmaths ${seg_clean} -thr 2 -uthr 2 -bin -mul ${in_sri_parc} ${gm_parc}
    LWDP_lockfile_delete ${gm_parc}
  fi 
  wm_parc=${in_prefix}_wm_parc.nii.gz
  if LWDP_needs_update_and_lock ${wm_parc} ${seg_clean} ${in_sri_wm}; then
    fsl fslmaths ${seg_clean} -thr 3 -uthr 3 -bin -mul ${in_sri_wm} ${wm_parc}
    LWDP_lockfile_delete ${wm_parc}
  fi
}

# classification using fast with t1
[ -d ${WORKDIR}/structural/segment/subject_t1/fast ] || mkdir -p ${WORKDIR}/structural/segment/subject_t1/fast
t1_seg_pfx=${WORKDIR}/structural/segment/subject_t1/fast/t1
t1_seg=${t1_seg_pfx}_seg.nii.gz
segment_fast 1 "${t1_brain}" ${t1_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}

# classification using atropos with t1
[ -d ${WORKDIR}/structural/segment/subject_t1/atropos ] || mkdir -p ${WORKDIR}/structural/segment/subject_t1/atropos
t1_seg_pfx=${WORKDIR}/structural/segment/subject_t1/atropos/t1
t1_seg=${t1_seg_pfx}_seg.nii.gz
segment_atropos 1 "${t1_brain}" ${t1_brainmask} ${t1_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}

## classification using atropos with t1 and t2
#[ -d ${WORKDIR}/structural/segment/subject_t1/atropos_t1t2 ] || mkdir -p ${WORKDIR}/structural/segment/subject_t1/atropos_t1t2
#t1t2_seg_pfx=${WORKDIR}/structural/segment/subject_t1/atropos_t1t2/t1t2
#t1t2_seg=${t1t2_seg_pfx}_seg.nii.gz
##segment_atropos 2 "${t1_brain} ${t2_brain}" ${t1_brainmask} ${t1t2_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}
#segment_atropos 2 "${t1_brain} ${t2_affine_brain}" ${t1_brainmask} ${t1t2_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}

#
# 14 - compute distortion-correcting Jacobian map from ADNI phantom description
#

if [ "${phantom_xml_input}" != "" ]; then
  phantom_unwarp=${WORKDIR}/structural/phantom/unwarp.xform
  if LWDP_needs_update_and_lock ${phantom_unwarp} ${phantom_xml_input} ${t1_input}; then
    cmtk unwarp_image_phantom --poly --degree 4 ${phantom_xml_input} ${t1_input} ${phantom_unwarp}
    LWDP_lockfile_delete ${phantom_unwarp}
  fi
  
  phantom_unwarp_inverse=${WORKDIR}/structural/phantom/unwarp_inverse.xform
  if LWDP_needs_update_and_lock ${phantom_unwarp_inverse} ${phantom_xml_input}  ${t1_input}; then
    cmtk unwarp_image_phantom --poly --degree 4 --fit-inverse ${phantom_xml_input} ${t1_input} ${phantom_unwarp_inverse}
    LWDP_lockfile_delete ${phantom_unwarp_inverse}
  fi
  
  phantom_jacobian=${WORKDIR}/structural/phantom/jacobian.nii
  if LWDP_needs_update_and_lock ${phantom_jacobian} ${phantom_unwarp_inverse}  ${t1_input}; then
    cmtk reformatx -o ${phantom_jacobian} ${t1_input} --jacobian ${phantom_unwarp_inverse}
    LWDP_lockfile_delete ${phantom_jacobian}
  fi

  phantom_scale=$(fgrep \<scale\> ${phantom_xml_input} | sed 's/^.*<scale>//g; s/<\/scale>.*$//g' | gawk '{ print 1.0 / ( $1 * $2 * $3 ) }')
fi

#
# 15 - generate CSV tissue files
#

# Function to bring the tabular CSV into row form, so we can concat and/or merge
tab_to_csv()
{
  local tabfile=$1
  local csvfile=$2
  local visit=$3

  if LWDP_needs_update_and_lock ${csvfile} ${tabfile}; then
    ${NCANDA_SOURCE_DIR}/utils/serialize_csv --lowercase-labels --label-prefix sri24_${parc}_ --insert-key-value subject:${SUBJECT},arm:${ARM},visit:${visit} ${tabfile} ${csvfile}
    LWDP_lockfile_delete ${csvfile}
  fi
}

for i in 1 2 4; do
  if [ "${i}" == "1" ]; then
    # posteriors from fast
    tab_folder=${WORKDIR}/structural/volumetry/subject_t1/sri24/fast
    posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/fast/t1_pve_0.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/fast/t1_pve_1.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/fast/t1_pve_2.nii.gz)"
  elif [ "${i}" == "2" ]; then
    # posteriors from atropos t1
    tab_folder=${WORKDIR}/structural/volumetry/subject_t1/sri24/atropos
    posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/atropos/t1_posteriors_1.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/atropos/t1_posteriors_2.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/atropos/t1_posteriors_3.nii.gz)"
  elif [ "${i}" == "3" ]; then
    # posteriors from atropos t1+t2
    tab_folder=${WORKDIR}/structural/volumetry/subject_t1/sri24/atropos_t1t2
    posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/atropos_t1t2/t1t2_posteriors_1.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/atropos_t1t2/t1t2_posteriors_2.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/atropos_t1t2/t1t2_posteriors_3.nii.gz)"
  elif [ "${i}" == "4" ]; then
    # atropos t1 hard segmentation
    tab_folder=${WORKDIR}/structural/volumetry/subject_t1/sri24/atropos_hs
    t1_seg=${WORKDIR}/structural/segment/subject_t1/atropos/t1_seg.nii.gz
    t1_seg_1=${WORKDIR}/structural/segment/subject_t1/atropos/t1_seg_1.nii.gz
    t1_seg_2=${WORKDIR}/structural/segment/subject_t1/atropos/t1_seg_2.nii.gz
    t1_seg_3=${WORKDIR}/structural/segment/subject_t1/atropos/t1_seg_3.nii.gz
    if LWDP_needs_update_and_lock ${t1_seg_1} ${t1_seg}; then
      c3d c3d ${t1_seg} -replace 0 0 1 1 2 0 3 0 -o ${t1_seg_1}
      c3d c3d ${t1_seg} -replace 0 0 1 0 2 1 3 0 -o ${t1_seg_2}
      c3d c3d ${t1_seg} -replace 0 0 1 0 2 0 3 1 -o ${t1_seg_3}
      LWDP_lockfile_delete ${t1_seg_1}
    fi
    posteriors="${t1_seg_1} ${t1_seg_2} ${t1_seg_3}"
  fi
  
  # For each parcellation, compute tissue volume tables
  for parc in ${PARCELLATIONS}; do
    label_image=$(LWDP_get_override_file ${WORKDIR}/structural/reslice/subject_t1/sri24/${parc}.nii.gz)
    label_txt=${DATA_DIR}/sri24/parcellation/sri24_${parc}.txt
  
    # First, without "unwarping" correction
    tabout=${tab_folder}/${parc}.tab
    if LWDP_needs_update_and_lock ${tabout} ${label_image} ${posteriors} ${label_txt}; then
      cmtk vol2csv --density-labels CSF,GM,WM -o ${tabout} --labels-file ${label_txt} ${label_image} ${posteriors}
      LWDP_lockfile_delete ${tabout}
    fi
    csvout=${tab_folder}/${parc}.csv
    tab_to_csv ${tabout} ${csvout} ${VISIT}
  
    if [ -n "${phantom_xml_input}" ]; then
      # Second, global scale from ADNI phantom scan to adjust volumes globally
      tabout=${tab_folder}/${parc}_scale.tab
      if LWDP_needs_update_and_lock ${tabout} ${label_image} ${posteriors} ${label_txt}; then
        cmtk vol2csv --density-labels CSF,GM,WM -o ${tabout} --pixel-scale-factor ${phantom_scale} --labels-file ${label_txt} ${label_image} ${posteriors}
        LWDP_lockfile_delete ${tabout}
      fi
      csvout=${tab_folder}/${parc}_scale.csv
      tab_to_csv ${tabout} ${csvout} ${VISIT}
  
      # Third, using Jacobian map from phantom-based unwarping to correct for differences in local pixel volumes
      tabout=${tab_folder}/${parc}_unwarp.tab
      if LWDP_needs_update_and_lock ${tabout} ${label_image} ${posteriors} ${phantom_jacobian} ${label_txt}; then
        cmtk vol2csv --density-labels CSF,GM,WM -o ${tabout} --pixel-scale-image ${phantom_jacobian} --labels-file ${label_txt} ${label_image} ${posteriors}
        LWDP_lockfile_delete ${tabout}
      fi
      csvout=${tab_folder}/${parc}_unwarp.csv
      tab_to_csv ${tabout} ${csvout} ${VISIT}
    fi
  done
done

#
# XX - Resample baseline to padded sri24 space and move followup to resampled baseline space
#

if [ "${VISIT}" == "baseline" ]; then
  [ -d ${WORKDIR}/structural/reslice/sri24_padded ] || mkdir -p ${WORKDIR}/structural/reslice/sri24_padded

  sri24_t1_padded=${WORKDIR}/structural/reslice/sri24_padded/sri24_t1_padded.nii.gz
  if LWDP_needs_update_and_lock ${sri24_t1_padded} ${sri24_t1}; then
    c3d c3d ${sri24_t1} -pad 0x0x45vox 0x0x40vox -o ${sri24_t1_padded}
    LWDP_lockfile_delete ${sri24_t1_padded}
  fi

  [ -d ${WORKDIR}/structural/registration/sri24_padded_to_t1 ] || mkdir -p ${WORKDIR}/structural/registration/sri24_padded_to_t1

  sri24_padded_to_t1_rigid_pfx=${WORKDIR}/structural/registration/sri24_padded_to_t1/ants_rigid_
  sri24_padded_to_t1_rigid=${sri24_padded_to_t1_rigid_pfx}0GenericAffine.mat
  if LWDP_needs_update_and_lock ${sri24_padded_to_t1_rigid} ${sri24_t1_padded} ${t1_brain}; then
    log_out=${sri24_padded_to_t1_rigid_pfx}0GenericAffine.log
    ants antsRegistration -d 3 -r [${sri24_t1_padded},${t1_brain},0] -t Rigid[0.1] -m MI[${sri24_t1_padded},${t1_brain},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${sri24_padded_to_t1_rigid_pfx} > ${log_out}
    LWDP_lockfile_delete ${sri24_padded_to_t1_rigid}
  fi
  sri24_padded_to_t1_rigid=$(LWDP_get_override_file ${sri24_padded_to_t1_rigid})

  inp[1]=${t1_brainmask}
  inp[2]=${t1_mrbias}
  inp[3]=${t2_mrbias}
  inp[4]=${t2_affine_mrbias}

  out[1]=${WORKDIR}/structural/reslice/sri24_padded/t1_brain_mask.nii.gz
  out[2]=${WORKDIR}/structural/reslice/sri24_padded/t1.nii.gz
  out[3]=${WORKDIR}/structural/reslice/sri24_padded/t2.nii.gz
  out[4]=${WORKDIR}/structural/reslice/sri24_padded/t2_affine.nii.gz

  inp[5]=${out[2]}
  inp[6]=${out[3]}
  inp[7]=${out[4]}

  out[5]=${WORKDIR}/structural/reslice/sri24_padded/t1_brain.nii.gz
  out[6]=${WORKDIR}/structural/reslice/sri24_padded/t2_brain.nii.gz
  out[7]=${WORKDIR}/structural/reslice/sri24_padded/t2_affine_brain.nii.gz

  sri24_padded_t1_brainmask=${out[1]}
  sri24_padded_t1=${out[2]}
  sri24_padded_t2=${out[3]}
  sri24_padded_t2_affine=${out[4]}
  sri24_padded_t1_brain=${out[5]}
  sri24_padded_t2_brain=${out[6]}
  sri24_padded_t2_affine_brain=${out[7]}

  for i in 1; do
    if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${sri24_t1_padded} ${sri24_padded_to_t1_rigid}; then
      ants antsApplyTransforms -n NearestNeighbor -i ${inp[${i}]} -r ${sri24_t1_padded} -o ${out[${i}]} -t ${sri24_padded_to_t1_rigid}
      c3d c3d ${out[${i}]} -type uchar -o ${out[${i}]}
      LWDP_lockfile_delete ${out[${i}]}
    fi
  done
  for i in 2 3 4; do
    if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${sri24_t1_padded} ${sri24_padded_to_t1_rigid}; then
      ants antsApplyTransforms -n BlackmanWindowedSinc -i ${inp[${i}]} -r ${sri24_t1_padded} -o ${out[${i}]} -t ${sri24_padded_to_t1_rigid}
      c3d c3d ${out[${i}]} -clip 0 inf -type float -o ${out[${i}]}
      LWDP_lockfile_delete ${out[${i}]}
    fi
  done
  for i in 5 6 7; do
    if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${sri24_padded_t1_brainmask}; then
      c3d c3d ${inp[${i}]} ${sri24_padded_t1_brainmask} -multiply -o ${out[${i}]}
      LWDP_lockfile_delete ${out[${i}]}
    fi
  done

  ## generate affinely registratered t2
  #sri24_padded_t1_to_t2_pfx=${WORKDIR}/structural/registration/sri24_padded_t1_to_t2/ants_
  #sri24_padded_t1_to_t2_affine=${sri24_padded_t1_to_t2_pfx}0GenericAffine.mat
  #if LWDP_needs_update_and_lock ${sri24_padded_t1_to_t2_affine} ${sri24_padded_t1_brain} ${t2_affine_brain}; then
  #  log_out=${sri24_padded_t1_to_t2_pfx}0GenericAffine.log
  #  ants antsRegistration -d 3 -r [${sri24_padded_t1_brain},${t2_affine_brain},0] -t Rigid[0.1] -m MI[${sri24_padded_t1_brain},${t2_affine_brain},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${sri24_padded_t1_brain},${t2_affine_brain},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${sri24_padded_t1_to_t2_pfx} > ${log_out}
  #  LWDP_lockfile_delete ${sri24_padded_t1_to_t2_affine}
  #fi
  #sri24_padded_t1_to_t2_affine=$(LWDP_get_override_file ${sri24_padded_t1_to_t2_affine})

  #sri24_padded_t2_affine=${WORKDIR}/structural/reslice/sri24_padded/t2_affine.nii.gz
  #if LWDP_needs_update_and_lock ${sri24_padded_t2_affine} ${t2_affine_denoised} ${sri24_padded_t1} ${sri24_padded_t1_brainmask} ${sri24_padded_t1_to_t2_affine}; then
  #  tmpdir=$(mktemp -d)
  #  ants antsApplyTransforms -n BlackmanWindowedSinc -i ${t2_affine_denoised} -r ${sri24_padded_t1} -o ${tmpdir}/t2.nii.gz -t ${sri24_padded_t1_to_t2_affine}
  #  c3d c3d ${tmpdir}/t2.nii.gz -clip 0 inf -type float -o ${tmpdir}/t2.nii.gz
  #  ants N4BiasFieldCorrection -i ${tmpdir}/t2.nii.gz -x ${sri24_padded_t1_brainmask} -o ${sri24_padded_t2_affine}
  #  rm -rf ${tmpdir}
  #  LWDP_lockfile_delete ${sri24_padded_t2_affine}
  #fi

  #sri24_padded_t2_affine_brain=${WORKDIR}/structural/reslice/sri24_padded/t2_affine_brain.nii.gz
  #if LWDP_needs_update_and_lock ${sri24_padded_t2_affine_brain} ${sri24_padded_t2_affine} ${sri24_padded_t1_brainmask}; then
  #  c3d c3d ${sri24_padded_t2_affine} ${sri24_padded_t1_brainmask} -multiply -o ${sri24_padded_t2_affine_brain}
  #  LWDP_lockfile_delete ${sri24_padded_t2_affine_brain}
  #fi
else
  [ -d ${WORKDIR}/structural/longitudinal/registration/baseline_sri24_padded_to_t1 ] || mkdir -p ${WORKDIR}/structural/longitudinal/registration/baseline_sri24_padded_to_t1

  t1_brain_at_baseline_sri24_padded=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/t1_brain.nii.gz)

  baseline_sri24_padded_to_t1_rigid_pfx=${WORKDIR}/structural/longitudinal/registration/baseline_sri24_padded_to_t1/ants_rigid_
  baseline_sri24_padded_to_t1_rigid=${baseline_sri24_padded_to_t1_rigid_pfx}0GenericAffine.mat
  if LWDP_needs_update_and_lock ${baseline_sri24_padded_to_t1_rigid} ${t1_brain} ${t1_brain_at_baseline_sri24_padded}; then
    log_out=${baseline_sri24_padded_to_t1_rigid_pfx}0GenericAffine.log
    ants antsRegistration -d 3 -r [${t1_brain_at_baseline_sri24_padded},${t1_brain},1] -t Rigid[0.1] -m MI[${t1_brain_at_baseline_sri24_padded},${t1_brain},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${baseline_sri24_padded_to_t1_rigid_pfx} > ${log_out}
    LWDP_lockfile_delete ${baseline_sri24_padded_to_t1_rigid}
  fi
  baseline_sri24_padded_to_t1_rigid=$(LWDP_get_override_file ${baseline_sri24_padded_to_t1_rigid})

  # transfer baseline images to this visit for verification
  [ -d ${WORKDIR}/structural/reslice/sri24_padded ] || mkdir -p ${WORKDIR}/structural/reslice/sri24_padded

  #inp[1]=${t1_brainmask}
  inp[1]=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/stripped/t1_brain_mask.nii.gz)
  inp[2]=${t1_mrbias}
  inp[3]=${t2_mrbias}
  inp[4]=${t2_affine_mrbias}

  out[1]=${WORKDIR}/structural/reslice/sri24_padded/t1_brain_mask.nii.gz
  out[2]=${WORKDIR}/structural/reslice/sri24_padded/t1.nii.gz
  out[3]=${WORKDIR}/structural/reslice/sri24_padded/t2.nii.gz
  out[4]=${WORKDIR}/structural/reslice/sri24_padded/t2_affine.nii.gz

  inp[5]=${out[2]}
  inp[6]=${out[3]}
  inp[7]=${out[4]}

  out[5]=${WORKDIR}/structural/reslice/sri24_padded/t1_brain.nii.gz
  out[6]=${WORKDIR}/structural/reslice/sri24_padded/t2_brain.nii.gz
  out[7]=${WORKDIR}/structural/reslice/sri24_padded/t2_affine_brain.nii.gz

  sri24_padded_t1_brainmask=${out[1]}
  sri24_padded_t1=${out[2]}
  sri24_padded_t2=${out[3]}
  sri24_padded_t2_affine=${out[4]}
  sri24_padded_t1_brain=${out[5]}
  sri24_padded_t2_brain=${out[6]}
  sri24_padded_t2_affine_brain=${out[7]}

  # mask: baseline_sri24_padded -> t1 -> baseline
  for i in 1; do
    #if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${t1_brain_at_baseline_sri24_padded} ${baseline_sri24_padded_to_t1_rigid}; then
    #  ants antsApplyTransforms -n NearestNeighbor -i ${inp[${i}]} -r ${t1_brain_at_baseline_sri24_padded} -o ${out[${i}]} -t ${baseline_sri24_padded_to_t1_rigid}
    #  c3d c3d ${out[${i}]} -type uchar -o ${out[${i}]}
    #  LWDP_lockfile_delete ${out[${i}]}
    #fi
    if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${t1_brain_at_baseline_sri24_padded} ${baseline_sri24_padded_to_t1_rigid} ${baseline_to_t1_affine} ${t1_to_baseline_warp}; then
      ants antsApplyTransforms -n NearestNeighbor -i ${inp[${i}]} -r ${t1_brain_at_baseline_sri24_padded} -o ${out[${i}]} -t ${baseline_sri24_padded_to_t1_rigid} [${baseline_to_t1_affine},1] ${t1_to_baseline_warp}
      c3d c3d ${out[${i}]} -type uchar -o ${out[${i}]}
      LWDP_lockfile_delete ${out[${i}]}
    fi
  done
  for i in 2 3 4; do
    if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${t1_brain_at_baseline_sri24_padded} ${baseline_sri24_padded_to_t1_rigid}; then
      ants antsApplyTransforms -n BlackmanWindowedSinc -i ${inp[${i}]} -r ${t1_brain_at_baseline_sri24_padded} -o ${out[${i}]} -t ${baseline_sri24_padded_to_t1_rigid}
      c3d c3d ${out[${i}]} -clip 0 inf -type float -o ${out[${i}]}
      LWDP_lockfile_delete ${out[${i}]}
    fi
  done
  for i in 5 6 7; do
    if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${sri24_padded_t1_brainmask}; then
      c3d c3d ${inp[${i}]} ${sri24_padded_t1_brainmask} -multiply -o ${out[${i}]}
      LWDP_lockfile_delete ${out[${i}]}
    fi
  done

  ## generate affinely registratered t2
  #t2_affine_brain_at_baseline_sri24_padded=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/t2_affine_brain.nii.gz)

  #baseline_sri24_padded_t2_to_t2_pfx=${WORKDIR}/structural/longitudinal/registration/baseline_sri24_padded_t2_to_t2/ants_
  #baseline_sri24_padded_t2_to_t2_affine=${baseline_sri24_padded_t2_to_t2_pfx}0GenericAffine.mat
  #if LWDP_needs_update_and_lock ${baseline_sri24_padded_t2_to_t2_affine} ${t2_affine_brain_at_baseline_sri24_padded} ${t2_affine_brain}; then
  #  log_out=${baseline_sri24_padded_t2_to_t2_pfx}0GenericAffine.log
  #  ants antsRegistration -d 3 -r [${t2_affine_brain_at_baseline_sri24_padded},${t2_affine_brain},1] -t Rigid[0.1] -m MI[${t2_affine_brain_at_baseline_sri24_padded},${t2_affine_brain},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${t2_affine_brain_at_baseline_sri24_padded},${t2_affine_brain},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${baseline_sri24_padded_t2_to_t2_pfx} > ${log_out}
  #  LWDP_lockfile_delete ${baseline_sri24_padded_t2_to_t2_affine}
  #fi
  #baseline_sri24_padded_t2_to_t2_affine=$(LWDP_get_override_file ${baseline_sri24_padded_t2_to_t2_affine})

  #sri24_padded_t2_affine=${WORKDIR}/structural/reslice/sri24_padded/t2_affine.nii.gz
  #if LWDP_needs_update_and_lock ${sri24_padded_t2_affine} ${t2_affine_denoised} ${t2_affine_brain_at_baseline_sri24_padded} ${sri24_padded_t1_brainmask} ${baseline_sri24_padded_t2_to_t2_affine}; then
  #  tmpdir=$(mktemp -d)
  #  ants antsApplyTransforms -n BlackmanWindowedSinc -i ${t2_affine_denoised} -r ${t2_affine_brain_at_baseline_sri24_padded} -o ${tmpdir}/t2.nii.gz -t ${baseline_sri24_padded_t2_to_t2_affine}
  #  c3d c3d ${tmpdir}/t2.nii.gz -clip 0 inf -type float -o ${tmpdir}/t2.nii.gz
  #  ants N4BiasFieldCorrection -i ${tmpdir}/t2.nii.gz -x ${sri24_padded_t1_brainmask} -o ${sri24_padded_t2_affine}
  #  rm -rf ${tmpdir}
  #  LWDP_lockfile_delete ${sri24_padded_t2_affine}
  #fi

  #sri24_padded_t2_affine_brain=${WORKDIR}/structural/reslice/sri24_padded/t2_affine_brain.nii.gz
  #if LWDP_needs_update_and_lock ${sri24_padded_t2_affine_brain} ${sri24_padded_t2_affine} ${sri24_padded_t1_brainmask}; then
  #  c3d c3d ${sri24_padded_t2_affine} ${sri24_padded_t1_brainmask} -multiply -o ${sri24_padded_t2_affine_brain}
  #  LWDP_lockfile_delete ${sri24_padded_t2_affine_brain}
  #fi

  # match intensity toward baseline
  [ -d ${WORKDIR}/structural/reslice/sri24_padded/corrected ] || mkdir -p ${WORKDIR}/structural/reslice/sri24_padded/corrected

  for tx in t1 t2 t2_affine; do
    tx_brain_reference=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/${tx}_brain.nii.gz)
    tx_brain=${WORKDIR}/structural/reslice/sri24_padded/${tx}_brain.nii.gz
    tx_brainmask=${WORKDIR}/structural/reslice/sri24_padded/t1_brain_mask.nii.gz
    tx_brain_scale=${WORKDIR}/structural/reslice/sri24_padded/corrected/${tx}_brain_scale.nii.gz
    tx_brain_corrected=${WORKDIR}/structural/reslice/sri24_padded/corrected/${tx}_brain.nii.gz
    smooth_width=3
  
    if LWDP_needs_update_and_lock ${tx_brain_corrected} ${tx_brain_reference} ${tx_brain} ${tx_brainmask}; then
      tmpdir=$(mktemp -d)
      c3d c3d ${tx_brain_reference} -smooth ${smooth_width}mm -o ${tmpdir}/ref.nii.gz
      c3d c3d ${tx_brain} -smooth ${smooth_width}mm -o ${tmpdir}/img.nii.gz
      # need caution if use c3d: c3d A B -divide -o C computes C = B / A, not C = A / B
      fsl fslmaths ${tmpdir}/ref.nii.gz -div ${tmpdir}/img.nii.gz -mul ${tx_brainmask} ${tx_brain_scale}
      c3d c3d ${tx_brain} ${tx_brain_scale} -multiply -o ${tx_brain_corrected}
      rm -rf ${tmpdir}
      LWDP_lockfile_delete ${tx_brain_corrected}
    fi
  done

  sri24_padded_t1_brain=${WORKDIR}/structural/reslice/sri24_padded/corrected/t1_brain.nii.gz
  sri24_padded_t2_brain=${WORKDIR}/structural/reslice/sri24_padded/corrected/t2_brain.nii.gz
  sri24_padded_t2_affine_brain=${WORKDIR}/structural/reslice/sri24_padded/corrected/t2_affine_brain.nii.gz
fi

#
# XX - reformat SRI24 parcellation maps and tissue priors to padded sri24 space
#

# get sri24_padded_t2_brain_exp_mask - removes dark t2 regions from t1_brainmask
sri24_padded_t2_brain_exp_mask=${WORKDIR}/structural/reslice/sri24_padded/t2_brain_exp_mask.nii.gz
if LWDP_needs_update_and_lock ${sri24_padded_t2_brain_exp_mask} ${sri24_padded_t2_brain} ${sri24_padded_t1_brainmask}; then
  mean=`fsl fslstats ${sri24_padded_t2_brain} -k ${sri24_padded_t1_brainmask} -m | tr -d " "`
  mean_1=`bc -l <<< 1/${mean}`
  echo ${WORKDIR} sri24_padded_t2_brain: mean=${mean}, 1/mean=${mean_1}
  # thresh 0.8 cuts 20% of the mean
  c3d c3d ${sri24_padded_t2_brain} -scale -${mean_1} -exp -thresh 0.8 inf 0 1 -o ${sri24_padded_t2_brain_exp_mask}
  LWDP_lockfile_delete ${sri24_padded_t2_brain_exp_mask}
fi
export sri24_padded_t2_brain_exp_mask=$(LWDP_get_override_file ${sri24_padded_t2_brain_exp_mask})
#
sri24_padded_t2_affine_brain_exp_mask=${WORKDIR}/structural/reslice/sri24_padded/t2_affine_brain_exp_mask.nii.gz
if LWDP_needs_update_and_lock ${sri24_padded_t2_affine_brain_exp_mask} ${sri24_padded_t2_affine_brain} ${sri24_padded_t1_brainmask}; then
  mean=`fsl fslstats ${sri24_padded_t2_affine_brain} -k ${sri24_padded_t1_brainmask} -m | tr -d " "`
  mean_1=`bc -l <<< 1/${mean}`
  echo "INFO: ${WORKDIR}: sri24_padded_t2_affine_brain: mean=${mean}, 1/mean=${mean_1}"
  c3d c3d ${sri24_padded_t2_affine_brain} -scale -${mean_1} -exp -thresh 0.8 inf 0 1 -o ${sri24_padded_t2_affine_brain_exp_mask}
  LWDP_lockfile_delete ${sri24_padded_t2_affine_brain_exp_mask}
fi
export sri24_padded_t2_affine_brain_exp_mask=$(LWDP_get_override_file ${sri24_padded_t2_affine_brain_exp_mask})

# get refined t1_brain image using t2 mask
if [ "${VISIT}" == "baseline" ]; then
  sri24_padded_t1_brain_t2_masked=${WORKDIR}/structural/reslice/sri24_padded/t1_brain_t2_masked.nii.gz
else
  sri24_padded_t1_brain_t2_masked=${WORKDIR}/structural/reslice/sri24_padded/corrected/t1_brain_t2_masked.nii.gz
fi
if LWDP_needs_update_and_lock ${sri24_padded_t1_brain_t2_masked} ${sri24_padded_t1_brain} ${sri24_padded_t2_affine_brain_exp_mask}; then
  # remove non-csf region using t2 exp mask
  c3d c3d ${sri24_padded_t1_brain} ${sri24_padded_t2_affine_brain_exp_mask} -multiply -o ${sri24_padded_t1_brain_t2_masked}
  LWDP_lockfile_delete ${sri24_padded_t1_brain_t2_masked}
fi

if [ "${VISIT}" == "baseline" ]; then
  sri24_padded_sri24_mtx="${sri24_padded_to_t1_rigid} ${t1_sri24_mtx}"
else
  sri24_padded_sri24_mtx="${baseline_sri24_padded_to_t1_rigid} ${t1_sri24_mtx}"
fi

inp[1]=${DATA_DIR}/sri24/parcellation/sri24_parc116.nii.gz
inp[2]=${DATA_DIR}/sri24/parcellation/sri24_wm400.nii.gz
inp[3]=${DATA_DIR}/sri24/parcellation/sri24_ventricles.nii.gz
inp[4]=${DATA_DIR}/sri24/parcellation/sri24_suptent.nii.gz
inp[5]=${DATA_DIR}/sri24/parcellation/sri24_parc_cortical.nii.gz
inp[6]=${DATA_DIR}/sri24/sri24_pbmap_CSF.nii.gz
inp[7]=${DATA_DIR}/sri24/sri24_pbmap_GM.nii.gz
inp[8]=${DATA_DIR}/sri24/sri24_pbmap_WM.nii.gz
inp[9]=${DATA_DIR}/sri24/parcellation/sri24_inftent.nii.gz
inp[10]=${DATA_DIR}/sri24/parcellation/sri24_suptent2.nii.gz
inp[11]=${DATA_DIR}/sri24/parcellation/sri24_postfossa_dmid.nii.gz

out[1]=${WORKDIR}/structural/reslice/sri24_padded/parc116.nii.gz
out[2]=${WORKDIR}/structural/reslice/sri24_padded/wm400.nii.gz
out[3]=${WORKDIR}/structural/reslice/sri24_padded/ventricles.nii.gz
out[4]=${WORKDIR}/structural/reslice/sri24_padded/suptent.nii.gz
out[5]=${WORKDIR}/structural/reslice/sri24_padded/parc_cortical.nii.gz
out[6]=${WORKDIR}/structural/reslice/sri24_padded/pbmap_CSF.nii.gz
out[7]=${WORKDIR}/structural/reslice/sri24_padded/pbmap_GM.nii.gz
out[8]=${WORKDIR}/structural/reslice/sri24_padded/pbmap_WM.nii.gz
out[9]=${WORKDIR}/structural/reslice/sri24_padded/inftent.nii.gz
out[10]=${WORKDIR}/structural/reslice/sri24_padded/suptent2.nii.gz
out[11]=${WORKDIR}/structural/reslice/sri24_padded/postfossa_dmid.nii.gz

for i in 1; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${sri24_padded_sri24_mtx} ${sri24_padded_t1_brain}; then
    # choose MultiLabel params which preserves boundaries close to NN, but applying some mild smoothness
    ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${inp[${i}]} -r ${sri24_padded_t1_brain} -o ${out[${i}]} -t ${sri24_padded_sri24_mtx}
    c3d c3d ${out[${i}]} -type short -o ${out[${i}]}
    LWDP_lockfile_delete ${out[${i}]}
  fi
done
for i in 2 3 4 5; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${sri24_padded_sri24_mtx} ${sri24_padded_t1_brain}; then
    ants antsApplyTransforms -n NearestNeighbor -i ${inp[${i}]} -r ${sri24_padded_t1_brain} -o ${out[${i}]} -t ${sri24_padded_sri24_mtx}
    c3d c3d ${out[${i}]} -type short -o ${out[${i}]}
    LWDP_lockfile_delete ${out[${i}]}
  fi
done
for i in 6 7 8; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${sri24_padded_sri24_mtx}  ${sri24_padded_t1_brain} ${sri24_padded_t1_brainmask}; then
    ants antsApplyTransforms -n BlackmanWindowedSinc -i ${inp[${i}]} -r ${sri24_padded_t1_brain} -o ${out[${i}]} -t ${sri24_padded_sri24_mtx}
    c3d c3d ${out[${i}]} ${sri24_padded_t1_brainmask} -multiply -clip 0 inf -type float -o ${out[${i}]}
    LWDP_lockfile_delete ${out[${i}]}
  fi
done
for i in 9 10 11; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${sri24_padded_sri24_mtx} ${sri24_padded_t1_brain} ${sri24_padded_t1_brainmask} ${sri24_padded_t2_affine_brain_exp_mask}; then
    ants antsApplyTransforms -n NearestNeighbor -i ${inp[${i}]} -r ${sri24_padded_t1_brain} -o ${out[${i}]} -t ${sri24_padded_sri24_mtx}
    c3d c3d ${out[${i}]} ${sri24_padded_t1_brainmask} -multiply ${sri24_padded_t2_affine_brain_exp_mask} -multiply -type short -o ${out[${i}]}
    LWDP_lockfile_delete ${out[${i}]}
  fi
done

t1_sri_parc=${out[1]}
t1_sri_wm=${out[2]}
t1_sri_ven=${out[3]}
t1_prior_CSF=${out[6]}
t1_prior_GM=${out[7]}
t1_prior_WM=${out[8]}

# Copy brainmask and pretend it's a parcellation map also - this is for whole-brain (ICV) tissue volumes
icv_mask=${WORKDIR}/structural/reslice/sri24_padded/icv.nii.gz
if LWDP_needs_update_and_lock ${icv_mask} ${sri24_padded_t1_brainmask}; then
  cmtk convertx ${sri24_padded_t1_brainmask} ${icv_mask}
  LWDP_lockfile_delete ${icv_mask}
fi

# classification using fast with t1
[ -d ${WORKDIR}/structural/segment/sri24_padded/fast ] || mkdir -p ${WORKDIR}/structural/segment/sri24_padded/fast
t1_seg_pfx=${WORKDIR}/structural/segment/sri24_padded/fast/t1
t1_seg=${t1_seg_pfx}_seg.nii.gz
segment_fast 1 "${sri24_padded_t1_brain}" ${t1_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}

# classification using atropos with t1
[ -d ${WORKDIR}/structural/segment/sri24_padded/atropos ] || mkdir -p ${WORKDIR}/structural/segment/sri24_padded/atropos
t1_seg_pfx=${WORKDIR}/structural/segment/sri24_padded/atropos/t1
t1_seg=${t1_seg_pfx}_seg.nii.gz
segment_atropos 1 "${sri24_padded_t1_brain}" ${sri24_padded_t1_brainmask} ${t1_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}

# classification using atropos with t1 masked
[ -d ${WORKDIR}/structural/segment/sri24_padded/atropos_masked ] || mkdir -p ${WORKDIR}/structural/segment/sri24_padded/atropos_masked
t1_masked_seg_pfx=${WORKDIR}/structural/segment/sri24_padded/atropos_masked/t1
t1_masked_seg=${t1_masked_seg_pfx}_seg.nii.gz
segment_atropos 1 "${sri24_padded_t1_brain_t2_masked}" ${sri24_padded_t1_brainmask} ${t1_masked_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}

## classification using atropos with t1 and t2
#[ -d ${WORKDIR}/structural/segment/sri24_padded/atropos_t1t2 ] || mkdir -p ${WORKDIR}/structural/segment/sri24_padded/atropos_t1t2
#t1t2_seg_pfx=${WORKDIR}/structural/segment/sri24_padded/atropos_t1t2/t1t2
#t1t2_seg=${t1t2_seg_pfx}_seg.nii.gz
##segment_atropos 2 "${sri24_padded_t1_brain} ${sri24_padded_t2_brain}" ${sri24_padded_t1_brainmask} ${t1t2_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}
#segment_atropos 2 "${sri24_padded_t1_brain} ${sri24_padded_t2_affine_brain}" ${sri24_padded_t1_brainmask} ${t1t2_seg_pfx} ${t1_prior_CSF} ${t1_prior_GM} ${t1_prior_WM} ${t1_sri_ven} ${t1_sri_parc} ${t1_sri_wm}

# generate CSV tissue files
for i in 1 2 4 5; do
  if [ "${i}" == "1" ]; then
    # posteriors from fast
    tab_folder=${WORKDIR}/structural/volumetry/sri24_padded/fast
    posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/fast/t1_pve_0.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/fast/t1_pve_1.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/fast/t1_pve_2.nii.gz)"
  elif [ "${i}" == "2" ]; then
    # posteriors from atropos t1
    tab_folder=${WORKDIR}/structural/volumetry/sri24_padded/atropos
    posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos/t1_posteriors_1.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos/t1_posteriors_2.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos/t1_posteriors_3.nii.gz)"
  elif [ "${i}" == "3" ]; then
    # posteriors from atropos t1+t2
    tab_folder=${WORKDIR}/structural/volumetry/sri24_padded/atropos_t1t2
    posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos_t1t2/t1t2_posteriors_1.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos_t1t2/t1t2_posteriors_2.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos_t1t2/t1t2_posteriors_3.nii.gz)"
  elif [ "${i}" == "4" ]; then
    # atropos t1 hard segmentation
    tab_folder=${WORKDIR}/structural/volumetry/sri24_padded/atropos_hs
    t1_seg=${WORKDIR}/structural/segment/sri24_padded/atropos/t1_seg.nii.gz
    t1_seg_1=${WORKDIR}/structural/segment/sri24_padded/atropos/t1_seg_1.nii.gz
    t1_seg_2=${WORKDIR}/structural/segment/sri24_padded/atropos/t1_seg_2.nii.gz
    t1_seg_3=${WORKDIR}/structural/segment/sri24_padded/atropos/t1_seg_3.nii.gz
    if LWDP_needs_update_and_lock ${t1_seg_1} ${t1_seg}; then
      c3d c3d ${t1_seg} -replace 0 0 1 1 2 0 3 0 -o ${t1_seg_1}
      c3d c3d ${t1_seg} -replace 0 0 1 0 2 1 3 0 -o ${t1_seg_2}
      c3d c3d ${t1_seg} -replace 0 0 1 0 2 0 3 1 -o ${t1_seg_3}
      LWDP_lockfile_delete ${t1_seg_1}
    fi
    posteriors="${t1_seg_1} ${t1_seg_2} ${t1_seg_3}"
  elif [ "${i}" == "5" ]; then
    # posteriors from atropos t1
    tab_folder=${WORKDIR}/structural/volumetry/sri24_padded/atropos_masked
    posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos_masked/t1_posteriors_1.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos_masked/t1_posteriors_2.nii.gz)"
    posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/segment/sri24_padded/atropos_masked/t1_posteriors_3.nii.gz)"
  fi
  
  # For each parcellation, compute tissue volume tables
  for parc in ${PARCELLATIONS}; do
    label_image=$(LWDP_get_override_file ${WORKDIR}/structural/reslice/sri24_padded/${parc}.nii.gz)
    label_txt=${DATA_DIR}/sri24/parcellation/sri24_${parc}.txt
  
    # First, without "unwarping" correction
    tabout=${tab_folder}/${parc}.tab
    if LWDP_needs_update_and_lock ${tabout} ${label_image} ${posteriors} ${label_txt}; then
      cmtk vol2csv --density-labels CSF,GM,WM -o ${tabout} --labels-file ${label_txt} ${label_image} ${posteriors}
      LWDP_lockfile_delete ${tabout}
    fi
    csvout=${tab_folder}/${parc}.csv
    tab_to_csv ${tabout} ${csvout} ${VISIT}
  
    if [ -n "${phantom_xml_input}" ]; then
      # Second, global scale from ADNI phantom scan to adjust volumes globally
      tabout=${tab_folder}/${parc}_scale.tab
      if LWDP_needs_update_and_lock ${tabout} ${label_image} ${posteriors} ${label_txt}; then
        cmtk vol2csv --density-labels CSF,GM,WM -o ${tabout} --pixel-scale-factor ${phantom_scale} --labels-file ${label_txt} ${label_image} ${posteriors}
        LWDP_lockfile_delete ${tabout}
      fi
      csvout=${tab_folder}/${parc}_scale.csv
      tab_to_csv ${tabout} ${csvout} ${VISIT}
    fi
  done
done

#
# XX - 4D segmentations for followup
#

function segment_atropos_4D
{
  local in_time_num=${1}
  local in_t1_image=${2}
  local in_t2_image=${3}
  local in_mask=${4}
  local in_prefix=${5}
  local in_prior_CSF=${6}
  local in_prior_GM=${7}
  local in_prior_WM=${8}
  local in_sri_ven=${9}
  local in_sri_parc=${10}
  local in_sri_wm=${11}

  if [ ${in_time_num} -lt 2 ]; then
    echo "ERROR: ${WORKDIR}: Multiple input time points required"
    return
  fi
  #if [ ${in_time_num} -gt 2 ]; then
  #  echo "ERROR: Not supported yet"
  #  return
  #fi

  seg=${in_prefix}_seg.nii.gz
  # if LWDP_needs_update_and_lock ${seg} ${in_prior_CSF} ${in_prior_GM} ${in_prior_WM} ${in_t1_images} ${in_t2_images}; then # updated var name to image not images
  if LWDP_needs_update_and_lock ${seg} ${in_prior_CSF} ${in_prior_GM} ${in_prior_WM} ${in_t1_image} ${in_t2_image}; then
    tmpdir=$(mktemp -d)

    fsl fslmerge -t ${tmpdir}/t1_image.nii.gz ${in_t1_image}
    fsl fslmerge -t ${tmpdir}/mask.nii.gz ${in_mask}
    fsl fslmerge -t ${tmpdir}/pbmap_1.nii.gz ${in_prior_CSF}
    fsl fslmerge -t ${tmpdir}/pbmap_2.nii.gz ${in_prior_GM}
    fsl fslmerge -t ${tmpdir}/pbmap_3.nii.gz ${in_prior_WM}

    in_images=${tmpdir}/t1_image.nii.gz
    if [ "${in_t2_image}" != "" ]; then
      fsl fslmerge -t ${tmpdir}/t2_image.nii.gz ${in_t2_image}
      in_images="${in_images} ${tmpdir}/t2_image.nii.gz"
    fi

    # djk: changed mrf params from [0.01,1x1x1x1] to [0.05,1x1x1x0] as mrf weight between time points generates boundary errors
    #ants Atropos -d 4 -x ${tmpdir}/mask.nii.gz -c [5,0.0] -a ${in_images} -i PriorProbabilityImages[3,${tmpdir}/pbmap_%d.nii.gz,0.0] -k HistogramParzenWindows -m [0.01,1x1x1x1] -o [${seg},${in_prefix}_posteriors_%d.nii.gz] -r 0 -p Socrates[1] --use-partial-volume-likelihoods 1 -s 1x2 -s 2x3
    ants Atropos -d 4 -x ${tmpdir}/mask.nii.gz -c [5,0.0] -a ${in_images} -i PriorProbabilityImages[3,${tmpdir}/pbmap_%d.nii.gz,0.0] -k HistogramParzenWindows -m [0.05,1x1x1x0] -o [${seg},${in_prefix}_posteriors_%d.nii.gz] -r 0 -p Socrates[1] --use-partial-volume-likelihoods 1 -s 1x2 -s 2x3

    status=$?

    if [ ${status} -ne 0 ] || [ ! -e "${seg}" ]; then
      echo "ERROR:${WORKDIR}: segment_atropos_4D failed to create ${seg}"
      echo "ERROR:${WORKDIR}: command exit status was ${status}"
      rm -rf ${tmpdir}
      LWDP_lockfile_delete ${seg}
      return 1
    fi

    fsl fslsplit ${seg} ${in_prefix}_seg_ -t
    for i in 1 2 3; do
      fsl fslsplit ${in_prefix}_posteriors_${i}.nii.gz ${in_prefix}_posteriors_${i}_ -t
    done
  
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${seg}
  fi

  in_time_num_1=`expr ${in_time_num} - 1`
  idx=1
  for i in `seq -f "%04g" 0 ${in_time_num_1}`; do
    seg=${in_prefix}_seg_${i}.nii.gz
    seg_clean=${in_prefix}_seg_clean_${i}.nii.gz
    if LWDP_needs_update_and_lock ${seg_clean} ${seg}; then
      ${SLICER_CLI}/IslandRemoval -m 25 ${seg} ${seg_clean} 
      fsl fslcpgeom ${seg} ${seg_clean}
      LWDP_lockfile_delete ${seg_clean}
    fi
   
    sri_ven=`echo ${in_sri_ven} | cut -d " " -f${idx}` 
    ven_parc=${in_prefix}_ven_parc_${i}.nii.gz
    if LWDP_needs_update_and_lock ${ven_parc} ${seg_clean} ${sri_ven}; then
      fsl fslmaths ${seg_clean} -thr 1 -uthr 1 -bin -mul ${sri_ven} ${ven_parc}
      LWDP_lockfile_delete ${ven_parc}
    fi 
    sri_parc=`echo ${in_sri_parc} | cut -d " " -f${idx}` 
    gm_parc=${in_prefix}_gm_parc_${i}.nii.gz
    if LWDP_needs_update_and_lock ${gm_parc} ${seg_clean} ${sri_parc}; then
      fsl fslmaths ${seg_clean} -thr 2 -uthr 2 -bin -mul ${sri_parc} ${gm_parc}
      LWDP_lockfile_delete ${gm_parc}
    fi 
    sri_wm=`echo ${in_sri_wm} | cut -d " " -f${idx}` 
    wm_parc=${in_prefix}_wm_parc_${i}.nii.gz
    if LWDP_needs_update_and_lock ${wm_parc} ${seg_clean} ${sri_wm}; then
      fsl fslmaths ${seg_clean} -thr 3 -uthr 3 -bin -mul ${sri_wm} ${wm_parc}
      LWDP_lockfile_delete ${wm_parc}
    fi

    let idx++
  done
}

if [ "${VISIT}" != "baseline" ]; then
  followup_year=`echo ${VISIT} | cut -d "_" -f2 | cut -d "y" -f1`
  followup_char=`echo ${VISIT} | cut -d "_" -f2 | sed 's/^[0-9]\+//'`

  sri24_padded_t1_brain_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/t1_brain.nii.gz)
  sri24_padded_t1_brain_t2_masked_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/t1_brain_t2_masked.nii.gz)
  sri24_padded_t2_affine_brain_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/t2_affine_brain.nii.gz)
  sri24_padded_t1_brainmask_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/t1_brain_mask.nii.gz)
  t1_prior_CSF_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/pbmap_CSF.nii.gz)
  t1_prior_GM_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/pbmap_GM.nii.gz)
  t1_prior_WM_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/pbmap_WM.nii.gz)
  t1_sri_ven_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/ventricles.nii.gz)
  t1_sri_parc_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/parc116.nii.gz)
  t1_sri_wm_list=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/reslice/sri24_padded/wm400.nii.gz)

  # generate CSV tissue files
  visit_num=0
  for year in `seq 0 ${followup_year}`; do
    if [ ${year} -eq 0 ]; then
      let visit_num++
      continue
    else
      visit=followup_${year}${followup_char}
      reslicePath=${visit}/structural/reslice
      longPath=structural/longitudinal/volumetry/sri24_padded/atropos
      if [ ! -d ${CASESDIR}/${SUBJECT}/${ARM}/$reslicePath ]; then
          if [ -d ${WORKDIR}/$longPath/${visit} ]; then
            echo "INFO:$WORKDIR:Inconcistency - $visit in $longPath but $reslicePath is missing - remove segment and volumetry folders!"
            rm -rf ${WORKDIR}/structural/longitudinal/segment/sri24_padded/*
            rm -rf ${WORKDIR}/structural/longitudinal/volumetry/sri24_padded/*
          fi
          #
          if [ ! -d ${CASESDIR}/${SUBJECT}/${ARM}/${visit}/structural ]; then 
	    echo "WARNING:${WORKDIR}: missing ${CASESDIR}/${SUBJECT}/${ARM}/${visit}/structural; atropos 4D will omit this visit"
	  else 
 	    echo "ERROR:${WORKDIR}: directory 'reslice' is missing in  ${CASESDIR}/${SUBJECT}/${ARM}/${visit}/structural; atropos 4D will omit this visit"
	  fi 
          continue
      else
        if [ -d ${WORKDIR}/$longPath ]; then
          if [ ! -d ${WORKDIR}/$longPath/${visit} ]; then
	    echo "INFO:$WORKDIR:Inconcistency -  $reslicePath exists but no $visit in $longPath - remove segment and volumetry folders!"
            rm -rf ${WORKDIR}/structural/longitudinal/segment/sri24_padded/*
            rm -rf ${WORKDIR}/structural/longitudinal/volumetry/sri24_padded/*
          fi
        fi
      fi

      sri24_padded_t1_brain_list="${sri24_padded_t1_brain_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/corrected/t1_brain.nii.gz)"
      sri24_padded_t1_brain_t2_masked_list="${sri24_padded_t1_brain_t2_masked_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/corrected/t1_brain_t2_masked.nii.gz)"
      sri24_padded_t2_affine_brain_list="${sri24_padded_t2_affine_brain_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/corrected/t2_affine_brain.nii.gz)"
      sri24_padded_t1_brainmask_list="${sri24_padded_t1_brainmask_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/t1_brain_mask.nii.gz)"
      t1_prior_CSF_list="${t1_prior_CSF_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/pbmap_CSF.nii.gz)"
      t1_prior_GM_list="${t1_prior_GM_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/pbmap_GM.nii.gz)"
      t1_prior_WM_list="${t1_prior_WM_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/pbmap_WM.nii.gz)"
      t1_sri_ven_list="${t1_sri_ven_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/ventricles.nii.gz)"
      t1_sri_parc_list="${t1_sri_parc_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/parc116.nii.gz)"
      t1_sri_wm_list="${t1_sri_wm_list} $(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/wm400.nii.gz)"

      let visit_num++
    fi
  done

  # classification using atropos_4D with t1
  [ -d ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos ] || mkdir -p ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos
  t1_seg_pfx=${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos/t1
  t1_seg=${t1_seg_pfx}_seg.nii.gz
  # 05/19/26:JD: Added echo warning for downstream fails
  if ! segment_atropos_4D ${visit_num} "${sri24_padded_t1_brain_list}" "" "${sri24_padded_t1_brainmask_list}" ${t1_seg_pfx} "${t1_prior_CSF_list}" "${t1_prior_GM_list}" "${t1_prior_WM_list}" "${t1_sri_ven_list}" "${t1_sri_parc_list}" "${t1_sri_wm_list}"; then
    echo "WARNING:${WORKDIR}: segment_atropos_4D failed for longitudinal atropos; downstream longitudinal volumetry may be skipped or fail"
  fi

  # classification using atropos_4D with t1 masked
  [ -d ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_masked ] || mkdir -p ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_masked
  t1_masked_seg_pfx=${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_masked/t1
  t1_masked_seg=${t1_masked_seg_pfx}_seg.nii.gz
  segment_atropos_4D ${visit_num} "${sri24_padded_t1_brain_t2_masked_list}" "" "${sri24_padded_t1_brainmask_list}" ${t1_masked_seg_pfx} "${t1_prior_CSF_list}" "${t1_prior_GM_list}" "${t1_prior_WM_list}" "${t1_sri_ven_list}" "${t1_sri_parc_list}" "${t1_sri_wm_list}"

  ## classification using atropos_4D with t1 and t2
  #[ -d ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_t1t2 ] || mkdir -p ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_t1t2
  #t1t2_seg_pfx=${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_t1t2/t1t2
  #t1t2_seg=${t1t2_seg_pfx}_seg.nii.gz
  #segment_atropos_4D ${visit_num} "${sri24_padded_t1_brain_list}" "${sri24_padded_t2_affine_brain_list}" "${sri24_padded_t1_brainmask_list}" ${t1t2_seg_pfx} "${t1_prior_CSF_list}" "${t1_prior_GM_list}" "${t1_prior_WM_list}" "${t1_sri_ven_list}" "${t1_sri_parc_list}" "${t1_sri_wm_list}"

  # generate CSV tissue files
  idx=0
  for year in `seq 0 ${followup_year}`; do
    idx_f=`seq -f "%04g" ${idx} ${idx}`
    if [ ${year} -eq 0 ]; then
      visit=baseline
      let idx++
    else
      visit=followup_${year}${followup_char}
      if [ ! -d ${CASESDIR}/${SUBJECT}/${ARM}/${visit}/structural/reslice ]; then
        continue
      fi
      let idx++
    fi

    for i in 1 3 4; do
      if [ "${i}" == "1" ]; then
        # posteriors from atropos_4D t1
        tab_folder=${WORKDIR}/structural/longitudinal/volumetry/sri24_padded/atropos/${visit}
        posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos/t1_posteriors_1_${idx_f}.nii.gz)"
        posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos/t1_posteriors_2_${idx_f}.nii.gz)"
        posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos/t1_posteriors_3_${idx_f}.nii.gz)"
      elif [ "${i}" == "2" ]; then
        # posteriors from atropos_4D t1+t2
        tab_folder=${WORKDIR}/structural/longitudinal/volumetry/sri24_padded/atropos_t1t2/${visit}
        posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_t1t2/t1t2_posteriors_1_${idx_f}.nii.gz)"
        posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_t1t2/t1t2_posteriors_2_${idx_f}.nii.gz)"
        posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_t1t2/t1t2_posteriors_3_${idx_f}.nii.gz)"
      elif [ "${i}" == "3" ]; then
        # atropos_4D t1 hard segmentation
        tab_folder=${WORKDIR}/structural/longitudinal/volumetry/sri24_padded/atropos_hs/${visit}
        t1_seg=${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos/t1_seg_${idx_f}.nii.gz
        t1_seg_1=${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos/t1_seg_1_${idx_f}.nii.gz
        t1_seg_2=${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos/t1_seg_2_${idx_f}.nii.gz
        t1_seg_3=${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos/t1_seg_3_${idx_f}.nii.gz
        if LWDP_needs_update_and_lock ${t1_seg_1} ${t1_seg}; then
          c3d c3d ${t1_seg} -replace 0 0 1 1 2 0 3 0 -o ${t1_seg_1}
          c3d c3d ${t1_seg} -replace 0 0 1 0 2 1 3 0 -o ${t1_seg_2}
          c3d c3d ${t1_seg} -replace 0 0 1 0 2 0 3 1 -o ${t1_seg_3}
          LWDP_lockfile_delete ${t1_seg_1}
        fi
        posteriors="${t1_seg_1} ${t1_seg_2} ${t1_seg_3}"
      elif [ "${i}" == "4" ]; then
        # posteriors from atropos_4D t1 masked
        tab_folder=${WORKDIR}/structural/longitudinal/volumetry/sri24_padded/atropos_masked/${visit}
        posteriors="$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_masked/t1_posteriors_1_${idx_f}.nii.gz)"
        posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_masked/t1_posteriors_2_${idx_f}.nii.gz)"
        posteriors+=" $(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/segment/sri24_padded/atropos_masked/t1_posteriors_3_${idx_f}.nii.gz)"
      fi
      
      # For each parcellation, compute tissue volume tables
      for parc in ${PARCELLATIONS}; do
        label_image=$(LWDP_get_override_file ${WORKDIR}/../${visit}/structural/reslice/sri24_padded/${parc}.nii.gz)
        label_txt=${DATA_DIR}/sri24/parcellation/sri24_${parc}.txt
      
        # First, without "unwarping" correction
        tabout=${tab_folder}/${parc}.tab
        if LWDP_needs_update_and_lock ${tabout} ${label_image} ${posteriors} ${label_txt}; then
          cmtk vol2csv --density-labels CSF,GM,WM -o ${tabout} --labels-file ${label_txt} ${label_image} ${posteriors}
          LWDP_lockfile_delete ${tabout}
        fi
        csvout=${tab_folder}/${parc}.csv
        tab_to_csv ${tabout} ${csvout} ${visit}
      
        if [ -n "${phantom_xml_input}" ]; then
          # Second, global scale from ADNI phantom scan to adjust volumes globally
          tabout=${tab_folder}/${parc}_scale.tab
          if LWDP_needs_update_and_lock ${tabout} ${label_image} ${posteriors} ${label_txt}; then
            cmtk vol2csv --density-labels CSF,GM,WM -o ${tabout} --pixel-scale-factor ${phantom_scale} --labels-file ${label_txt} ${label_image} ${posteriors}
            LWDP_lockfile_delete ${tabout}
          fi
          csvout=${tab_folder}/${parc}_scale.csv
          tab_to_csv ${tabout} ${csvout} ${visit}
        fi
      done
    done
  done
fi

