NCANDA_BINARY_DIR=@NCANDA_BINARY_DIR_CONFIG@
DATA_DIR=@DATA_DIR_CONFIG@
TEMPLATE_DIR=@TEMPLATE_DIR_CONFIG@
 
source ${NCANDA_BINARY_DIR}/ncanda_setup.sh $*

#
# Setup input and output
#

export t1_input=$(LWDP_get_override_file ${WORKDIR}/structural/native/t1.nii.gz)
export t2_input=$(LWDP_get_override_file ${WORKDIR}/structural/native/t2.nii.gz)

if [ ! -f ${t1_input} -o ! -f ${t2_input} ]; then
  MSG="ERROR: ${WORKDIR}: missing or incomplete structural data"
  echo "${MSG}"
  #echo "${MSG}" | ncanda_error_email $(basename $0)
  exit 1
fi

if [ -e ${WORKDIR}/structural/failed_qc ]; then
  echo "Warning: ${WORKDIR}/structural: failed qc"
  exit 1
fi

export phantom_xml_input=$(LWDP_get_override_file ${WORKDIR}/structural/native/phantom.xml)
if [ ! -f ${phantom_xml_input} ]; then
  unset phantom_xml_input
fi

#
# 1 - Denoising
#

[ -d ${WORKDIR}/structural/denoised ] || mkdir -p ${WORKDIR}/structural/denoised

t1_denoised=${WORKDIR}/structural/denoised/t1.nii.gz
if LWDP_needs_update_and_lock ${t1_denoised} ${t1_input}; then
  naonlm naonlm3d -i ${t1_input} -o ${t1_denoised}
  LWDP_lockfile_delete ${t1_denoised}
fi
export t1_denoised=$(LWDP_get_override_file ${t1_denoised})

#
# 2 - Bias field correcton without mask (step1)
#

[ -d ${WORKDIR}/structural/mrbias/step1 ] || mkdir -p ${WORKDIR}/structural/mrbias/step1

t1_mrbias=${WORKDIR}/structural/mrbias/step1/t1.nii.gz
if LWDP_needs_update_and_lock ${t1_mrbias} ${t1_denoised}; then
  ants N4BiasFieldCorrection -i ${t1_denoised} -o [${t1_mrbias},${WORKDIR}/structural/mrbias/step1/t1_bias.nii.gz]
  LWDP_lockfile_delete ${t1_mrbias}
fi
export t1_mrbias=$(LWDP_get_override_file ${t1_mrbias})

#t2_mrbias=${WORKDIR}/structural/mrbias/step1/t2.nii.gz
#if LWDP_needs_update_and_lock ${t2_mrbias} ${t2_denoised}; then
#  ants N4BiasFieldCorrection -i ${t2_denoised} -o [${t2_mrbias},${WORKDIR}/structural/mrbias/step1/t2_bias.nii.gz]
#  LWDP_lockfile_delete ${t2_mrbias}
#fi
#export t2_mrbias=$(LWDP_get_override_file ${t2_mrbias})

#
# 3 - Align T1 and T2 weighted images and reslice T2w to T1w
#

t1t2_affine=${WORKDIR}/structural/registration/t1_t2/affine.xform
if LWDP_needs_update_and_lock ${t1t2_affine} ${t1_mrbias} ${t2_input}; then
  cmtk registrationx ${CMTK_GLOBAL_ARGS} --dofs 6,9,12 --auto-multi-levels 4 --init physical -o ${t1t2_affine} ${t1_mrbias} ${t2_input}
  LWDP_lockfile_delete ${t1t2_affine}
fi
export t1t2_affine=$(LWDP_get_override_file ${t1t2_affine})

t1t2_warp=${WORKDIR}/structural/registration/t1_t2/warp.xform
if LWDP_needs_update_and_lock ${t1t2_warp} ${t1t2_affine}; then
  cmtk warp ${CMTK_GLOBAL_ARGS} --jacobian-weight 1e-2 --grid-spacing 40 --refine 1 -e 4 -a 0.125 -o ${t1t2_warp} ${t1t2_affine}
  LWDP_lockfile_delete ${t1t2_warp}
fi
export t1t2_warp=$(LWDP_get_override_file ${t1t2_warp})

#t2t1_warp=${WORKDIR}/structural/registration/t2_t1/warp.xform
#if LWDP_needs_update_and_lock ${t2t1_warp} ${t1t2_affine}; then
#  cmtk warp ${CMTK_GLOBAL_ARGS} --jacobian-weight 1e-2 --grid-spacing 40 --refine 1 -e 4 -a 0.125 -o ${t2t1_warp} --switch ${t1t2_affine}
#  LWDP_lockfile_delete ${t2t1_warp}
#fi
#export t2t1_warp=$(LWDP_get_override_file ${t2t1_warp})

t2_reslice_t1=${WORKDIR}/structural/reslice/subject_t1/t2.nii.gz
if LWDP_needs_update_and_lock ${t2_reslice_t1} ${t1t2_warp} ${t2_input} ${t1_input}; then
  cmtk reformatx --sinc-cosine -o ${t2_reslice_t1} --floating ${t2_input} ${t1_input} ${t1t2_warp}
  LWDP_lockfile_delete ${t2_reslice_t1}
fi
export t2_reslice_t1=$(LWDP_get_override_file ${t2_reslice_t1})

#t2_affine_reslice_t1=${WORKDIR}/structural/reslice/subject_t1/t2_affine.nii.gz
#if LWDP_needs_update_and_lock ${t2_affine_reslice_t1} ${t1t2_affine} ${t2_input} ${t1_input}; then
#  cmtk reformatx --sinc-cosine -o ${t2_affine_reslice_t1} --floating ${t2_input} ${t1_input} ${t1t2_affine}
#  LWDP_lockfile_delete ${t2_affine_reslice_t1}
#fi
#export t2_affine_reslice_t1=$(LWDP_get_override_file ${t2_affine_reslice_t1})

t2_denoised=${WORKDIR}/structural/denoised/t2.nii.gz
if LWDP_needs_update_and_lock ${t2_denoised} ${t2_reslice_t1}; then
  naonlm naonlm3d -i ${t2_reslice_t1} -o ${t2_denoised}
  LWDP_lockfile_delete ${t2_denoised}
fi
export t2_denoised=$(LWDP_get_override_file ${t2_denoised})

t2_mrbias=${WORKDIR}/structural/mrbias/step1/t2.nii.gz
if LWDP_needs_update_and_lock ${t2_mrbias} ${t2_denoised}; then
  ants N4BiasFieldCorrection -i ${t2_denoised} -o [${t2_mrbias},${WORKDIR}/structural/mrbias/step1/t2_bias.nii.gz]
  LWDP_lockfile_delete ${t2_mrbias}
fi
export t2_mrbias=$(LWDP_get_override_file ${t2_mrbias})

#
# 4 - Register T1 and SRI24 with skull
#

sri24_t1_whole=${DATA_DIR}/sri24/sri24_t1_whole.nii.gz
sri24_t2_whole=${DATA_DIR}/sri24/sri24_t2_whole.nii.gz
sri24_brainmask=${DATA_DIR}/sri24/sri24_brainmask.nii.gz

t1_sri24_whole_pfx=${WORKDIR}/structural/registration/t1_sri24_whole/ants_
t1_sri24_whole_affine=${t1_sri24_whole_pfx}0GenericAffine.mat
if LWDP_needs_update_and_lock ${t1_sri24_whole_affine} ${t1_mrbias} ${sri24_t1_whole}; then
  log_out=${t1_sri24_whole_pfx}0GenericAffine.log
  ants antsRegistration -d 3 -r [${t1_mrbias},${sri24_t1_whole},0] -t Affine[0.1] -m MI[${t1_mrbias},${sri24_t1_whole},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${t1_sri24_whole_pfx} > ${log_out}
  LWDP_lockfile_delete ${t1_sri24_whole_affine}
fi
export t1_sri24_whole_affine=$(LWDP_get_override_file ${t1_sri24_whole_affine})

t1_sri24_whole_pfx=${WORKDIR}/structural/registration/t1_sri24_whole/ants_
t1_sri24_whole_warp=${t1_sri24_whole_pfx}1Warp.nii.gz
#if LWDP_needs_update_and_lock ${t1_sri24_whole_warp} ${t1_sri24_whole_affine} ${t1_mrbias} ${sri24_t1_whole}; then
if LWDP_needs_update_and_lock ${t1_sri24_whole_warp} ${t1_mrbias} ${sri24_t1_whole}; then
  log_out=${t1_sri24_whole_pfx}1Warp.log
  #ants antsRegistration -d 3 --initial-moving-transform ${t1_sri24_whole_affine} -t SyN[0.5,3,0.5] -m CC[${t1_mrbias},${sri24_t1_whole},1,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${t1_sri24_whole_pfx} > ${log_out}
  ants antsRegistration -d 3 --initial-moving-transform ${t1_sri24_whole_affine} -t SyN[0.5,3,0.5] -m CC[${t1_mrbias},${sri24_t1_whole},1,4] -c 100x30x10 -f 4x2x1 -s 2x1x0vox -o ${t1_sri24_whole_pfx} > ${log_out}
  #touch -r ${log_out} ${t1_sri24_whole_warp}
  LWDP_lockfile_delete ${t1_sri24_whole_warp}
fi
t1_sri24_whole_warp=$(LWDP_get_override_file ${t1_sri24_whole_warp})
  
sri24_t1_whole_aligned=${WORKDIR}/structural/reslice/subject_t1/t1_sri24_whole/t1_whole.nii.gz
if LWDP_needs_update_and_lock ${sri24_t1_whole_aligned} ${sri24_t1_whole} ${t1_mrbias} ${t1_sri24_whole_warp} ${t1_sri24_whole_affine}; then
  ants antsApplyTransforms -i ${sri24_t1_whole} -r ${t1_mrbias} -o ${sri24_t1_whole_aligned} -t ${t1_sri24_whole_warp} ${t1_sri24_whole_affine}
  #ants antsApplyTransforms -i ${sri24_t1_whole} -r ${t1_mrbias} -o ${sri24_t1_whole_aligned} -t ${t1_sri24_whole_affine}
  c3d c3d ${sri24_t1_whole_aligned} -type float -o ${sri24_t1_whole_aligned}
  LWDP_lockfile_delete ${sri24_t1_whole_aligned}
fi
sri24_t2_whole_aligned=${WORKDIR}/structural/reslice/subject_t1/t1_sri24_whole/t2_whole.nii.gz
if LWDP_needs_update_and_lock ${sri24_t2_whole_aligned} ${sri24_t2_whole} ${t1_mrbias} ${t1_sri24_whole_warp} ${t1_sri24_whole_affine}; then
  ants antsApplyTransforms -i ${sri24_t2_whole} -r ${t1_mrbias} -o ${sri24_t2_whole_aligned} -t ${t1_sri24_whole_warp} ${t1_sri24_whole_affine}
  #ants antsApplyTransforms -i ${sri24_t2_whole} -r ${t1_mrbias} -o ${sri24_t2_whole_aligned} -t ${t1_sri24_whole_affine}
  c3d c3d ${sri24_t2_whole_aligned} -type float -o ${sri24_t2_whole_aligned}
  LWDP_lockfile_delete ${sri24_t2_whole_aligned}
fi
sri24_brainmask_aligned=${WORKDIR}/structural/reslice/subject_t1/t1_sri24_whole/brainmask.nii.gz
if LWDP_needs_update_and_lock ${sri24_brainmask_aligned} ${sri24_brainmask} ${t1_mrbias} ${t1_sri24_whole_warp} ${t1_sri24_whole_affine}; then
  # used MultiLabel (default value equals MultiLabel[1,1]) interpolation to make smooth boundaries
  ants antsApplyTransforms -n MultiLabel -i ${sri24_brainmask} -r ${t1_mrbias} -o ${sri24_brainmask_aligned} -t ${t1_sri24_whole_warp} ${t1_sri24_whole_affine}
  c3d c3d ${sri24_brainmask_aligned} -type byte -o ${sri24_brainmask_aligned}
  LWDP_lockfile_delete ${sri24_brainmask_aligned}
fi

#
# 5 - Apply mask on T1 and T2 image, cut non-brain area
#

mask_width=10

mask_org=${sri24_brainmask_aligned}
mask_temp=${WORKDIR}/structural/reslice/subject_t1/t1_sri24_whole/brainmask_${mask_width}.nii.gz
if LWDP_needs_update_and_lock ${mask_temp} ${mask_org}; then
  c3d c3d ${mask_org} -dilate 1 ${mask_width}mmx${mask_width}mmx${mask_width}mm -o ${mask_temp}
  LWDP_lockfile_delete ${mask_temp}
fi 

t1m_input=${WORKDIR}/structural/denoised/t1_masked.nii.gz
if LWDP_needs_update_and_lock ${t1m_input} ${t1_denoised} ${mask_temp}; then
  fsl fslmaths ${t1_denoised} -mul ${mask_temp} ${t1m_input}
  LWDP_lockfile_delete ${t1m_input}
fi
export t1m_input=$(LWDP_get_override_file ${t1m_input})

t1m_mrbias=${WORKDIR}/structural/mrbias/step1/t1_masked.nii.gz
if LWDP_needs_update_and_lock ${t1m_mrbias} ${t1_mrbias} ${mask_temp}; then
  fsl fslmaths ${t1_mrbias} -mul ${mask_temp} ${t1m_mrbias}
  LWDP_lockfile_delete ${t1m_mrbias}
fi
export t1m_mrbias=$(LWDP_get_override_file ${t1m_mrbias})

t2m_input=${WORKDIR}/structural/denoised/t2_masked.nii.gz
if LWDP_needs_update_and_lock ${t2m_input} ${t2_denoised} ${mask_temp}; then
  fsl fslmaths ${t2_denoised} -mul ${mask_temp} ${t2m_input}
  LWDP_lockfile_delete ${t2m_input}
fi
export t2m_input=$(LWDP_get_override_file ${t2m_input})

t2m_mrbias=${WORKDIR}/structural/mrbias/step1/t2_masked.nii.gz
if LWDP_needs_update_and_lock ${t2m_mrbias} ${t2_mrbias} ${mask_temp}; then
  fsl fslmaths ${t2_mrbias} -mul ${mask_temp} ${t2m_mrbias}
  LWDP_lockfile_delete ${t2m_mrbias}
fi
export t2m_mrbias=$(LWDP_get_override_file ${t2m_mrbias})

#
# 6 - Skull stripping by voting
#

strip_voting_dir=${WORKDIR}/structural/stripped/voting
[ -d ${strip_voting_dir} ] || mkdir -p ${strip_voting_dir}

skip_num=0

skull_strip_robex()
{
  local input=$1
  local brain=$2
  local mask=$3

  if LWDP_needs_update_and_lock ${mask} ${input}; then
    robex_strip ${input} ${brain} ${mask}
    LWDP_lockfile_delete ${mask}
  fi
}

robex_t1_mask=
if [ ! -d ${strip_voting_dir}/skip_robex_t1_brain_mask ]; then
  robex_t1_mask=${strip_voting_dir}/robex_t1_brain_mask.nii.gz
  skull_strip_robex ${t1m_input} ${strip_voting_dir}/robex_t1_brain.nii.gz ${robex_t1_mask}
else
  echo "INFO: ${WORKDIR}: skip robex_t1_brain_mask"
  let skip_num++
fi

robex_t1b_mask=
if [ ! -d ${strip_voting_dir}/skip_robex_t1b_brain_mask ]; then
  robex_t1b_mask=${strip_voting_dir}/robex_t1b_brain_mask.nii.gz
  skull_strip_robex ${t1m_mrbias} ${strip_voting_dir}/robex_t1b_brain.nii.gz ${robex_t1b_mask}
else
  echo "INFO: ${WORKDIR}: skip robex_t1b_brain_mask"
  let skip_num++
fi

skull_strip_bet()
{
  local input=$1
  local mask=$2

  if LWDP_needs_update_and_lock ${mask} ${input}; then
    fsl bet ${input} $(dirname ${mask})/$(basename ${mask} _mask.nii.gz) -m -R -f 0.2
    LWDP_lockfile_delete ${mask}
  fi
}

bet_t1_mask=
if [ ! -d ${strip_voting_dir}/skip_bet_t1_brain_mask ]; then
  bet_t1_mask=${strip_voting_dir}/bet_t1_brain_mask.nii.gz
  skull_strip_bet ${t1m_input} ${bet_t1_mask}
else
  echo "INFO: ${WORKDIR}: skip bet_t1_brain_mask"
  let skip_num++
fi

bet_t1b_mask=
if [ ! -d ${strip_voting_dir}/skip_bet_t1b_brain_mask ]; then
  bet_t1b_mask=${strip_voting_dir}/bet_t1b_brain_mask.nii.gz
  skull_strip_bet ${t1m_mrbias} ${bet_t1b_mask}
else
  echo "INFO: ${WORKDIR}: skip bet_t1b_brain_mask"
  let skip_num++
fi

skull_strip_afni()
{
  local input=$1
  local brain=$2
  local mask=$3

  if LWDP_needs_update_and_lock ${mask} ${input}; then
    local tmpdir=$(mktemp -d)
    afni 3dSkullStrip -input ${input} -prefix ${tmpdir}/afni_brain_mask_tmp.nii.gz -mask_vol
    fsl fslcpgeom ${input} ${tmpdir}/afni_brain_mask_tmp.nii.gz
    fsl fslmaths ${tmpdir}/afni_brain_mask_tmp.nii.gz -thr 1 -bin ${mask}
    fsl fslmaths ${input} -mul ${mask} ${brain}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${mask}
  fi
}

afni_t1_mask=
if [ ! -d ${strip_voting_dir}/skip_afni_t1_brain_mask ]; then
  afni_t1_mask=${strip_voting_dir}/afni_t1_brain_mask.nii.gz
  skull_strip_afni ${t1m_input} ${strip_voting_dir}/afni_t1_brain.nii.gz ${afni_t1_mask}
else
  echo "INFO: ${WORKDIR}: skip afni_t1_brain_mask"
  let skip_num++
fi

afni_t1b_mask=
if [ ! -d ${strip_voting_dir}/skip_afni_t1b_brain_mask ]; then
  afni_t1b_mask=${strip_voting_dir}/afni_t1b_brain_mask.nii.gz
  skull_strip_afni ${t1m_mrbias} ${strip_voting_dir}/afni_t1b_brain.nii.gz ${afni_t1b_mask}
else
  echo "INFO: ${WORKDIR}: skip afni_t1b_brain_mask"
  let skip_num++
fi

skull_strip_gcut()
{
  local input=$1
  local brain=$2
  local mask=$3

  if LWDP_needs_update_and_lock ${mask} ${input}; then
    local tmpdir=$(mktemp -d)
    mri_gcut ${input} ${tmpdir}/gcut_brain.mgz
    mri_convert ${tmpdir}/gcut_brain.mgz ${brain}
    c3d c3d ${brain} -thresh 0 0 0 1 -o ${mask}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${mask}
  fi
}

# 20150828 djk
# gcut works better in bias corrected images, so we'll always skip this
gcut_t1_mask=

gcut_t1b_mask=
if [ ! -d ${strip_voting_dir}/skip_gcut_t1b_brain_mask ]; then
  gcut_t1b_mask=${strip_voting_dir}/gcut_t1b_brain_mask.nii.gz
  skull_strip_gcut ${t1m_mrbias} ${strip_voting_dir}/gcut_t1b_brain.nii.gz ${gcut_t1b_mask}
else
  echo "INFO: ${WORKDIR}: skip gcut_t1b_brain_mask"
  let skip_num++
fi

# 20150828 djk
# robex is not robust on t2 images, so we'll always skip this
robex_t2_mask=
robex_t2b_mask=

bet_t2_mask=
if [ ! -d ${strip_voting_dir}/skip_bet_t2_brain_mask ]; then
  bet_t2_mask=${strip_voting_dir}/bet_t2_brain_mask.nii.gz
  skull_strip_bet ${t2m_input} ${bet_t2_mask}
else
  echo "INFO: ${WORKDIR}: skip bet_t2_brain_mask"
  let skip_num++
fi

bet_t2b_mask=
if [ ! -d ${strip_voting_dir}/skip_bet_t2b_brain_mask ]; then
  bet_t2b_mask=${strip_voting_dir}/bet_t2b_brain_mask.nii.gz
  skull_strip_bet ${t2m_mrbias} ${bet_t2b_mask}
else
  echo "INFO: ${WORKDIR}: skip bet_t2b_brain_mask"
  let skip_num++
fi

afni_t2_mask=
if [ ! -d ${strip_voting_dir}/skip_afni_t2_brain_mask ]; then
  afni_t2_mask=${strip_voting_dir}/afni_t2_brain_mask.nii.gz
  skull_strip_afni ${t2m_input} ${strip_voting_dir}/afni_t2_brain.nii.gz ${afni_t2_mask}
else
  echo "INFO: ${WORKDIR}: skip afni_t2_brain_mask"
  let skip_num++
fi

afni_t2b_mask=
if [ ! -d ${strip_voting_dir}/skip_afni_t2b_brain_mask ]; then
  afni_t2b_mask=${strip_voting_dir}/afni_t2b_brain_mask.nii.gz
  skull_strip_afni ${t2m_mrbias} ${strip_voting_dir}/afni_t2b_brain.nii.gz ${afni_t2b_mask}
else
  echo "INFO: ${WORKDIR}: skip afni_t2b_brain_mask"
  let skip_num++
fi

# 20150828 djk
# gcut is not designed to work on t2 images, so we'll always skip this
gcut_t2_mask=
gcut_t2b_mask=

vote_input_masks=$(LWDP_get_override_files_list ${robex_t1_mask} ${robex_t1b_mask} ${bet_t1_mask} ${bet_t1b_mask} ${afni_t1_mask} ${afni_t1b_mask} ${gcut_t1_mask} ${gcut_t1b_mask} ${robex_t2_mask} ${robex_t2b_mask} ${bet_t2_mask} ${bet_t2b_mask} ${afni_t2_mask} ${afni_t2b_mask} ${gcut_t2_mask} ${gcut_t2b_mask})
vote_mask=${strip_voting_dir}/vote_brain_mask.nii.gz
if [ ${skip_num} -gt 0 ]; then
  echo "INFO: ${WORKDIR}: skip_num is ${skip_num}"
  LWDP_lockfile_create ${vote_mask}
  (cmtk imagemath --in ${vote_input_masks} --vote --out ${vote_mask} && cmtk convertx --byte ${vote_mask} ${vote_mask}) || rm ${vote_mask}.gz
  LWDP_lockfile_delete ${vote_mask}
else
  if LWDP_needs_update_and_lock ${vote_mask} ${vote_input_masks}; then
    (cmtk imagemath --in ${vote_input_masks} --vote --out ${vote_mask} && cmtk convertx --byte ${vote_mask} ${vote_mask}) || rm ${vote_mask}.gz
    LWDP_lockfile_delete ${vote_mask}
  fi
fi
export vote_mask=$(LWDP_get_override_file ${vote_mask})

if `is_manual_file $vote_mask`; then 
  echo "Warning: $WORKDIR: Ignoring voting and use manual mask!"  
fi   

vote_brain=${strip_voting_dir}/vote_brain.nii.gz
if LWDP_needs_update_and_lock ${vote_brain} ${vote_mask}; then
  cmtk convertx ${CMTK_GLOBAL_ARGS} --set-padding 0 --mask ${vote_mask} ${t1_mrbias} ${vote_brain}
  LWDP_lockfile_delete ${vote_brain}
fi

#
# 7 - Redo bias correction using vote mask (step2)
#

[ -d ${WORKDIR}/structural/mrbias/step2 ] || mkdir -p ${WORKDIR}/structural/mrbias/step2

t1_mrbias=${WORKDIR}/structural/mrbias/step2/t1.nii.gz
if LWDP_needs_update_and_lock ${t1_mrbias} ${t1_denoised} ${vote_mask}; then
  ants N4BiasFieldCorrection -i ${t1_denoised} -x ${vote_mask} -o [${t1_mrbias},${WORKDIR}/structural/mrbias/step2/t1_bias.nii.gz]
  LWDP_lockfile_delete ${t1_mrbias}
fi
export t1_mrbias=$(LWDP_get_override_file ${t1_mrbias})

t2_mrbias=${WORKDIR}/structural/mrbias/step2/t2.nii.gz
if LWDP_needs_update_and_lock ${t2_mrbias} ${t2_denoised} ${vote_mask}; then
  ants N4BiasFieldCorrection -i ${t2_denoised} -x ${vote_mask} -o [${t2_mrbias},${WORKDIR}/structural/mrbias/step2/t2_bias.nii.gz]
  LWDP_lockfile_delete ${t2_mrbias}
fi
export t2_mrbias=$(LWDP_get_override_file ${t2_mrbias})

t1_brain=${WORKDIR}/structural/mrbias/step2/t1_brain.nii.gz
if LWDP_needs_update_and_lock ${t1_brain} ${vote_mask} ${t1_mrbias}; then
  cmtk convertx ${CMTK_GLOBAL_ARGS} --set-padding 0 --mask ${vote_mask} ${t1_mrbias} ${t1_brain}
  LWDP_lockfile_delete ${t1_brain}
fi
export t1_brain=$(LWDP_get_override_file ${t1_brain})

t2_brain=${WORKDIR}/structural/mrbias/step2/t2_brain.nii.gz
if LWDP_needs_update_and_lock ${t2_brain} ${vote_mask} ${t2_mrbias}; then
  cmtk convertx ${CMTK_GLOBAL_ARGS} --set-padding 0 --mask ${vote_mask} ${t2_mrbias} ${t2_brain}
  LWDP_lockfile_delete ${t2_brain}
fi
export t2_brain=$(LWDP_get_override_file ${t2_brain})

#
# 8 - Select or reslice mask, based on whether this is a baseline or follow-up case
#
function baseline_to_visit_affine_dice {
  # Reformat baseline brainmask (affine) to this visit
  t1_brainmask_affine=${WORKDIR}/structural/stripped/t1_brain_mask_affine.nii.gz
  if LWDP_needs_update_and_lock ${t1_brainmask_affine} ${t1_brainmask_at_baseline} ${t1_mrbias} ${baseline_to_t1_affine}; then
    ants antsApplyTransforms -n NearestNeighbor -i ${t1_brainmask_at_baseline} -r ${t1_mrbias} -o ${t1_brainmask_affine} -t [${baseline_to_t1_affine},1]
    c3d c3d ${t1_brainmask_affine} -type short -o ${t1_brainmask_affine}
    LWDP_lockfile_delete ${t1_brainmask_affine}
  fi

  t1_brainmask_affine_dice=${baseline_to_t1_pfx}0GenericAffine.dice
  if LWDP_needs_update_and_lock ${t1_brainmask_affine_dice} ${t1_brainmask_affine} ${vote_mask}; then
      c3d c3d ${t1_brainmask_affine} ${vote_mask} -overlap 1 | cut -d "," -f 5 | tr -d " " &> ${t1_brainmask_affine_dice}
      LWDP_lockfile_delete ${t1_brainmask_affine_dice}
  fi  
}

function baseline_to_visit_affine_registration {
  baseline_to_t1_affine=${baseline_to_t1_pfx}0GenericAffine.mat

  if LWDP_needs_update_and_lock ${baseline_to_t1_affine} ${t1_at_baseline} ${t1_mrbias}; then
    log_out=${baseline_to_t1_pfx}0GenericAffine.log
    
    if [ -d $baseline_to_t1_firstRun ]; then 
	## if first trial did not work, remove rigid transformation and change affine converging rate from 0.1 to 0.02
	CMD="ants antsRegistration -d 3 -r [${t1_at_baseline},${t1_mrbias},1] -t Affine[0.02] -m MI[${t1_at_baseline},${t1_mrbias},1,32,Regular,0.25] -x ${t1_brainmask_at_baseline} -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${baseline_to_t1_pfx}"
	echo "INFO:$WORKDIR:baseline_to_visit_affine_registration is trying alternative registration setting!"
    else	
	CMD="ants antsRegistration -d 3 -r [${t1_at_baseline},${t1_mrbias},1] -t Rigid[0.1] -m MI[${t1_at_baseline},${t1_mrbias},1,32,Regular,0.25] -x ${t1_brainmask_at_baseline} -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${t1_at_baseline},${t1_mrbias},1,32,Regular,0.25] -x ${t1_brainmask_at_baseline} -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${baseline_to_t1_pfx}"
    fi
    echo $CMD > ${baseline_to_t1_pfx}0GenericAffine.cmd
    $CMD > ${log_out}

    LWDP_lockfile_delete ${baseline_to_t1_affine}
  fi
  baseline_to_t1_affine=$(LWDP_get_override_file ${baseline_to_t1_affine})

  baseline_to_visit_affine_dice 
}

t1_brainmask=${WORKDIR}/structural/stripped/t1_brain_mask.nii.gz
if [ "${VISIT}" == "baseline" ]; then
  if LWDP_needs_update_and_lock ${t1_brainmask} ${vote_mask}; then
    cmtk convertx ${vote_mask} ${t1_brainmask}
    LWDP_lockfile_delete ${t1_brainmask}
  fi
else

  [ -d ${WORKDIR}/structural/longitudinal/registration/baseline_to_t1 ] || mkdir -p ${WORKDIR}/structural/longitudinal/registration/baseline_to_t1

  # align with baseline t1 using baseline's t1_brainmask
  t1_brainmask_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/stripped/t1_brain_mask.nii.gz)
  t1_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/mrbias/t1.nii.gz)

  baseline_to_t1_pfx=${WORKDIR}/structural/longitudinal/registration/baseline_to_t1/ants_
  baseline_to_t1_firstRun=${WORKDIR}/structural/longitudinal/registration/baseline_to_t1/first_trial

  baseline_to_visit_affine_registration 

  # check overlap between warped baseline mask and vote mask
  dice=`cat $t1_brainmask_affine_dice`
  if [ $(echo "${dice} < 0.9" | bc) -eq 1 ]; then
    if [ ! -d $baseline_to_t1_firstRun ]; then 
    	echo "INFO:${WORKDIR}:trying a different registration setting due to insufficient overlap between warped baseline and vote mask (dice = ${dice} < 0.9)"   
	mkdir -p ${baseline_to_t1_firstRun}
	mv ${baseline_to_t1_pfx}* ${baseline_to_t1_firstRun}/. 
	
        baseline_to_visit_affine_registration
	dice=`cat $t1_brainmask_affine_dice`
    fi 
    if [ $(echo "${dice} < 0.9" | bc) -eq 1 ]; then
	MSG="ERROR:${WORKDIR}:insufficient overlap between warped baseline mask ${t1_brainmask_affine} and vote mask ${vote_mask} (dice = ${dice} < 0.9)" 
	echo "${MSG}"
	echo "${MSG}" | ncanda_error_email $(basename $0)
	exit 1
    fi
  fi

  baseline_to_t1_warp=${baseline_to_t1_pfx}1Warp.nii.gz
  if LWDP_needs_update_and_lock ${baseline_to_t1_warp} ${t1_at_baseline} ${t1_mrbias}; then
    log_out=${baseline_to_t1_pfx}1Warp.log
    ants antsRegistration -d 3 --initial-moving-transform ${baseline_to_t1_affine} -t SyN[0.5,3,0.5] -m CC[${t1_at_baseline},${t1_mrbias},1,4] -x ${t1_brainmask_at_baseline} -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${baseline_to_t1_pfx} > ${log_out}
    #touch -r ${log_out} ${baseline_to_t1_warp}
    LWDP_lockfile_delete ${baseline_to_t1_warp}
  fi
  export baseline_to_t1_warp=$(LWDP_get_override_file ${baseline_to_t1_warp})

  t1_to_baseline_warp=${baseline_to_t1_pfx}1InverseWarp.nii.gz
  export t1_to_baseline_warp=$(LWDP_get_override_file ${t1_to_baseline_warp})

  # have to do it again as time stamp of affine registration is changed 
  baseline_to_visit_affine_dice 
  dice=`cat $t1_brainmask_affine_dice`
  if [ $(echo "${dice} < 0.9" | bc) -eq 1 ]; then
      # this should have caught earlier 
      MSG="ERROR:${WORKDIR}:insufficient overlap between warped baseline mask ${t1_brainmask_affine} and vote mask ${vote_mask} (dice = ${dice} < 0.9)! not sure how we got here" 
      echo "${MSG}"
      echo "${MSG}" | ncanda_error_email $(basename $0)
      exit 1
  fi

  # Reformat baseline brainmask to this visit
  if LWDP_needs_update_and_lock ${t1_brainmask} ${t1_brainmask_at_baseline} ${t1_mrbias} ${baseline_to_t1_affine} ${t1_to_baseline_warp}; then
    ants antsApplyTransforms -n NearestNeighbor -i ${t1_brainmask_at_baseline} -r ${t1_mrbias} -o ${t1_brainmask} -t [${baseline_to_t1_affine},1] ${t1_to_baseline_warp}
    c3d c3d ${t1_brainmask} -type short -o ${t1_brainmask}
    LWDP_lockfile_delete ${t1_brainmask}
  fi
fi

export t1_brainmask=$(LWDP_get_override_file ${t1_brainmask})
if `is_manual_file $t1_brainmask`; then 
  echo "ERROR:$WORKDIR:The manually generated mask $t1_brainmask should not be used. Fix 'vote_mask' or 'baseline_to_t1_warp'!"
  exit 1 
fi   

#
# 9 - Redo bias correction using final mask
#

t1_mrbias=${WORKDIR}/structural/mrbias/t1.nii.gz
if LWDP_needs_update_and_lock ${t1_mrbias} ${t1_denoised} ${t1_brainmask}; then
  ants N4BiasFieldCorrection -i ${t1_denoised} -x ${t1_brainmask} -o [${t1_mrbias},${WORKDIR}/structural/mrbias/t1_bias.nii.gz]
  LWDP_lockfile_delete ${t1_mrbias}
fi
export t1_mrbias=$(LWDP_get_override_file ${t1_mrbias})

t2_mrbias=${WORKDIR}/structural/mrbias/t2.nii.gz
if LWDP_needs_update_and_lock ${t2_mrbias} ${t2_denoised} ${t1_brainmask}; then
  ants N4BiasFieldCorrection -i ${t2_denoised} -x ${t1_brainmask} -o [${t2_mrbias},${WORKDIR}/structural/mrbias/t2_bias.nii.gz]
  LWDP_lockfile_delete ${t2_mrbias}
fi
export t2_mrbias=$(LWDP_get_override_file ${t2_mrbias})

t1_brain=${WORKDIR}/structural/stripped/t1_brain.nii.gz
if LWDP_needs_update_and_lock ${t1_brain} ${t1_brainmask} ${t1_mrbias}; then
  cmtk convertx ${CMTK_GLOBAL_ARGS} --set-padding 0 --mask ${t1_brainmask} ${t1_mrbias} ${t1_brain}
  LWDP_lockfile_delete ${t1_brain}
fi
export t1_brain=$(LWDP_get_override_file ${t1_brain})

t2_brain=${WORKDIR}/structural/stripped/t2_brain.nii.gz
if LWDP_needs_update_and_lock ${t2_brain} ${t1_brainmask} ${t2_mrbias}; then
  cmtk convertx ${CMTK_GLOBAL_ARGS} --set-padding 0 --mask ${t1_brainmask} ${t2_mrbias} ${t2_brain}
  LWDP_lockfile_delete ${t2_brain}
fi
export t2_brain=$(LWDP_get_override_file ${t2_brain})

t1_skull=${WORKDIR}/structural/stripped/t1_skull.nii.gz
if LWDP_needs_update_and_lock ${t1_skull} ${t1_brainmask} ${t1_mrbias}; then
  cmtk convertx ${CMTK_GLOBAL_ARGS} --set-padding 0 --mask-inverse ${t1_brainmask} ${t1_mrbias} ${t1_skull}
  LWDP_lockfile_delete ${t1_skull}
fi
export t1_skull=$(LWDP_get_override_file ${t1_skull})

# generate affinely registratered t2
t1_to_t2_pfx=${WORKDIR}/structural/registration/t1_t2/ants_
t1_to_t2_affine=${t1_to_t2_pfx}0GenericAffine.mat
# if it does not do well try running with -t Rigid[0.01]  -t Affine[0.01]
# or omitting rigid registration

if LWDP_needs_update_and_lock ${t1_to_t2_affine} ${t1_mrbias} ${t2_input} ${t1_brainmask}; then
  log_out=${t1_to_t2_pfx}0GenericAffine.log
  ants antsRegistration -d 3 -r [${t1_mrbias},${t2_input},0] -t Rigid[0.1] -m MI[${t1_mrbias},${t2_input},1,32,Regular,0.25] -x ${t1_brainmask} -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${t1_mrbias},${t2_input},1,32,Regular,0.25] -x ${t1_brainmask} -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${t1_to_t2_pfx} > ${log_out}
  LWDP_lockfile_delete ${t1_to_t2_affine}
fi
t1_to_t2_affine=$(LWDP_get_override_file ${t1_to_t2_affine})
if [ ! -e $t1_to_t2_affine ]; then 
    echo "ERROR:$WORKDIR:Failed to register t1 (${t1_mrbias}) with t2 (${t2_input}) via ants!"
    exit 1
fi 

t2_affine_denoised=${WORKDIR}/structural/denoised/t2_affine.nii.gz
if LWDP_needs_update_and_lock ${t2_affine_denoised} ${t2_input} ${t1_mrbias} ${t1_to_t2_affine}; then
  tmpdir=$(mktemp -d)
  ants antsApplyTransforms -n BlackmanWindowedSinc -i ${t2_input} -r ${t1_mrbias} -o ${tmpdir}/t2.nii.gz -t ${t1_to_t2_affine}
  c3d c3d ${tmpdir}/t2.nii.gz -clip 0 inf -type float -o ${tmpdir}/t2.nii.gz
  naonlm naonlm3d -i ${tmpdir}/t2.nii.gz -o ${t2_affine_denoised}
  rm -rf ${tmpdir}
  LWDP_lockfile_delete ${t2_affine_denoised}
fi
export t2_affine_denoised=$(LWDP_get_override_file ${t2_affine_denoised})

t2_affine_mrbias=${WORKDIR}/structural/mrbias/t2_affine.nii.gz
if LWDP_needs_update_and_lock ${t2_affine_mrbias} ${t2_affine_denoised} ${t1_mrbias} ${t1_brainmask} ${t1_to_t2_affine}; then
  ants N4BiasFieldCorrection -i ${t2_affine_denoised} -x ${t1_brainmask} -o [${t2_affine_mrbias},${WORKDIR}/structural/mrbias/t2_affine_bias.nii.gz]
  LWDP_lockfile_delete ${t2_affine_mrbias}
fi
export t2_affine_mrbias=$(LWDP_get_override_file ${t2_affine_mrbias})

t2_affine_brain=${WORKDIR}/structural/stripped/t2_affine_brain.nii.gz
if LWDP_needs_update_and_lock ${t2_affine_brain} ${t2_affine_mrbias} ${t1_brainmask}; then
  c3d c3d ${t2_affine_mrbias} ${t1_brainmask} -multiply -o ${t2_affine_brain}
  LWDP_lockfile_delete ${t2_affine_brain}
fi
export t2_affine_brain=$(LWDP_get_override_file ${t2_affine_brain})

#
# 10 - Match intensity of follow-up toward baseline
#

if [ "${VISIT}" != "baseline" ]; then
  for tx in t1 t2 t2_affine; do
    tx_brain_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/stripped/${tx}_brain.nii.gz)
    tx_brain_reference=${WORKDIR}/structural/longitudinal/corrected/${tx}_brain_reference.nii.gz
    tx_brain_scale=${WORKDIR}/structural/longitudinal/corrected/${tx}_brain_scale.nii.gz
    tx_brain_corrected=${WORKDIR}/structural/longitudinal/corrected/${tx}_brain.nii.gz
    tx_brain=${WORKDIR}/structural/stripped/${tx}_brain.nii.gz
    smooth_width=3
  
    # Reformat baseline to this visit
    if LWDP_needs_update_and_lock ${tx_brain_reference} ${tx_brain_at_baseline} ${t1_mrbias} ${baseline_to_t1_affine} ${t1_to_baseline_warp}; then
      [ -d ${WORKDIR}/structural/longitudinal/corrected ] || mkdir -p ${WORKDIR}/structural/longitudinal/corrected

      ants antsApplyTransforms -i ${tx_brain_at_baseline} -r ${t1_mrbias} -o ${tx_brain_reference} -t [${baseline_to_t1_affine},1] ${t1_to_baseline_warp}
      c3d c3d ${tx_brain_reference} -type float -o ${tx_brain_reference}
      LWDP_lockfile_delete ${tx_brain_reference}
    fi
  
    if LWDP_needs_update_and_lock ${tx_brain_corrected} ${tx_brain_reference} ${tx_brain} ${t1_brainmask}; then
      tmpdir=$(mktemp -d)
      c3d c3d ${tx_brain_reference} -smooth ${smooth_width}mm -o ${tmpdir}/ref.nii.gz
      c3d c3d ${tx_brain} -smooth ${smooth_width}mm -o ${tmpdir}/img.nii.gz
      # need caution if use c3d: c3d A B -divide -o C computes C = B / A, not C = A / B
      fsl fslmaths ${tmpdir}/ref.nii.gz -div ${tmpdir}/img.nii.gz -mul ${t1_brainmask} ${tx_brain_scale}
      c3d c3d ${tx_brain} ${tx_brain_scale} -multiply -o ${tx_brain_corrected}
      rm -rf ${tmpdir}
      LWDP_lockfile_delete ${tx_brain_corrected}
    fi
  done

  t1_brain_corrected=${WORKDIR}/structural/longitudinal/corrected/t1_brain.nii.gz
  t2_brain_corrected=${WORKDIR}/structural/longitudinal/corrected/t2_brain.nii.gz
  t2_affine_brain_corrected=${WORKDIR}/structural/longitudinal/corrected/t2_affine_brain.nii.gz

  t1_brain=${t1_brain_corrected}
  export t1_brain=$(LWDP_get_override_file ${t1_brain_corrected})
  t2_brain=${t2_brain_corrected}
  export t2_brain=$(LWDP_get_override_file ${t2_brain_corrected})
  t2_affine_brain=${t2_affine_brain_corrected}
  export t2_affine_brain=$(LWDP_get_override_file ${t2_affine_brain_corrected})
fi

#
# (for testing) Match intensity of follow-up toward baseline (native image)
#

if [ "${VISIT}" != "baseline" ]; then
  [ -d ${WORKDIR}/structural/longitudinal/corrected/native ] || mkdir -p ${WORKDIR}/structural/longitudinal/corrected/native

  # Input 
  t1_at_baseline=${WORKDIR}/../baseline/structural/native/t1.nii.gz
  t1_brainmask_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/stripped/t1_brain_mask.nii.gz)

  # Output 
  t1_brain_reference=${WORKDIR}/structural/longitudinal/corrected/native/t1_brain_reference.nii.gz
  t1_brain_scale=${WORKDIR}/structural/longitudinal/corrected/native/t1_brain_scale.nii.gz
  t1_brain_corrected=${WORKDIR}/structural/longitudinal/corrected/native/t1_brain.nii.gz

  smooth_width=3

  # Reformat baseline t1 to this visit
  if LWDP_needs_update_and_lock ${t1_brain_reference} ${t1_at_baseline} ${t1_brainmask_at_baseline} ${t1_mrbias} ${baseline_to_t1_affine} ${t1_to_baseline_warp}; then
    tmpdir=$(mktemp -d)
    c3d c3d ${t1_at_baseline} ${t1_brainmask_at_baseline} -multiply -o ${tmpdir}/t1_brain.nii.gz
    ants antsApplyTransforms -i ${tmpdir}/t1_brain.nii.gz -r ${t1_mrbias} -o ${t1_brain_reference} -t [${baseline_to_t1_affine},1] ${t1_to_baseline_warp}
    c3d c3d ${t1_brain_reference} -type float -o ${t1_brain_reference}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${t1_brain_reference}
  fi

  if LWDP_needs_update_and_lock ${t1_brain_corrected} ${t1_brain_reference} ${t1_input} ${t1_brainmask}; then
    tmpdir=$(mktemp -d)
    c3d c3d ${t1_input} ${t1_brainmask} -multiply -o ${tmpdir}/inp.nii.gz
    c3d c3d ${t1_brain_reference} -smooth ${smooth_width}mm -o ${tmpdir}/ref.nii.gz
    c3d c3d ${tmpdir}/inp.nii.gz -smooth ${smooth_width}mm -o ${tmpdir}/img.nii.gz
    # need caution if use c3d: c3d A B -divide -o C computes C = B / A, not C = A / B
    fsl fslmaths ${tmpdir}/ref.nii.gz -div ${tmpdir}/img.nii.gz -mul ${t1_brainmask} ${t1_brain_scale}
    c3d c3d ${t1_brain} ${t1_brain_scale} -multiply -o ${t1_brain_corrected}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${t1_brain_corrected}
  fi
fi

#
# 11 - Main registration: baseline: align with SRI24, follow-ups: align with baseline
#

sri24_t1=${DATA_DIR}/sri24/sri24_t1.nii.gz
#mni_t1=${DATA_DIR}/mni/avg152T1_brain.nii.gz

if [ "${VISIT}" == "baseline" ]; then
  # Only align baseline with atlas directly
  t1_sri24_pfx=${WORKDIR}/structural/registration/t1_sri24/ants_
  t1_sri24_affine=${t1_sri24_pfx}0GenericAffine.mat
  if LWDP_needs_update_and_lock ${t1_sri24_affine} ${t1_brain} ${sri24_t1}; then
    tmpdir=$(mktemp -d)
    log_out=${t1_sri24_pfx}0GenericAffine.log

    for i in 1 2; do
      if [ "${i}" == "1" ]; then
        ants antsRegistration -d 3 -r [${t1_brain},${sri24_t1},0] -t Affine[0.1] -m MI[${t1_brain},${sri24_t1},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${t1_sri24_pfx} > ${log_out}
      elif [ "${i}" == "2" ]; then
        rm -f ${t1_sri24_affine}
        rm -f ${log_out}
        echo "INFO: ${WORKDIR}: attempt affine registration again by changing parameters"

        # apply histogram matching, clip intensity ranges, finer updates for inter-subject registrations
        ants antsRegistration -d 3 -u -w [0.005,0.995] -r [${t1_brain},${sri24_t1},0] -t Affine[0.001] -m MI[${t1_brain},${sri24_t1},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${t1_sri24_pfx} > ${log_out}
      fi

      # check registration result
      ants antsApplyTransforms -n NearestNeighbor -i ${sri24_brainmask} -r ${t1_brain} -o ${tmpdir}/sri24_brainmask_affine_${i}.nii.gz -t ${t1_sri24_affine}
      dice=`c3d c3d ${t1_brainmask} ${tmpdir}/sri24_brainmask_affine_${i}.nii.gz -overlap 1 | cut -d "," -f 5 | tr -d " "`
      echo "INFO: ${WORKDIR}: overlap between warped sri24 baseline mask and t1_brainmask: (dice = ${dice})"
      if [ $(echo "${dice} < 0.9" | bc) -eq 1 ]; then
        echo "WARNING: ${WORKDIR}: insufficient overlap between warped sri24 baseline mask and t1_brainmask (dice = ${dice} < 0.9)"
      else
        # stop here if we get a sufficient overlap
        echo "INFO: ${WORKDIR}: overlap is sufficient"
        break
      fi
    done

    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${t1_sri24_affine}
  fi
  export t1_sri24_affine=$(LWDP_get_override_file ${t1_sri24_affine})

  t1_sri24_warp=${t1_sri24_pfx}1Warp.nii.gz
  if LWDP_needs_update_and_lock ${t1_sri24_warp} ${t1_brain} ${sri24_t1}; then
    log_out=${t1_sri24_pfx}1Warp.log
    ants antsRegistration -d 3 --initial-moving-transform ${t1_sri24_affine} -t SyN[0.5,3,0.5] -m CC[${t1_brain},${sri24_t1},1,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${t1_sri24_pfx} > ${log_out}
    LWDP_lockfile_delete ${t1_sri24_warp}
  fi
  t1_sri24_warp=$(LWDP_get_override_file ${t1_sri24_warp})
  
  sri24_t1_warp=${t1_sri24_pfx}1InverseWarp.nii.gz
  export sri24_t1_warp=$(LWDP_get_override_file ${sri24_t1_warp})

  export t1_sri24_mtx=$(LWDP_get_override_files_list ${t1_sri24_warp} ${t1_sri24_affine})

  ## registers t1 to mni atlas  .... ReferenceImage [FloatingImage] as we only need it for registering all cases to template - also atlas is over lower resolution so bad idea to register atlas to t1 !
  #mni_t1_pfx=${WORKDIR}/structural/registration/mni_t1/ants_
  #mni_t1_affine=${mni_t1_pfx}0GenericAffine.mat
  #if LWDP_needs_update_and_lock ${mni_t1_affine} ${t1_brain} ${mni_t1}; then
  #  log_out=${mni_t1_pfx}0GenericAffine.log
  #  ants antsRegistration -d 3 -r [${mni_t1},${t1_brain},0] -t Affine[0.1] -m MI[${mni_t1},${t1_brain},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${mni_t1_pfx} > ${log_out}
  #  LWDP_lockfile_delete ${mni_t1_affine}
  #fi
  #export mni_t1_affine=$(LWDP_get_override_file ${mni_t1_affine})

  #mni_t1_warp=${mni_t1_pfx}1Warp.nii.gz 
  ##if LWDP_needs_update_and_lock ${mni_t1_warp} ${mni_t1_affine} ${mni_t1} ${t1_brain}; then
  #if LWDP_needs_update_and_lock ${mni_t1_warp} ${mni_t1} ${t1_brain}; then
  #  log_out=${mni_t1_pfx}1Warp.log
  #  ants antsRegistration -d 3 --initial-moving-transform ${mni_t1_affine} -t SyN[0.5,3,0.5] -m CC[${mni_t1},${t1_brain},1,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${mni_t1_pfx} > ${log_out}
  #  LWDP_lockfile_delete ${mni_t1_warp}
  #fi
  #export mni_t1_warp=$(LWDP_get_override_file ${mni_t1_warp})

  ## reslice for quality control
  #t1_aligned_to_mni=${WORKDIR}/structural/reslice/mni/affine/t1_brain.nii.gz
  #if LWDP_needs_update_and_lock ${t1_aligned_to_mni} ${t1_brain} ${mni_t1} ${mni_t1_affine}; then
  #  ants antsApplyTransforms -i ${t1_brain} -r ${mni_t1} -o ${t1_aligned_to_mni} -t ${mni_t1_affine}
  #  c3d c3d ${t1_aligned_to_mni} -type float -o ${t1_aligned_to_mni}
  #  LWDP_lockfile_delete ${t1_aligned_to_mni}
  #fi
  #t1_aligned_to_mni=${WORKDIR}/structural/reslice/mni/warp/t1_brain.nii.gz
  #if LWDP_needs_update_and_lock ${t1_aligned_to_mni} ${t1_brain} ${mni_t1} ${mni_t1_warp} ${mni_t1_affine}; then
  #  ants antsApplyTransforms -i ${t1_brain} -r ${mni_t1} -o ${t1_aligned_to_mni} -t ${mni_t1_warp} ${mni_t1_affine}
  #  c3d c3d ${t1_aligned_to_mni} -type float -o ${t1_aligned_to_mni}
  #  LWDP_lockfile_delete ${t1_aligned_to_mni}
  #fi
else
  [ -d ${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline ] || mkdir -p ${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline

  # align with baseline t1
  t1_brain_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/stripped/t1_brain.nii.gz)

  t1_brain_to_baseline_pfx=${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline/ants_
  t1_brain_to_baseline_affine=${t1_brain_to_baseline_pfx}0GenericAffine.mat
  if LWDP_needs_update_and_lock ${t1_brain_to_baseline_affine} ${t1_brain} ${t1_brain_at_baseline}; then
    log_out=${t1_brain_to_baseline_pfx}0GenericAffine.log
    ants antsRegistration -d 3 -r [${t1_brain},${t1_brain_at_baseline},1] -t Rigid[0.1] -m MI[${t1_brain},${t1_brain_at_baseline},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${t1_brain},${t1_brain_at_baseline},1,32,Regular,0.25] -c [1000x500x250x100, 1e-6, 10] -f 8x4x2x1 -s 3x2x1x0vox -o ${t1_brain_to_baseline_pfx} > ${log_out}
    LWDP_lockfile_delete ${t1_brain_to_baseline_affine}
  fi
  t1_brain_to_baseline_affine=$(LWDP_get_override_file ${t1_brain_to_baseline_affine})

  t1_brain_to_baseline_warp=${t1_brain_to_baseline_pfx}1Warp.nii.gz
  if LWDP_needs_update_and_lock ${t1_brain_to_baseline_warp} ${t1_brain} ${t1_brain_at_baseline}; then
    log_out=${t1_brain_to_baseline_pfx}1Warp.log
    ants antsRegistration -d 3 --initial-moving-transform ${t1_brain_to_baseline_affine} -t SyN[0.5,3,0.5] -m CC[${t1_brain},${t1_brain_at_baseline},1,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${t1_brain_to_baseline_pfx} > ${log_out}
    #touch -r ${log_out} ${t1_brain_to_baseline_warp}
    LWDP_lockfile_delete ${t1_brain_to_baseline_warp}
  fi
  export t1_brain_to_baseline_warp=$(LWDP_get_override_file ${t1_brain_to_baseline_warp})

  baseline_to_t1_brain_warp=${t1_brain_to_baseline_pfx}1InverseWarp.nii.gz
  export baseline_to_t1_brain_warp=$(LWDP_get_override_file ${baseline_to_t1_brain_warp})

  # for follow-ups, the transformation from visit T1w to SRI24 is a concantenation of two transformations: T1w to baseline, baseline T1w to atlas
  # ants applies transformations from the last one to the first one: baseline->sri24 (affine), baseline->sri24 (warp), t1->baseline (affine), t1->baseline (warp)
  export t1_sri24_mtx=$(LWDP_get_override_files_list ${t1_brain_to_baseline_warp} ${t1_brain_to_baseline_affine} ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_1Warp.nii.gz ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_0GenericAffine.mat)
fi

