#    ${NCANDA_SOURCE_DIR}/utils/turn_restingstate_stats_into_csv art $WORKDIR ${art_outliers} ${art_outliers_csv} 
#    LWDP_lockfile_delete ${art_outliers_csv}
#fi

# update below with the 2mm_epi 
exit 0 
  #
  # Step E: Compute Region-To-Voxel Correlation Map   
  #

atlas_sri24_2mm_roi_dir=${DATA_DIR}/sri24/restingstate/2mm
corr_dir=${RESTING_DIR}/correlation/sri24_2mm

# making hrf weight file
hrf_weight=${corr_dir}/hrf_weight.txt
if LWDP_needs_update_and_lock ${hrf_weight} ${bold_aligned_to_sri24_2mm}; then
  nscans=`fsl fslval ${bold_aligned_to_sri24_2mm} dim4 | tr -d " "`
  CMD="${NCANDA_SOURCE_DIR}/utils/rsfmri_compute_hrf_weight -n ${nscans} -t ${bold_tr_sec} -o ${hrf_weight}"
  log_and_execute "$CMD" ${hrf_weight}
  LWDP_lockfile_delete ${hrf_weight}
fi

for roimap in ACC Amygdala Calcarine Heschl Midbrain NAcc PCC Postcentral SFG SPL Thalamus_L Thalamus_R; do 
  ROI=${atlas_sri24_2mm_roi_dir}/sri24_${roimap}.nii.gz
  out=${corr_dir}/sri24_${roimap}_roi2vox_corr.nii.gz
  if LWDP_needs_update_and_lock ${out} ${bold_aligned_to_sri24_2mm} ${ROI} ${hrf_weight}; then
    CMD="${NCANDA_SOURCE_DIR}/utils/rsfmri_regional_correlation -t roi2vox -c normal -b ${bold_aligned_to_sri24_2mm} -l ${ROI} -w ${hrf_weight} -o ${corr_dir}"
    log_and_execute "$CMD" ${out}
    LWDP_lockfile_delete ${out}
  fi
done 

exit 0

#
# reslice freesurfer segmentations
#

if [ "${VISIT}" == "baseline" ]; then
  sri24_padded_to_t1_rigid=${WORKDIR}/structural/registration/sri24_padded_to_t1/ants_rigid_0GenericAffine.mat 
else
  sri24_padded_to_t1_rigid=${WORKDIR}/structural/longitudinal/registration/baseline_sri24_padded_to_t1/ants_rigid_0GenericAffine.mat
fi

freesurfer_seg_mgz=${WORKDIR}/structural/freesurfer/${SUBJECT}_${ARM}_${VISIT}/mri/aparc+aseg.mgz
freesurfer_rawavg_mgz=${WORKDIR}/structural/freesurfer/${SUBJECT}_${ARM}_${VISIT}/mri/rawavg.mgz
freesurfer_seg_aligned_to_t1=${RESTING_DIR}/reslice/subject_t1/aparc+aseg.nii.gz
if LWDP_needs_update_and_lock ${freesurfer_seg_aligned_to_t1} ${freesurfer_seg_mgz} ${freesurfer_rawavg_mgz}; then
  mri_label2vol --seg ${freesurfer_seg_mgz} --temp ${freesurfer_rawavg_mgz} --o ${freesurfer_seg_aligned_to_t1} --regheader ${freesurfer_seg_mgz}
  LWDP_lockfile_delete ${freesurfer_seg_aligned_to_t1}
fi
freesurfer_seg=${RESTING_DIR}/reslice/bold/aparc+aseg.nii.gz
if LWDP_needs_update_and_lock ${freesurfer_seg} ${freesurfer_seg_aligned_to_t1} ${bold_mean} ${fieldmap_to_bold_affine_tfm} ${fieldmap_to_t1_affine}; then
  ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${freesurfer_seg_aligned_to_t1} -r ${bold_mean} -o ${freesurfer_seg} -t [${fieldmap_to_bold_affine_tfm},1] ${fieldmap_to_t1_affine}
  c3d c3d ${freesurfer_seg} -type short -o ${freesurfer_seg}
  LWDP_lockfile_delete ${freesurfer_seg}
fi
sri24_padded_suit_seg=${WORKDIR}/structural/reslice/sri24_padded/Cerebellum-SUIT.nii.gz
suit_seg_aligned_to_t1=${RESTING_DIR}/${branch}/reslice/subject_t1/Cerebellum-SUIT.nii.gz
if LWDP_needs_update_and_lock ${suit_seg_aligned_to_t1} ${sri24_padded_suit_seg} ${t1_mrbias} ${sri24_padded_to_t1_rigid}; then
  ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${sri24_padded_suit_seg} -r ${t1_mrbias} -o ${suit_seg_aligned_to_t1} -t [${sri24_padded_to_t1_rigid},1]
  c3d c3d ${suit_seg_aligned_to_t1} -type short -o ${suit_seg_aligned_to_t1}
  LWDP_lockfile_delete ${suit_seg_aligned_to_t1}
fi
suit_seg=${DIFFUSION_DIR}/${branch}/reslice/bold/Cerebellum-SUIT.nii.gz
if LWDP_needs_update_and_lock ${suit_seg} ${sri24_padded_suit_seg} ${bold_mean}  ${fieldmap_to_bold_affine_tfm} ${fieldmap_to_t1_affine}; then
  ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${sri24_padded_suit_seg} -r ${bold_mean} -o ${suit_seg} -t  [${fieldmap_to_bold_affine_tfm},1] ${fieldmap_to_t1_affine}
  c3d c3d ${suit_seg} -type short -o ${suit_seg}
  LWDP_lockfile_delete ${suit_seg}
fi
suit_seg_600=${DIFFUSION_DIR}/${branch}/reslice/bold/Cerebellum-SUIT_600.nii.gz
if LWDP_needs_update_and_lock ${suit_seg_600} ${suit_seg}; then
  c3d c3d ${suit_seg} -shift 600 -replace 600 0 -o ${suit_seg_600}
  LWDP_lockfile_delete ${suit_seg_600}
fi
label[0]=${DATA_DIR}/freesurfer/FreeSurferColorLUT_Connectivity.txt
label[1]=${DATA_DIR}/freesurfer/FreeSurferColorLUT_WM.txt
label[2]=${DATA_DIR}/freesurfer/FreeSurferColorLUT_Ventricles.txt
label[3]=${DATA_DIR}/freesurfer/FreeSurferColorLUT_Connectivity_SUIT.txt
label[4]=${DATA_DIR}/freesurfer/FreeSurferColorLUT_WM_SUIT.txt
input[0]=${RESTING_DIR}/reslice/bold/aparc+aseg.nii.gz
input[1]=${RESTING_DIR}/reslice/bold/aparc+aseg.nii.gz
input[2]=${RESTING_DIR}/reslice/bold/aparc+aseg.nii.gz
input[3]=${RESTING_DIR}/reslice/bold/Cerebellum-SUIT_600.nii.gz
input[4]=${RESTING_DIR}/reslice/bold/Cerebellum-SUIT_600.nii.gz
output[0]=${RESTING_DIR}/reslice/bold/aparc+aseg_conn.nii.gz
output[1]=${RESTING_DIR}/reslice/bold/aparc+aseg_wm.nii.gz
output[2]=${RESTING_DIR}/reslice/bold/aparc+aseg_ventricles.nii.gz
output[3]=${RESTING_DIR}/reslice/bold/Cerebellum-SUIT_600_conn.nii.gz
output[4]=${RESTING_DIR}/reslice/bold/Cerebellum-SUIT_600_wm.nii.gz
output2[0]=${RESTING_DIR}/reslice/bold/aparc+aseg_conn_bin.nii.gz
output2[1]=${RESTING_DIR}/reslice/bold/aparc+aseg_wm_bin.nii.gz
output2[2]=${RESTING_DIR}/reslice/bold/aparc+aseg_ventricles_bin.nii.gz
output2[3]=${RESTING_DIR}/reslice/bold/Cerebellum-SUIT_600_conn_bin.nii.gz
output2[4]=${RESTING_DIR}/reslice/bold/Cerebellum-SUIT_600_wm_bin.nii.gz
for idx in 0 1 2 3 4; do
  if LWDP_needs_update_and_lock ${output[${idx}]} ${intput[${idx}]} ${label[${idx}]}; then
    tmpdir=$(mktemp -d)
    label_set=`cat ${label[${idx}]} | cut -d " " -f1`
    replace_txt=
    for l in ${label_set}; do
      replace_txt="${replace_txt} ${l} 100000"
    done
    c3d c3d ${input[${idx}]} -replace ${replace_txt} -thresh 100000 inf 1 0 -type short -o ${tmpdir}/tmp_bin.nii.gz
    c3d c3d ${input[${idx}]} ${tmpdir}/tmp_bin.nii.gz -multiply -o ${output[${idx}]}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${output[${idx}]}
  fi
  if LWDP_needs_update_and_lock ${output2[${idx}]} ${output[${idx}]}; then
    c3d c3d ${output[${idx}]} -thresh 1 inf 1 0 -o ${output2[${idx}]}
    LWDP_lockfile_delete ${output2[${idx}]}
  fi
done
# merge SUIT conn labels
suit_conn_map=${DIFFUSION_DIR}/${branch}/reslice/bold/Cerebellum-SUIT_600_conn.nii.gz
suit_conn_map_merged=${DIFFUSION_DIR}/${branch}/reslice/bold/Cerebellum-SUIT_600_conn_merged.nii.gz
if LWDP_needs_update_and_lock ${suit_conn_map_merged} ${suit_conn_map}; then
  c3d c3d ${suit_conn_map} -replace 603 601 602 601 604 601 608 605 611 605 614 605 609 606 612 606 615 606 610 607 613 607 616 607 620 617 623 617 626 617 621 618 624 618 627 618 622 619 625 619 628 619 -o ${suit_conn_map_merged}
  LWDP_lockfile_delete ${suit_conn_map_merged}
fi
# merge freesurfer and SUIT rois
freesurfer_map=${DIFFUSION_DIR}/${branch}/reslice/bold/aparc+aseg.nii.gz
freesurfer_conn_map=${DIFFUSION_DIR}/${branch}/reslice/bold/aparc+aseg_conn.nii.gz
freesurfer_wm_map_bin=${DIFFUSION_DIR}/${branch}/reslice/bold/aparc+aseg_wm_bin.nii.gz
label_conn_map=${DIFFUSION_DIR}/${branch}/reslice/bold/aparc+aseg_SUIT_conn.nii.gz
if LWDP_needs_update_and_lock ${label_conn_map} ${freesurfer_map} ${freesurfer_wm_map_bin} ${freesurfer_conn_map} ${suit_conn_map_merged}; then
  tmpdir=$(mktemp -d)
  c3d c3d ${freesurfer_map} -thresh 1 inf 1 0 -o ${tmpdir}/mask1.nii.gz
  c3d c3d ${freesurfer_wm_map_bin} -scale -1 -shift 1 -o ${tmpdir}/mask2.nii.gz
  c3d c3d ${suit_conn_map_merged} ${tmpdir}/mask1.nii.gz -multiply ${tmpdir}/mask2.nii.gz -multiply -o ${tmpdir}/suit_conn.nii.gz
  c3d c3d ${freesurfer_conn_map} ${tmpdir}/suit_conn.nii.gz -add -type short -o ${label_conn_map}
  rm -rf ${tmpdir}
  LWDP_lockfile_delete ${label_conn_map}
fi
freesurfer_wm_map_bin=${DIFFUSION_DIR}/${branch}/reslice/bold/aparc+aseg_wm_bin.nii.gz
suit_wm_map_bin=${DIFFUSION_DIR}/${branch}/reslice/bold/Cerebellum-SUIT_600_wm_bin.nii.gz
label_wm_map_bin=${DIFFUSION_DIR}/${branch}/reslice/bold/aparc+aseg_SUIT_wm_bin.nii.gz
if LWDP_needs_update_and_lock ${label_wm_map_bin} ${freesurfer_wm_map_bin} ${label_conn_map} ${suit_wm_map_bin}; then
  tmpdir=$(mktemp -d)
  c3d c3d ${label_conn_map} -thresh 1 inf 1 0 -scale -1 -shift 1 -o ${tmpdir}/mask.nii.gz
  c3d c3d ${freesurfer_wm_map_bin} ${suit_wm_map_bin} -add -thresh 1 inf 1 0 ${tmpdir}/mask.nii.gz -multiply -o ${label_wm_map_bin}
  rm -rf ${tmpdir}
  LWDP_lockfile_delete ${label_wm_map_bin}
fi

