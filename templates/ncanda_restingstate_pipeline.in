#
# better correlation computations
#

# roimap="t1_gm_parc"
# Problem with the following roimap is that regions might disappear - hard to do group analysis 
# parcellation=${WORKDIR}/structural/reslice/sri24_2mm/warp/atropos/${roimap}.nii.gz
# so we use a standard atlas (might introduce more noise in measurements)

for PARC in parc116 parc215; do
    parcellation=${DATA_DIR}/sri24/parcellation/2mm/sri24_${PARC}_gm.nii.gz
    roiCorrelationPrefix=${WORKDIR}/restingstate/correlation/sri24_2mm_epi/sri24_${PARC}_gm
    roiCorrelations=${roiCorrelationPrefix}-correlations.txt
    if LWDP_needs_update_and_lock ${roiCorrelations} ${bold_aligned_to_sri24_2mm_epi} ${parcellation} ; then
	tmp=$(mktemp -d)
	fsl fslsplit ${bold_aligned_to_sri24_2mm_epi} ${tmp}/bold- -t
	CMD="${NCANDA_SOURCE_DIR}/utils/rsfmri_regional_correlation --bold_prefix ${tmp}/bold- --parcellation ${parcellation} --output_prefix ${roiCorrelationPrefix}"
	log_and_execute "$CMD" ${roiCorrelations}
	rm -rf ${tmp}
	LWDP_lockfile_delete ${roiCorrelations}
    fi

    sri24_roi2roi_pattern=${RESTING_DIR}/measures/sri24_epi/sri24_${PARC}_gm_roi2roi
    for TYPE in correlations partial_correlations; do
	roiCorrelations=${roiCorrelationPrefix}-${TYPE}.txt
	sri24_roi2roi_measures=${RESTING_DIR}/measures/sri24_epi/sri24_${PARC}_gm_roi2roi_${TYPE}.csv 
	ATLAS_PREFIX=${DATA_DIR}/sri24/parcellation/2mm/sri24_${PARC}_gm
	if LWDP_needs_update_and_lock ${sri24_roi2roi_measures} ${ATLAS_PREFIX}.csv ${ATLAS_PREFIX}_roi2roi.csv  ${roiCorrelations}; then
	    ${NCANDA_SOURCE_DIR}/utils/turn_restingstate_stats_into_csv cor $WORKDIR ${roiCorrelations} ${sri24_roi2roi_measures} ${ATLAS_PREFIX} 
	    LWDP_lockfile_delete ${sri24_roi2roi_measures}
	fi
    done
done

#
# qc() 
#

MOTION_PFX=${RESTING_DIR}/bold/2_motion_corrected/bold_mcf
MOTION_PRF=${MOTION_PFX}_motion
MOTION_AVG=${MOTION_PRF}.avg
if LWDP_needs_update_and_lock ${MOTION_AVG} ${t1_brainmask_aligned_to_bold} ${MOTION_PFX}.mat/MAT_0000; then 
    ${NCANDA_SOURCE_DIR}/utils/rsfmri_compute_motion.py -ma ${t1_brainmask_aligned_to_bold} -mo ${MOTION_PFX}.mat -o ${MOTION_PRF}
    LWDP_lockfile_delete ${MOTION_AVG}
fi

QC_CSV=${RESTING_DIR}/measures/rs_qa.csv
BOLD_XML=$FMRI_DIR/bold-001.nii.xml    
if LWDP_needs_update_and_lock ${QC_CSV} ${BOLD_XML} ${art_outliers} $MOTION_AVG; then	
    echo "subject,arm,visit,num_usable,rt,usable_time,avg_motion" > $QC_CSV
    NUM_SCAN=`ls -1 ${FMRI_DIR}/bold-*.nii.gz | wc -l`
    NUM_FAIL=`cat ${art_outliers} | wc -l`
    NUM_GOOD="$(($NUM_SCAN-$NUM_FAIL))"
    RT=`grep RepetitionTime $BOLD_XML | cut -d'>' -f2 | cut -d'.' -f1`
    TIME=`echo "scale=1;$NUM_GOOD * $bold_tr_sec" | bc`
    MOTION=`cat ${MOTION_AVG}`
    echo "$SUBJECT,$ARM,$VISIT,$NUM_GOOD,$RT,$TIME,`printf '%.4f\n' $MOTION`" >> $QC_CSV
    LWDP_lockfile_delete ${QC_CSV}
fi

