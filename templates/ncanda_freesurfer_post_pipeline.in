NCANDA_BINARY_DIR=@NCANDA_BINARY_DIR_CONFIG@
DATA_DIR=@DATA_DIR_CONFIG@
TEMPLATE_DIR=@TEMPLATE_DIR_CONFIG@
 
source ${NCANDA_BINARY_DIR}/ncanda_setup.sh $*

#
# Script copmutes myelin scores and algins to HCP atlas 
#

#--------------------------------------
#
# Myelin computation in SRI24 space 
# (moved from ncanda_structural_reformat_to_template.in as it has to be executed after freesurfer !)
#
#--------------------------------------
inp[11]=${WORKDIR}/structural/denoised/t1.nii.gz
out[11]=${WORKDIR}/structural/reslice/sri24/warp/t1_denoised_brain.nii.gz

# Because of this input it has to be executed after freesurfer
inp[12]=${WORKDIR}/structural/denoised/t2_affine_refined.nii.gz
out[12]=${WORKDIR}/structural/reslice/sri24/warp/t2_affine_refined_denoised_brain.nii.gz

atlas_mr=${DATA_DIR}/sri24/sri24_t1.nii.gz

t1_sri24_affine=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_0GenericAffine.mat)
t1_sri24_warp=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_1Warp.nii.gz)
t1_sri24_mtx="${t1_sri24_warp} ${t1_sri24_affine}"

for i in 11 12; do
    if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${atlas_mr} ${t1_sri24_mtx} ${out[1]}; then
        ants antsApplyTransforms -n BlackmanWindowedSinc -i ${inp[${i}]} -r ${atlas_mr} -o ${out[${i}]} -t ${sri24_t1_mtx}
        c3d c3d ${out[${i}]} ${out[1]} -multiply -clip 0 inf -type float -o ${out[${i}]}
        LWDP_lockfile_delete ${out[${i}]}
    fi
done


inp[13]=${WORKDIR}/structural/reslice/subject_t1/t2_affine_refined_brain_exp_mask.nii.gz
out[13]=${WORKDIR}/structural/reslice/sri24/warp/t2_affine_refined_brain_exp_mask.nii.gz
for i in 13; do
    if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]} ${atlas_mr} ${t1_sri24_mtx}; then
        ants antsApplyTransforms -n NearestNeighbor -i ${inp[${i}]} -r ${atlas_mr} -o ${out[${i}]} -t ${sri24_t1_mtx}
        c3d c3d ${out[${i}]} -type uchar -o ${out[${i}]}
        LWDP_lockfile_delete ${out[${i}]}
    fi
done 

t1_aligned_to_sri24=${out[11]}
t2_aligned_to_sri24=${out[12]}
t1_div_t2=${WORKDIR}/structural/reslice/sri24/warp/t1_div_t2.nii.gz
if LWDP_needs_update_and_lock ${t1_div_t2} ${t1_aligned_to_sri24} ${t2_aligned_to_sri24}; then
    tmpdir=$(mktemp -d)
    # sometimes wb_command -volume-math failed due to header mismatch, so match headers first
    cp ${t1_aligned_to_sri24} ${tmpdir}/t1.nii.gz
    cp ${t2_aligned_to_sri24} ${tmpdir}/t2.nii.gz
    fsl fslcpgeom ${t1_aligned_to_sri24} ${tmpdir}/t2.nii.gz
    #
    caret7 wb_command -volume-math "clamp((T1w/T2w),0,100)" ${t1_div_t2} -var T1w ${tmpdir}/t1.nii.gz -var T2w ${tmpdir}/t2.nii.gz -fixnan 0
    caret7 wb_command -volume-palette ${t1_div_t2} MODE_AUTO_SCALE_PERCENTAGE -pos-percent 4 96 -interpolate true -palette-name videen_style -disp-pos true -disp-neg false -disp-zero false
    #
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${t1_div_t2}
fi
if [ ! -e ${t1_div_t2} ]; then
    echo "ERROR: failed generating ${t1_div_t2}"
else 
    t2_mask_aligned_to_sri24=${out[13]}
    t1_div_t2_masked=${WORKDIR}/structural/reslice/sri24/warp/t1_div_t2_masked.nii.gz
    if LWDP_needs_update_and_lock ${t1_div_t2_masked} ${t1_div_t2} ${t2_mask_aligned_to_sri24}; then
      caret7 wb_command -volume-math "clamp((VAL*MASK),0,20)" ${t1_div_t2_masked} -var VAL ${t1_div_t2} -var MASK ${t2_mask_aligned_to_sri24} -fixnan 0
      caret7 wb_command -volume-palette ${t1_div_t2_masked} MODE_AUTO_SCALE_PERCENTAGE -pos-percent 4 96 -interpolate true -palette-name videen_style -disp-pos true -disp-neg false -disp-zero false
      LWDP_lockfile_delete ${t1_div_t2_masked}
    fi

    # for testing
    t1_div_t2_ref=${DATA_DIR}/sri24/sri24_t1_div_t2_HCP1200.nii.gz
    t1_div_t2_bc=${WORKDIR}/structural/reslice/sri24/warp/t1_div_t2_bc.nii.gz
    t1_div_t2_bias=${WORKDIR}/structural/reslice/sri24/warp/t1_div_t2_bias.nii.gz
    if [ -e "${t1_div_t2_ref}" ] && LWDP_needs_update_and_lock ${t1_div_t2_bc} ${t1_div_t2_masked} ${t1_div_t2_ref} ${t2_mask_aligned_to_sri24}; then
      tmpdir=$(mktemp -d)
      #tmpdir=${WORKDIR}/structural/reslice/${atlas_type[${index}]}/warp/tmp
      #mkdir -p ${tmpdir}
      CorrectionSigma=`echo "sqrt ( 200 )" | bc -l`
      caret7 wb_command -volume-smoothing ${t1_div_t2_masked} ${CorrectionSigma} ${tmpdir}/t1_div_t2_masked.nii.gz -roi ${t2_mask_aligned_to_sri24}
      caret7 wb_command -volume-smoothing ${t1_div_t2_ref} ${CorrectionSigma} ${tmpdir}/t1_div_t2_ref.nii.gz -roi ${t2_mask_aligned_to_sri24}
      caret7 wb_command -volume-math "((Individual-Reference)*Mask)" ${t1_div_t2_bias} -var Individual ${tmpdir}/t1_div_t2_masked.nii.gz -var Reference ${tmpdir}/t1_div_t2_ref.nii.gz -var Mask ${t2_mask_aligned_to_sri24}
      caret7 wb_command -volume-math "((Individual-Bias)*Mask)" ${t1_div_t2_bc} -var Individual ${t1_div_t2_masked} -var Bias ${t1_div_t2_bias} -var Mask ${t2_mask_aligned_to_sri24}
      caret7 wb_command -volume-palette ${t1_div_t2_bc} MODE_AUTO_SCALE_PERCENTAGE -pos-percent 4 96 -interpolate true -palette-name videen_style -disp-pos true -disp-neg false -disp-zero false
      rm -rf ${tmpdir}
      LWDP_lockfile_delete ${t1_div_t2_bc}
    fi
fi
exit 0 
#--------------------------------------
#
# Alignment of freesurfer results to HCP 
#
#--------------------------------------

#
# prepare reorient images
#

inp[1]=$(LWDP_get_override_file ${WORKDIR}/structural/mrbias/t1.nii.gz)
inp[2]=$(LWDP_get_override_file ${WORKDIR}/structural/mrbias/t2_affine_refined.nii.gz)

if [ ! -f ${inp[1]} -o ! -f ${inp[2]} ]; then
  MSG="ERROR: missing or incomplete structural data: ${WORKDIR}"
  echo "${MSG}"
  #echo "${MSG}" | ncanda_error_email $(basename $0)
  exit 1
fi

if [ "${VISIT}" == "baseline" ]; then
  inp[3]=$(LWDP_get_override_file ${WORKDIR}/structural/stripped/t1_brain.nii.gz)
else
  inp[3]=$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/corrected/t1_brain.nii.gz)
fi
inp[4]=$(LWDP_get_override_file ${WORKDIR}/structural/denoised/t1.nii.gz)
inp[5]=$(LWDP_get_override_file ${WORKDIR}/structural/denoised/t2_affine_refined.nii.gz)
inp[6]=$(LWDP_get_override_file ${WORKDIR}/structural/stripped/t1_brain_mask.nii.gz)
inp[7]=$(LWDP_get_override_file ${WORKDIR}/structural/reslice/subject_t1/t2_affine_refined_brain_mask.nii.gz)
inp[8]=$(LWDP_get_override_file ${WORKDIR}/structural/segment/subject_t1/atropos/t1_seg.nii.gz)
out[1]=${WORKDIR}/structural/hcp/hcp_t1/t1_mrbias.nii.gz
out[2]=${WORKDIR}/structural/hcp/hcp_t1/t2_mrbias.nii.gz
out[3]=${WORKDIR}/structural/hcp/hcp_t1/t1_mrbias_brain.nii.gz
out[4]=${WORKDIR}/structural/hcp/hcp_t1/t1_denoised.nii.gz
out[5]=${WORKDIR}/structural/hcp/hcp_t1/t2_denoised.nii.gz
out[6]=${WORKDIR}/structural/hcp/hcp_t1/t1_brain_mask.nii.gz
out[7]=${WORKDIR}/structural/hcp/hcp_t1/t2_refined_brain_mask.nii.gz
out[8]=${WORKDIR}/structural/hcp/hcp_t1/t1_seg.nii.gz
for i in 1 2 3 4 5 6 7 8; do
  if LWDP_needs_update_and_lock ${out[${i}]} ${inp[${i}]}; then
    # adopted from fslreorient2std procedure
    prefix=`echo ${out[${i}]} | rev | cut -d . -f3- | rev`
    scode=`fsl fslval ${inp[${i}]} sform_code | tr -d " "`
    qcode=`fsl fslval ${inp[${i}]} qform_code | tr -d " "`
    if [ "${scode}" == "0" -a "${qcode}" == "0" ]; then
      echo "ERROR: Orientation information not stored in ${inp[${i}]}!"
      exit 1
    fi
    pattern=sto_xyz
    if [ "${scode}" == "0" ]; then
      pattern=qto_xyz
    fi
    fsl fslhd ${inp[${i}]} | grep ${pattern} | awk '{ print $2 " " $3 " " $4 " " $5  }' > ${prefix}.mat
    det=`fsl avscale ${prefix}.mat | grep Determinant | awk '{ print $3 }'`
    echo "# Determinant: ${det}" > ${prefix}.log
    if [ X`echo "if ( $det < 0 ) { 1 }" | bc -l` = X1 ]; then
      # radiological case (negative determinant)
      echo "fsl fslswapdim ${inp[${i}]} RL PA IS ${out[${i}]}" >> ${prefix}.log
      fsl fslswapdim ${inp[${i}]} RL PA IS ${out[${i}]}
    else
      echo "fsl fslswapdim ${inp[${i}]} LR PA IS ${out[${i}]}" >> ${prefix}.log
      fsl fslswapdim ${inp[${i}]} LR PA IS ${out[${i}]}
    fi
    LWDP_lockfile_delete ${out[${i}]}
  fi
done
hcp_t1_mrbias=${out[1]}
hcp_t2_mrbias=${out[2]}
hcp_t1_brain=${out[3]}
hcp_t1_denoised=${out[4]}
hcp_t2_denoised=${out[5]}
hcp_t1_brainmask=${out[6]}
hcp_t2_brain_mask=${out[7]}
hcp_t1_seg=${out[8]}

#
# for baseline, align hcp t1 with hcp mni atlas
#

hcp_mni_atlas_t1=${DATA_DIR}/hcp/templates/MNI152_T1_1mm.nii.gz
#hcp_mni_atlas_t1_brain=${DATA_DIR}/hcp/templates/MNI152_T1_1mm_brain.nii.gz
hcp_mni_atlas_t1_brain=${DATA_DIR}/hcp/templates/MNI152_T1_1mm_brain_compact.nii.gz
hcp_mni_atlas_t1_brain_mask=${DATA_DIR}/hcp/templates/MNI152_T1_1mm_brain_compact_mask.nii.gz

if [ "${VISIT}" == "baseline" ]; then
  # Only align baseline with atlas directly
  hcp_t1_hcp_mni_pfx=${WORKDIR}/structural/registration/hcp_t1_hcp_mni/ants_
  hcp_t1_hcp_mni_affine=${hcp_t1_hcp_mni_pfx}0GenericAffine.mat
  if LWDP_needs_update_and_lock ${hcp_t1_hcp_mni_affine} ${hcp_t1_brain} ${hcp_mni_atlas_t1_brain}; then
    tmpdir=$(mktemp -d)
    log_out=${hcp_t1_hcp_mni_pfx}0GenericAffine.log

    for i in 1 2; do
      if [ "${i}" == "1" ]; then
        ants antsRegistration -d 3 -u -w [0.005,0.995] -r [${hcp_t1_brain},${hcp_mni_atlas_t1_brain},0] -t Affine[0.001] -m MI[${hcp_t1_brain},${hcp_mni_atlas_t1_brain},1,32,Regular,0.25] -c [1000x500x250x100,1e-6,10] -f 8x4x2x1 -s 3x2x1x0vox -o ${hcp_t1_hcp_mni_pfx} > ${log_out}
      elif [ "${i}" == "2" ]; then
        rm -f ${hcp_t1_hcp_mni_affine}
        rm -f ${log_out}
        echo "INFO: attempt affine registration again by changing parameters"

        ants antsRegistration -d 3 -u -w [0.005,0.995] -r [${hcp_t1_brain},${hcp_mni_atlas_t1_brain},0] -t Rigid[0.001] -m MI[${hcp_t1_brain},${hcp_mni_atlas_t1_brain},1,32,Regular,0.25] -c [1000x500x250x100,1e-6,10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.001] -m MI[${hcp_t1_brain},${hcp_mni_atlas_t1_brain},1,32,Regular,0.25] -c [1000x500x250x100,1e-6,10] -f 8x4x2x1 -s 3x2x1x0vox -o ${hcp_t1_hcp_mni_pfx} > ${log_out}
      fi

      # check registration result
      ants antsApplyTransforms -n NearestNeighbor -i ${hcp_mni_atlas_t1_brain_mask} -r ${hcp_t1_brain} -o ${tmpdir}/hcp_mni_atlas_brainmask_affine_${i}.nii.gz -t ${hcp_t1_hcp_mni_affine}
      dice=`c3d c3d ${hcp_t1_brainmask} ${tmpdir}/hcp_mni_atlas_brainmask_affine_${i}.nii.gz -overlap 1 | cut -d "," -f 5 | tr -d " "`
      echo "INFO: overlap between warped hcp_mni_atlas mask and t1_brainmask: (dice = ${dice})"
      if [ $(echo "${dice} < 0.9" | bc) -eq 1 ]; then
        echo "WARNING: insufficient overlap between warped hcp_mni_atlas mask and t1_brainmask (dice = ${dice} < 0.9)"
      else
        # stop here if we get a sufficient overlap
        echo "INFO: overlap is sufficient"
        break
      fi
    done

    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${hcp_t1_hcp_mni_affine}
  fi
  hcp_t1_hcp_mni_affine=$(LWDP_get_override_file ${hcp_t1_hcp_mni_affine})

  hcp_t1_hcp_mni_warp=${hcp_t1_hcp_mni_pfx}1Warp.nii.gz
  if LWDP_needs_update_and_lock ${hcp_t1_hcp_mni_warp} ${hcp_t1_brain} ${hcp_mni_atlas_t1_brain}; then
    log_out=${hcp_t1_hcp_mni_pfx}1Warp.log
    #ants antsRegistration -d 3 --initial-moving-transform ${hcp_t1_hcp_mni_affine} -t SyN[0.5,3,0.5] -m CC[${hcp_t1_mrbias},${hcp_mni_atlas_t1},1,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${hcp_t1_hcp_mni_pfx} > ${log_out}
    #ants antsRegistration -d 3 --initial-moving-transform ${hcp_t1_hcp_mni_affine} -t SyN[0.5,3,0.5] -m CC[${hcp_t1_mrbias},${hcp_mni_atlas_t1},1,4] -c 50x30x10 -f 4x2x1 -s 2x1x0vox -o ${hcp_t1_hcp_mni_pfx} > ${log_out}
    ants antsRegistration -d 3 --initial-moving-transform ${hcp_t1_hcp_mni_affine} -t SyN[0.1,3,0] -m CC[${hcp_t1_brain},${hcp_mni_atlas_t1_brain},1,4] -c 100x50x30x0 -f 8x4x2x1 -s 4x2x1x0vox -o ${hcp_t1_hcp_mni_pfx} > ${log_out}
    LWDP_lockfile_delete ${hcp_t1_hcp_mni_warp}
  fi
  hcp_t1_hcp_mni_warp=$(LWDP_get_override_file ${hcp_t1_hcp_mni_warp})

  hcp_t1_hcp_mni_warp_inv=$(LWDP_get_override_file ${hcp_t1_hcp_mni_pfx}1InverseWarp.nii.gz)

  hcp_t1_hcp_mni_mtx="${hcp_t1_hcp_mni_warp} ${hcp_t1_hcp_mni_affine}"
  hcp_mni_hcp_t1_mtx="[${hcp_t1_hcp_mni_affine},1] ${hcp_t1_hcp_mni_warp_inv}"
else
  # align with baseline t1
  hcp_t1_brain_at_baseline=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/hcp/hcp_t1/t1_mrbias_brain.nii.gz)

  # align to t1_baseline
  hcp_t1_brain_to_baseline_pfx=${WORKDIR}/structural/longitudinal/registration/hcp_t1_brain_to_baseline/ants_
  hcp_t1_brain_to_baseline_affine=${hcp_t1_brain_to_baseline_pfx}0GenericAffine.mat
  if LWDP_needs_update_and_lock ${hcp_t1_brain_to_baseline_affine} ${hcp_t1_brain} ${hcp_t1_brain_at_baseline}; then
    log_out=${hcp_t1_brain_to_baseline_pfx}0GenericAffine.log
    ants antsRegistration -d 3 -r [${hcp_t1_brain},${hcp_t1_brain_at_baseline},1] -t Rigid[0.1] -m MI[${hcp_t1_brain},${hcp_t1_brain_at_baseline},1,32,Regular,0.25] -c [1000x500x250x100,1e-6,10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${hcp_t1_brain},${hcp_t1_brain_at_baseline},1,32,Regular,0.25] -c [1000x500x250x100,1e-6,10] -f 8x4x2x1 -s 3x2x1x0vox -o ${hcp_t1_brain_to_baseline_pfx} > ${log_out}
    LWDP_lockfile_delete ${hcp_t1_brain_to_baseline_affine}
  fi
  hcp_t1_brain_to_baseline_affine=$(LWDP_get_override_file ${hcp_t1_brain_to_baseline_affine})

  hcp_t1_brain_to_baseline_warp=${hcp_t1_brain_to_baseline_pfx}1Warp.nii.gz
  if LWDP_needs_update_and_lock ${hcp_t1_brain_to_baseline_warp} ${hcp_t1_brain} ${hcp_t1_brain_at_baseline}; then
    log_out=${hcp_t1_brain_to_baseline_pfx}1Warp.log
    ants antsRegistration -d 3 --initial-moving-transform ${hcp_t1_brain_to_baseline_affine} -t SyN[0.5,3,0.5] -m CC[${hcp_t1_brain},${hcp_t1_brain_at_baseline},1,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${hcp_t1_brain_to_baseline_pfx} > ${log_out}
    LWDP_lockfile_delete ${hcp_t1_brain_to_baseline_warp}
  fi
  hcp_t1_brain_to_baseline_warp=$(LWDP_get_override_file ${hcp_t1_brain_to_baseline_warp})

  hcp_t1_brain_to_baseline_warp_inv=$(LWDP_get_override_file ${hcp_t1_brain_to_baseline_pfx}1InverseWarp.nii.gz)

  hcp_t1_hcp_mni_affine=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/hcp_t1_hcp_mni/ants_0GenericAffine.mat)
  hcp_t1_hcp_mni_warp=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/hcp_t1_hcp_mni/ants_1Warp.nii.gz)
  hcp_t1_hcp_mni_warp_inv=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/hcp_t1_hcp_mni/ants_1InverseWarp.nii.gz)
  if [ ! -e  ${hcp_t1_hcp_mni_affine} ] ; then
    echo "ERROR: ${hcp_t1_hcp_mni_affine} is missing."
    exit 1
  fi
  if [ ! -e  ${hcp_t1_hcp_mni_warp} ] ; then
    echo "ERROR: ${hcp_t1_hcp_mni_warp} is missing."
    exit 1
  fi
  if [ ! -e  ${hcp_t1_hcp_mni_warp_inv} ] ; then
    echo "ERROR: ${hcp_t1_hcp_mni_warp_inv} is missing."
    exit 1
  fi

  hcp_t1_hcp_mni_mtx="${hcp_t1_brain_to_baseline_warp} ${hcp_t1_brain_to_baseline_affine} ${hcp_t1_hcp_mni_warp} ${hcp_t1_hcp_mni_affine}"
  hcp_mni_hcp_t1_mtx="[${hcp_t1_hcp_mni_affine},1] ${hcp_t1_hcp_mni_warp_inv} [${hcp_t1_brain_to_baseline_affine},1] ${hcp_t1_brain_to_baseline_warp_inv}"
fi

hcp_t1_hcp_mni_concat=${WORKDIR}/structural/registration/hcp_t1_hcp_mni/concat/ants_0Warp.nii.gz
if LWDP_needs_update_and_lock ${hcp_t1_hcp_mni_concat} ${hcp_t1_mrbias} ${hcp_t1_hcp_mni_mtx}; then
  ants antsApplyTransforms -d 3 -o [${hcp_t1_hcp_mni_concat},1] -r ${hcp_t1_mrbias} -t ${hcp_t1_hcp_mni_mtx}
  LWDP_lockfile_delete ${hcp_t1_hcp_mni_concat}
fi
hcp_mni_hcp_t1_concat=${WORKDIR}/structural/registration/hcp_mni_hcp_t1/concat/ants_0Warp.nii.gz
if LWDP_needs_update_and_lock ${hcp_mni_hcp_t1_concat} ${hcp_mni_atlas_t1} ${hcp_t1_hcp_mni_mtx}; then
  ants antsApplyTransforms -d 3 -o [${hcp_mni_hcp_t1_concat},1] -r ${hcp_mni_atlas_t1} -t ${hcp_mni_hcp_t1_mtx}
  LWDP_lockfile_delete ${hcp_mni_hcp_t1_concat}
fi

## testing fnirt
