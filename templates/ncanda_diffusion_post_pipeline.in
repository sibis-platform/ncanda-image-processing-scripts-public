whole_fdt_matrix1=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/whole/fdt_matrix1.dot.gz
if LWDP_needs_update_and_lock ${whole_fdt_matrix1} ${inp} ${stop} ${b0_brain} ${bpx_mask} ${bpx_mean_dsamples}; then
  wholeseeds=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/whole/wholeseeds
  rm -f ${wholeseeds}
  echo ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/white.L.gii >> ${wholeseeds}
  echo ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/white.R.gii >> ${wholeseeds}
  count=0
  for Structure in ${ROIStructuresToSeed}; do
    echo ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/${ROINames[${count}]}.nii.gz >> ${wholeseeds}
    let count++
  done

  for name in coords_for_fdt_matrix1 fdt_matrix1.dot probtrackx.txt; do
    rm -f ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/whole/${name}
    rm -f ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/whole/${name}.gz
  done

  options="--seedref=${b0_brain} -s ${bpx_dir}/merged -m ${bpx_mask} --stop=${stop} --loopcheck --forcedir --fibthresh=0.01 -c 0.2 --sampvox=2 --randfib=1 -P 5000 -S 2000 --steplength=0.5 --omatrix1 -V 1 --opd"
  #if [ ! -d /usr/local/cuda/lib64 ]; then
  if true; then
    # cpu version
    dir=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/whole/
    fsl probtrackx2 -x ${wholeseeds} --meshspace=caret --dir=${dir} ${options} &> ${dir}probtrackx.txt
  else
    # gpu version
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
    export CUDA_VISIBLE_DEVICES=0
    probtrackx2_gpu=/fs/tools/fsl/packages/probtrackx_gpu/cuda-8.0/bin/probtrackx2_gpu

    dir=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/whole/
    ${probtrackx2_gpu} -x ${wholeseeds} --meshspace=caret --dir=${dir} ${options} &> ${dir}probtrackx.txt
  fi

  # compress files
  for name in coords_for_fdt_matrix1 fdt_matrix1.dot probtrackx.txt; do
    file=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/whole/${name}
    if [ -e ${file} ]; then
      gzip -9f ${file}
    fi
  done

  LWDP_lockfile_delete ${whole_fdt_matrix1}
fi
