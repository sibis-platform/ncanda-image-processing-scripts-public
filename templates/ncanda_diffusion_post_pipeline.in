#
# transform mesh
#

T1wFolder=${WORKDIR}/structural/hcp/hcp_t1
LowResMesh=32

for Hemisphere in L R; do
  for Surface in white pial; do
    inp=${T1wFolder}/fsaverage_LR${LowResMesh}k/${Hemisphere}.${Surface}.${LowResMesh}k_fs_LR.surf.gii
    out=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${Hemisphere}.${Surface}.${LowResMesh}k_fs_LR.surf.gii
    if LWDP_needs_update_and_lock ${out} ${inp} ${hcp_t1_b0_affine_tfm}; then
      tmpdir=$(mktemp -d)

      cp ${inp} ${tmpdir}/${hemisphere}h.${Surface}.surf.gii
      mris_convert ${tmpdir}/${hemisphere}h.${Surface}.surf.gii ${tmpdir}/${hemisphere}h.${Surface}.surf.asc
      v_num=`sed -n 2p ${tmpdir}/${hemisphere}h.${Surface}.surf.asc | cut -d " " -f1`
      e_num=`sed -n 2p ${tmpdir}/${hemisphere}h.${Surface}.surf.asc | cut -d " " -f2`
      v_a=3
      v_b=`expr ${v_num} + 2`
      echo "x,y,z,t" > ${tmpdir}/${hemisphere}h_lps.csv
      sed -n ${v_a},${v_b}p ${tmpdir}/${hemisphere}h.${Surface}.surf.asc | tr -s " " | cut -d " " -f1 > ${tmpdir}/${hemisphere}h_ras_x.csv
      sed -n ${v_a},${v_b}p ${tmpdir}/${hemisphere}h.${Surface}.surf.asc | tr -s " " | cut -d " " -f2 > ${tmpdir}/${hemisphere}h_ras_y.csv
      sed -n ${v_a},${v_b}p ${tmpdir}/${hemisphere}h.${Surface}.surf.asc | tr -s " " | cut -d " " -f3 > ${tmpdir}/${hemisphere}h_ras_z.csv
      sed -n ${v_a},${v_b}p ${tmpdir}/${hemisphere}h.${Surface}.surf.asc | tr -s " " | cut -d " " -f4 > ${tmpdir}/${hemisphere}h_ras_t.csv
      cat ${tmpdir}/${hemisphere}h_ras_x.csv | awk '{ if( $NF ~ /^-/ ) { sub(/-/, "", $NF); print $0; } else { $NF="-"$NF; print $0 } }' > ${tmpdir}/${hemisphere}h_lps_x.csv
      cat ${tmpdir}/${hemisphere}h_ras_y.csv | awk '{ if( $NF ~ /^-/ ) { sub(/-/, "", $NF); print $0; } else { $NF="-"$NF; print $0 } }' > ${tmpdir}/${hemisphere}h_lps_y.csv
      cat ${tmpdir}/${hemisphere}h_ras_z.csv > ${tmpdir}/${hemisphere}h_lps_z.csv
      cat ${tmpdir}/${hemisphere}h_ras_t.csv > ${tmpdir}/${hemisphere}h_lps_t.csv
      paste -d "," ${tmpdir}/${hemisphere}h_lps_x.csv ${tmpdir}/${hemisphere}h_lps_y.csv ${tmpdir}/${hemisphere}h_lps_z.csv ${tmpdir}/${hemisphere}h_lps_t.csv >> ${tmpdir}/${hemisphere}h_lps.csv

      ants antsApplyTransformsToPoints -d 3 -p 1 -i ${tmpdir}/${hemisphere}h_lps.csv -o ${tmpdir}/${hemisphere}h_warp_lps.csv -t ${hcp_t1_b0_affine_tfm}

      sed -n 1,2p ${tmpdir}/${hemisphere}h.${Surface}.surf.asc > ${tmpdir}/${hemisphere}h.${Surface}.native.surf.asc
      c_a=2
      c_b=`expr ${v_num} + 1`
      sed -n ${c_a},${c_b}p ${tmpdir}/${hemisphere}h_warp_lps.csv | cut -d "," -f1 > ${tmpdir}/${hemisphere}h_warp_lps_x.csv
      sed -n ${c_a},${c_b}p ${tmpdir}/${hemisphere}h_warp_lps.csv | cut -d "," -f2 > ${tmpdir}/${hemisphere}h_warp_lps_y.csv
      sed -n ${c_a},${c_b}p ${tmpdir}/${hemisphere}h_warp_lps.csv | cut -d "," -f3 > ${tmpdir}/${hemisphere}h_warp_lps_z.csv
      sed -n ${c_a},${c_b}p ${tmpdir}/${hemisphere}h_warp_lps.csv | cut -d "," -f4 > ${tmpdir}/${hemisphere}h_warp_lps_t.csv
      cat ${tmpdir}/${hemisphere}h_warp_lps_x.csv | awk '{ if( $NF ~ /^-/ ) { sub(/-/, "", $NF); print $0; } else { $NF="-"$NF; print $0 } }' > ${tmpdir}/${hemisphere}h_warp_ras_x.csv
      cat ${tmpdir}/${hemisphere}h_warp_lps_y.csv | awk '{ if( $NF ~ /^-/ ) { sub(/-/, "", $NF); print $0; } else { $NF="-"$NF; print $0 } }' > ${tmpdir}/${hemisphere}h_warp_ras_y.csv
      cat ${tmpdir}/${hemisphere}h_warp_lps_z.csv > ${tmpdir}/${hemisphere}h_warp_ras_z.csv
      cat ${tmpdir}/${hemisphere}h_warp_lps_t.csv > ${tmpdir}/${hemisphere}h_warp_ras_t.csv
      paste -d " " ${tmpdir}/${hemisphere}h_warp_ras_x.csv ${tmpdir}/${hemisphere}h_warp_ras_y.csv ${tmpdir}/${hemisphere}h_warp_ras_z.csv ${tmpdir}/${hemisphere}h_warp_ras_t.csv >> ${tmpdir}/${hemisphere}h.${Surface}.native.surf.asc

      e_a=`expr ${v_b} + 1`
      e_b=`expr ${v_b} + ${e_num}`
      sed -n ${e_a},${e_b}p ${tmpdir}/${hemisphere}h.${Surface}.surf.asc >> ${tmpdir}/${hemisphere}h.${Surface}.native.surf.asc

      mris_convert ${tmpdir}/${hemisphere}h.${Surface}.native.surf.asc ${out}

      rm -rf ${tmpdir}
      LWDP_lockfile_delete ${out}
    fi
  done
done

# make trajectory space
GrayordinatesSpace=91282_Greyordinates
GrayordinatesSpaceDIR=${DATA_DIR}/hcp/templates/${GrayordinatesSpace}
GrayordinatesResolutions=2

# transform ROI
inp[1]=${T1wFolder}/wmparc.nii.gz
inp[2]=${T1wFolder}/aparc+aseg.nii.gz
out[1]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/wmparc.nii.gz
out[2]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/aparc+aseg.nii.gz
for idx in 1 2; do
  if LWDP_needs_update_and_lock ${out[${idx}]} ${inp[${idx}]} ${b0_brain} ${hcp_t1_b0_affine_tfm}; then
    ants antsApplyTransforms -n MultiLabel[0.5,1] -i ${inp[${idx}]} -r ${b0_brain} -o ${out[${idx}]} -t [${hcp_t1_b0_affine_tfm},1]
    c3d c3d ${out[${idx}]} -type short -o ${out[${idx}]}
    LWDP_lockfile_delete ${out[${idx}]}
  fi
done

if [ ${nf} -eq 2 ]; then
  ROIFolder=ROIs
else
  ROIFolder=ROIs_nf${nf}
fi

ROIStructuresToSeed="26 58 18 54 16 11 50 8 47 28 60 17 53 13 52 12 51 10 49"
ROINames=("ACCUMBENS_LEFT" "ACCUMBENS_RIGHT" "AMYGDALA_LEFT" "AMYGDALA_RIGHT" "BRAIN_STEM" "CAUDATE_LEFT" "CAUDATE_RIGHT" "CEREBELLUM_LEFT" "CEREBELLUM_RIGHT" "DIENCEPHALON_VENTRAL_LEFT" "DIENCEPHALON_VENTRAL_RIGHT" "HIPPOCAMPUS_LEFT" "HIPPOCAMPUS_RIGHT" "PALLIDUM_LEFT" "PALLIDUM_RIGHT" "PUTAMEN_LEFT" "PUTAMEN_RIGHT" "THALAMUS_LEFT" "THALAMUS_RIGHT")
count=0
for Structure in ${ROIStructuresToSeed}; do
  inp=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/aparc+aseg.nii.gz
  out=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/${ROINames[${count}]}.nii.gz
  if LWDP_needs_update_and_lock ${out} ${inp}; then
    fsl fslmaths ${inp} -thr ${Structure} -uthr ${Structure} -bin ${out}
    LWDP_lockfile_delete ${out}
  fi
  let count++
done

label[1]=${DATA_DIR}/freesurfer/FreeSurferColorLUT_WM.txt
label[2]=${DATA_DIR}/freesurfer/FreeSurferColorLUT_Ventricles.txt
label[3]=""
label_add[1]="${ROIStructuresToSeed}"
label_add[2]="24" # CSF
label_add[3]="${ROIStructuresToSeed}"
label_del[1]="8 47" # CEREBELLUM_LEFT CEREBELLUM_RIGHT
label_del[2]=""
label_del[3]=""
input[1]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/aparc+aseg.nii.gz
input[2]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/aparc+aseg.nii.gz
input[3]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/aparc+aseg.nii.gz
output[1]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/aparc+aseg_waypoints.nii.gz
output[2]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/aparc+aseg_avoid.nii.gz
output[3]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/aparc+aseg_volseeds.nii.gz
output2[1]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/aparc+aseg_waypoints_bin.nii.gz
output2[2]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/aparc+aseg_avoid_bin.nii.gz
output2[3]=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/aparc+aseg_volseeds_bin.nii.gz
for idx in 1 2 3; do
  if LWDP_needs_update_and_lock ${output[${idx}]} ${intput[${idx}]} ${label[${idx}]}; then
    tmpdir=$(mktemp -d)
    if [ "${label[${idx}]}" != "" ]; then
      label_set=`cat ${label[${idx}]} | cut -d " " -f1`
    else
      label_set=""
    fi
    label_set="${label_set} ${label_add[${idx}]}"
    replace_txt=
    for l in ${label_set}; do
      found=0
      if [ "${label_del[${idx}]}" != "" ]; then
        for ld in ${label_del[${idx}]}; do
          if [ "${l}" == "${ld}" ]; then
            found=1
          fi
        done
      fi
      if [ ${found} -eq 0 ]; then
        replace_txt="${replace_txt} ${l} 100000"
      fi
    done
    c3d c3d ${input[${idx}]} -replace ${replace_txt} -thresh 100000 inf 1 0 -type short -o ${tmpdir}/tmp_bin.nii.gz
    c3d c3d ${input[${idx}]} ${tmpdir}/tmp_bin.nii.gz -multiply -o ${output[${idx}]}
    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${output[${idx}]}
  fi
  if LWDP_needs_update_and_lock ${output2[${idx}]} ${output[${idx}]}; then
    c3d c3d ${output[${idx}]} -thresh 1 inf 1 0 -o ${output2[${idx}]}
    LWDP_lockfile_delete ${output2[${idx}]}
  fi
done
label_waypoints=${output2[1]}
label_avoid=${output2[2]}
label_volseeds=${output2[3]}

inp=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/aparc+aseg.nii.gz
label_stop=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/aparc+aseg_stop_bin.nii.gz
if LWDP_needs_update_and_lock ${label_stop} ${label_volseeds} ${inp}; then
  #c3d c3d ${inp} -thresh 1 inf 0 1 ${label_volseeds} -add -thresh 1 inf 1 0 -o ${label_stop}
  c3d c3d ${inp} -thresh 1 inf 0 1 -o ${label_stop}
  LWDP_lockfile_delete ${label_stop}
fi

for Hemisphere in L R; do
  for Surface in white pial; do
    inp=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${Hemisphere}.${Surface}.${LowResMesh}k_fs_LR.surf.gii
    out=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/${Surface}.${Hemisphere}.asc
    atlasroi=${GrayordinatesSpaceDIR}/${Hemisphere}.atlasroi.${LowResMesh}k_fs_LR.shape.gii
    if LWDP_needs_update_and_lock ${out} ${inp} ${b0_brain} ${atlasroi}; then
      fsl surf2surf -i ${inp} -o ${out} --volin=${b0_brain} --outputtype=ASCII --values=${atlasroi} --convin=caret --convout=vox
      LWDP_lockfile_delete ${out}
    fi

    out_gii=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/${Surface}.${Hemisphere}.gii
    if LWDP_needs_update_and_lock ${out_gii} ${out} ${b0_brain}; then
      fsl surf2surf -i ${out} -o ${out_gii} --volin=${b0_brain} --convin=vox --convout=caret
      LWDP_lockfile_delete ${out_gii}
    fi
  done
done

# transform volume grayordinate
hcp_mni_hcp_t1_concat=$(LWDP_get_override_file ${WORKDIR}/structural/registration/hcp_mni_hcp_t1/concat/ants_0Warp.nii.gz)
#
count=0
for Structure in ${ROIStructuresToSeed}; do
  atlas_coord=${GrayordinatesSpaceDIR}/${GrayordinatesSpace}.dscalar.nii
  atlas_img=${GrayordinatesSpaceDIR}/Atlas_ROIs.${GrayordinatesResolutions}.nii.gz
  roi_img=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/${ROINames[${count}]}.nii.gz
  out=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/${ROINames[${count}]}.asc
  if LWDP_needs_update_and_lock ${out} ${inp} ${atlas_coord} ${atlas_img} ${roi_img} ${hcp_mni_hcp_t1_concat} ${hcp_t1_b0_affine_tfm}; then
    tmpdir=$(mktemp -d)
    #tmpdir=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/tmp
    #mkdir -p ${tmpdir}

    caret7 wb_command -cifti-export-dense-mapping ${atlas_coord} COLUMN -volume ${ROINames[${count}]} ${tmpdir}/${ROINames[${count}]}.asc -no-cifti-index

    v_num=`cat ${tmpdir}/${ROINames[${count}]}.asc | wc -l`

    # vox to physical coord
    fsl img2stdcoord -img ${atlas_img} -std ${atlas_img} ${tmpdir}/${ROINames[${count}]}.asc | tr -s " " | tr " " "," > ${tmpdir}/${ROINames[${count}]}_ras.csv

    echo "x,y,z" > ${tmpdir}/${ROINames[${count}]}_lps.csv
    cat ${tmpdir}/${ROINames[${count}]}_ras.csv | cut -d "," -f1 > ${tmpdir}/${ROINames[${count}]}_ras_x.csv
    cat ${tmpdir}/${ROINames[${count}]}_ras.csv | cut -d "," -f2 > ${tmpdir}/${ROINames[${count}]}_ras_y.csv
    cat ${tmpdir}/${ROINames[${count}]}_ras.csv | cut -d "," -f3 > ${tmpdir}/${ROINames[${count}]}_ras_z.csv
    cat ${tmpdir}/${ROINames[${count}]}_ras_x.csv | awk '{ if( $NF ~ /^-/ ) { sub(/-/, "", $NF); print $0; } else { $NF="-"$NF; print $0 } }' > ${tmpdir}/${ROINames[${count}]}_lps_x.csv
    cat ${tmpdir}/${ROINames[${count}]}_ras_y.csv | awk '{ if( $NF ~ /^-/ ) { sub(/-/, "", $NF); print $0; } else { $NF="-"$NF; print $0 } }' > ${tmpdir}/${ROINames[${count}]}_lps_y.csv
    cat ${tmpdir}/${ROINames[${count}]}_ras_z.csv > ${tmpdir}/${ROINames[${count}]}_lps_z.csv
    paste -d "," ${tmpdir}/${ROINames[${count}]}_lps_x.csv ${tmpdir}/${ROINames[${count}]}_lps_y.csv ${tmpdir}/${ROINames[${count}]}_lps_z.csv >> ${tmpdir}/${ROINames[${count}]}_lps.csv

    # warp lps coord
    ants antsApplyTransformsToPoints -d 3 -p 1 -i ${tmpdir}/${ROINames[${count}]}_lps.csv -o ${tmpdir}/${ROINames[${count}]}_warp_lps.csv -t ${hcp_mni_hcp_t1_concat} ${hcp_t1_b0_affine_tfm}

    c_a=2
    c_b=`expr ${v_num} + 1`
    sed -n ${c_a},${c_b}p ${tmpdir}/${ROINames[${count}]}_warp_lps.csv | cut -d "," -f1 > ${tmpdir}/${ROINames[${count}]}_warp_lps_x.csv
    sed -n ${c_a},${c_b}p ${tmpdir}/${ROINames[${count}]}_warp_lps.csv | cut -d "," -f2 > ${tmpdir}/${ROINames[${count}]}_warp_lps_y.csv
    sed -n ${c_a},${c_b}p ${tmpdir}/${ROINames[${count}]}_warp_lps.csv | cut -d "," -f3 > ${tmpdir}/${ROINames[${count}]}_warp_lps_z.csv
    cat ${tmpdir}/${ROINames[${count}]}_warp_lps_x.csv | awk '{ if( $NF ~ /^-/ ) { sub(/-/, "", $NF); print $0; } else { $NF="-"$NF; print $0 } }' > ${tmpdir}/${ROINames[${count}]}_warp_ras_x.csv
    cat ${tmpdir}/${ROINames[${count}]}_warp_lps_y.csv | awk '{ if( $NF ~ /^-/ ) { sub(/-/, "", $NF); print $0; } else { $NF="-"$NF; print $0 } }' > ${tmpdir}/${ROINames[${count}]}_warp_ras_y.csv
    cat ${tmpdir}/${ROINames[${count}]}_warp_lps_z.csv > ${tmpdir}/${ROINames[${count}]}_warp_ras_z.csv
    paste -d " " ${tmpdir}/${ROINames[${count}]}_warp_ras_x.csv ${tmpdir}/${ROINames[${count}]}_warp_ras_y.csv ${tmpdir}/${ROINames[${count}]}_warp_ras_z.csv > ${tmpdir}/${ROINames[${count}]}_warp_ras.asc

    # physical coord to vox
    fsl std2imgcoord -img ${roi_img} -std ${roi_img} -vox ${tmpdir}/${ROINames[${count}]}_warp_ras.asc | tr -s " " > ${tmpdir}/${ROINames[${count}]}_warp.asc

    rm -f ${tmpdir}/${ROINames[${count}]}_warp_t.csv
    for i in `seq 1 ${v_num}`; do
      echo "1" >> ${tmpdir}/${ROINames[${count}]}_warp_t.csv
    done

    echo "#!ascii from CsvMesh" > ${out}
    echo "${v_num} ${v_num}" >> ${out}
    #
    # flip x
    cat ${tmpdir}/${ROINames[${count}]}_warp.asc | cut -d " " -f1 > ${tmpdir}/${ROINames[${count}]}_warp_x.csv
    cat ${tmpdir}/${ROINames[${count}]}_warp.asc | cut -d " " -f2 > ${tmpdir}/${ROINames[${count}]}_warp_y.csv
    cat ${tmpdir}/${ROINames[${count}]}_warp.asc | cut -d " " -f3 > ${tmpdir}/${ROINames[${count}]}_warp_z.csv
    roi_img_x=`fsl fslval ${roi_img} dim1 | tr -d " "`
    roi_img_x_1=`expr ${roi_img_x} - 1`
    cat ${tmpdir}/${ROINames[${count}]}_warp_x.csv | awk -v dim=${roi_img_x_1} '{print (dim - $0)}' > ${tmpdir}/${ROINames[${count}]}_warp_x_flip.csv
    paste -d " " ${tmpdir}/${ROINames[${count}]}_warp_x_flip.csv ${tmpdir}/${ROINames[${count}]}_warp_y.csv ${tmpdir}/${ROINames[${count}]}_warp_z.csv ${tmpdir}/${ROINames[${count}]}_warp_t.csv >> ${out}
    #
    v_idx=0
    for i in `seq 1 ${v_num}`; do
      echo "${v_idx} ${v_idx} ${v_idx} 0" >> ${out}
      let v_idx++
    done

    rm -rf ${tmpdir}
    LWDP_lockfile_delete ${out}
  fi

  out_gii=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/${ROINames[${count}]}.gii
  if LWDP_needs_update_and_lock ${out_gii} ${out} ${b0_brain}; then
    fsl surf2surf -i ${out} -o ${out_gii} --volin=${b0_brain} --convin=vox --convout=caret
    LWDP_lockfile_delete ${out_gii}
  fi

  let count++
done

# run probtrackx2 for fdt_matrix1.dot
inp="${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/white.L.gii ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/white.R.gii"
stop=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/stop
volseeds=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/volseeds
seeds=${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/probtrackx2_nf${nf}/seeds
if LWDP_needs_update_and_lock ${stop} ${inp}; then
  rm -f ${stop}
  rm -f ${volseeds}
  rm -f ${seeds}

  echo ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/pial.L.gii >> ${stop}
  echo ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/pial.R.gii >> ${stop}
  #
  echo ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/white.L.gii >> ${seeds}
  echo ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/white.R.gii >> ${seeds}
  #
  count=0
  for Structure in ${ROIStructuresToSeed}; do
    echo ${DIFFUSION_DIR}/${branch}/hcp/b0_unwarp/${ROIFolder}/${ROINames[${count}]}.gii >> ${volseeds}
    let count++
  done
  #
  cat ${volseeds} >> ${seeds}

  LWDP_lockfile_delete ${stop}
fi
