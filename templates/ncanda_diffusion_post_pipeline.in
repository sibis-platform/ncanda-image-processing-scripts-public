#    det=`fsl avscale ${prefix}.mat | grep Determinant | awk '{ print $3 }'`
#    echo "# Determinant: ${det}" > ${prefix}.log
#    if [ X`echo "if ( $det < 0 ) { 1 }" | bc -l` = X1 ]; then
#      # radiological case (negative determinant)
#      echo "fsl fslswapdim ${inp[${i}]} RL PA IS ${out[${i}]}" >> ${prefix}.log
#      fsl fslswapdim ${inp[${i}]} RL PA IS ${out[${i}]}
#    else
#      echo "fsl fslswapdim ${inp[${i}]} LR PA IS ${out[${i}]}" >> ${prefix}.log
#      fsl fslswapdim ${inp[${i}]} LR PA IS ${out[${i}]}
#    fi
#    LWDP_lockfile_delete ${out[${i}]}
#  fi
#done
#hcp_b0_brain=${out[1]}

fs_ribbon=${FreeSurferFolder}/mri/ribbon.mgz
hcp_t1_mrbias=${WORKDIR}/structural/hcp/hcp_t1/t1_mrbias.nii.gz
hcp_t1_brain=${WORKDIR}/structural/hcp/hcp_t1/t1_mrbias_brain.nii.gz

#hcp_t1_hcp_b0_pfx=${DIFFUSION_DIR}/${branch}/registration/hcp_t1_hcp_b0/epi_reg
#hcp_t1_hcp_b0_affine=${hcp_t1_hcp_b0_pfx}.mat
#if LWDP_needs_update_and_lock ${hcp_t1_hcp_b0_affine} ${fs_ribbon} ${hcp_b0_brain} ${hcp_t1_mrbias} ${hcp_t1_brain}; then
#  tmpdir=$(mktemp -d)
#  mri_convert -rt nearest -rl ${hcp_t1_mrbias} ${fs_ribbon} ${tmpdir}/ribbon.nii.gz
#  # djk: create epi_reg_fast_wmseg.nii.gz file to turn around a bug of epi_reg (fsl 5.0.6)
#  c3d c3d ${tmpdir}/ribbon.nii.gz -replace 2 1 3 0 41 1 42 0 -o ${hcp_t1_hcp_b0_pfx}_fast_wmseg.nii.gz
#  fsl epi_reg --epi=${hcp_b0_brain} --t1=${hcp_t1_mrbias} --t1brain=${hcp_t1_brain} --wmseg=${hcp_t1_hcp_b0_pfx}_fast_wmseg.nii.gz --noclean -v --out=${hcp_t1_hcp_b0_pfx} >& ${hcp_t1_hcp_b0_pfx}.log
#  # djk: remove dangling link
#  rm ${hcp_t1_hcp_b0_pfx}_fast_wmseg
#  rm -rf ${tmpdir}
#  LWDP_lockfile_delete ${hcp_t1_hcp_b0_affine}
#fi
## convert fsl mtx to itk tfm
#hcp_t1_hcp_b0_affine_tfm=${hcp_t1_hcp_b0_pfx}.tfm
#if LWDP_needs_update_and_lock ${hcp_t1_hcp_b0_affine_tfm} ${hcp_t1_hcp_b0_affine} ${hcp_b0_brain} ${hcp_t1_mrbias}; then
#  c3d c3d_affine_tool -ref ${hcp_t1_mrbias} -src ${hcp_b0_brain} ${hcp_t1_hcp_b0_affine} -fsl2ras -oitk ${hcp_t1_hcp_b0_affine_tfm}
#  LWDP_lockfile_delete ${hcp_t1_hcp_b0_affine_tfm}
#fi
#
#b0fa_t1_refine_affine=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/registration/b0fa_t1_refine/ants_0GenericAffine.mat)
#b0fa_t1_refine_warp=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/registration/b0fa_t1_refine/ants_1Warp.nii.gz)
#b0fa_t1_refine_warp_inv=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/registration/b0fa_t1_refine/ants_1InverseWarp.nii.gz)
#b0fa_t1_refine_mtx="${b0fa_t1_refine_warp} ${b0fa_t1_refine_affine}"
#t1_b0fa_refine_mtx="[${b0fa_t1_refine_affine},1] ${b0fa_t1_refine_warp_inv}"

b0_brain=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/reslice/b0_unwarp/b0_brain.nii.gz)
b0_brainmask=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/reslice/b0_unwarp/brainmask.nii.gz)

hcp_t1_b0_pfx=${DIFFUSION_DIR}/${branch}/registration/hcp_t1_b0/epi_reg
hcp_t1_b0_affine=${hcp_t1_b0_pfx}.mat
if LWDP_needs_update_and_lock ${hcp_t1_b0_affine} ${fs_ribbon} ${b0_brain} ${hcp_t1_mrbias} ${hcp_t1_brain}; then
  tmpdir=$(mktemp -d)
  mri_convert -rt nearest -rl ${hcp_t1_mrbias} ${fs_ribbon} ${tmpdir}/ribbon.nii.gz
  # djk: create epi_reg_fast_wmseg.nii.gz file to turn around a bug of epi_reg (fsl 5.0.6)
  c3d c3d ${tmpdir}/ribbon.nii.gz -replace 2 1 3 0 41 1 42 0 -o ${hcp_t1_b0_pfx}_fast_wmseg.nii.gz
  fsl epi_reg --epi=${b0_brain} --t1=${hcp_t1_mrbias} --t1brain=${hcp_t1_brain} --wmseg=${hcp_t1_b0_pfx}_fast_wmseg.nii.gz --noclean -v --out=${hcp_t1_b0_pfx} >& ${hcp_t1_b0_pfx}.log
  # djk: remove dangling link
  rm ${hcp_t1_b0_pfx}_fast_wmseg
  rm -rf ${tmpdir}
  LWDP_lockfile_delete ${hcp_t1_b0_affine}
fi
# convert fsl mtx to itk tfm
hcp_t1_b0_affine_tfm=${hcp_t1_b0_pfx}.tfm
if LWDP_needs_update_and_lock ${hcp_t1_b0_affine_tfm} ${hcp_t1_b0_affine} ${b0_brain} ${hcp_t1_mrbias}; then
  c3d c3d_affine_tool -ref ${hcp_t1_mrbias} -src ${b0_brain} ${hcp_t1_b0_affine} -fsl2ras -oitk ${hcp_t1_b0_affine_tfm}
  LWDP_lockfile_delete ${hcp_t1_b0_affine_tfm}
fi

#
# Prepare structural transformations
#

t1_sri24_affine=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_0GenericAffine.mat)
t1_sri24_warp=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_1Warp.nii.gz)
t1_sri24_warp_inv=$(LWDP_get_override_file ${WORKDIR}/../baseline/structural/registration/t1_sri24/ants_1InverseWarp.nii.gz)
if [ ! -e  ${t1_sri24_affine} ] ; then
  echo "ERROR: ${t1_sri24_affine} is missing."
  exit 1
    fi
if [ ! -e  ${t1_sri24_warp} ] ; then
  echo "ERROR: ${t1_sri24_warp} is missing."
  exit 1
fi
if [ ! -e  ${t1_sri24_warp_inv} ] ; then
  echo "ERROR: ${t1_sri24_warp_inv} is missing."
  exit 1
fi
if [ "${VISIT}" == "baseline" ]; then
  t1_sri24_mtx="${t1_sri24_warp} ${t1_sri24_affine}"
  t1_sri24_mtx_affine="${t1_sri24_affine}"
  sri24_t1_mtx="[${t1_sri24_affine},1] ${t1_sri24_warp_inv}"
  sri24_t1_mtx_affine="[${t1_sri24_affine},1]"
  #
  sri24_padded_t1_brain=${WORKDIR}/structural/reslice/sri24_padded/t1_brain.nii.gz
  sri24_padded_to_t1_rigid=${WORKDIR}/structural/registration/sri24_padded_to_t1/ants_rigid_0GenericAffine.mat
else
  t1_brain_to_baseline_affine=$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline/ants_0GenericAffine.mat)
  t1_brain_to_baseline_warp=$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline/ants_1Warp.nii.gz)
  t1_brain_to_baseline_warp_inv=$(LWDP_get_override_file ${WORKDIR}/structural/longitudinal/registration/t1_brain_to_baseline/ants_1InverseWarp.nii.gz)
  if [ ! -e  ${t1_brain_to_baseline_affine} ] ; then
    echo "ERROR: ${t1_brain_to_baseline_affine} is missing."
    exit 1
  fi
  if [ ! -e  ${t1_brain_to_baseline_warp} ] ; then
    echo "ERROR: ${t1_brain_to_baseline_warp} is missing."
    exit 1
  fi
  if [ ! -e  ${t1_brain_to_baseline_warp_inv} ] ; then
    echo "ERROR: ${t1_brain_to_baseline_warp_inv} is missing."
    exit 1
  fi
  t1_sri24_mtx="${t1_brain_to_baseline_warp} ${t1_brain_to_baseline_affine} ${t1_sri24_warp} ${t1_sri24_affine}"
  t1_sri24_mtx_affine="${t1_brain_to_baseline_warp} ${t1_brain_to_baseline_affine} ${t1_sri24_affine}"
  sri24_t1_mtx="[${t1_sri24_affine},1] ${t1_sri24_warp_inv} [${t1_brain_to_baseline_affine},1] ${t1_brain_to_baseline_warp_inv}"
  sri24_t1_mtx_affine="[${t1_sri24_affine},1] [${t1_brain_to_baseline_affine},1] ${t1_brain_to_baseline_warp_inv}"
  #
  sri24_padded_t1_brain=${WORKDIR}/structural/reslice/sri24_padded/corrected/t1_brain.nii.gz
  sri24_padded_to_t1_rigid=${WORKDIR}/structural/longitudinal/registration/baseline_sri24_padded_to_t1/ants_rigid_0GenericAffine.mat
fi

b0_t1_pfx=${DIFFUSION_DIR}/${branch}/registration/b0_t1/ants_
b0_t1_affine=${b0_t1_pfx}0GenericAffine.mat
b0_t1_warp=${b0_t1_pfx}1Warp.nii.gz
b0_t1_warp_inv=${b0_t1_pfx}1InverseWarp.nii.gz
b0_t1_mtx="${b0_t1_warp} ${b0_t1_affine}"
t1_b0_mtx="[${b0_t1_affine},1] ${b0_t1_warp_inv}"

#
# perform probabilistic tractography
#

included_volumes_file=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/camino/inclusion_list.txt)
bval_file=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/corrected/bval.txt)
dwi_unwarp_bvecs=$(LWDP_get_override_file ${DIFFUSION_DIR}/${branch}/corrected/dwi_unwarp.eddy_rotated_bvecs)

# bedpostx is now run in ncanda_diffusion_pipeline
# #nf=2
#nf=3
# if [ ${nf} -eq 2 ]; then
#  bpx_dir=${DIFFUSION_DIR}/${branch}/bedpostx
#else
#  bpx_dir=${DIFFUSION_DIR}/${branch}/bedpostx_nf${nf}
#fi


#
# Run autoptx
#

#if [ "${VISIT}" == "${VISIT_REF}" ]; then

autoptx_dir=${DIFFUSION_DIR}/${branch}/autoptx

# register fa map to fmrib
fa_subject=${bpx_dir}/dtifit_FA.nii.gz
fa_fmrib=${FSLDIR}/data/standard/FMRIB58_FA_1mm.nii.gz

fa_to_fmrib_pfx=${DIFFUSION_DIR}/${branch}/registration/fa_fmrib/ants_
fa_to_fmrib_affine=${fa_to_fmrib_pfx}0GenericAffine.mat
if LWDP_needs_update_and_lock ${fa_to_fmrib_affine} ${fa_subject} ${fa_fmrib}; then
  log_out=${fa_to_fmrib_pfx}0GenericAffine.log
  ants antsRegistration -d 3 -u -w [0.005,0.995] -r [${fa_subject},${fa_fmrib},1] -t Rigid[0.1] -m MI[${fa_subject},${fa_fmrib},1,32,Regular,0.25] -c [1000x500x250x100,1e-6,10] -f 8x4x2x1 -s 3x2x1x0vox -t Affine[0.1] -m MI[${fa_subject},${fa_fmrib},1,32,Regular,0.25] -c [1000x500x250x100,1e-6,10] -f 8x4x2x1 -s 3x2x1x0vox -o ${fa_to_fmrib_pfx} > ${log_out}
  #
  ants antsApplyTransforms -d 3 -n Linear -i ${fa_fmrib} -r ${fa_subject} -o ${fa_to_fmrib_pfx}0GenericAffine_fmrib.nii.gz -t ${fa_to_fmrib_affine}
  #
  LWDP_lockfile_delete ${fa_to_fmrib_affine}
fi
fa_to_fmrib_affine=$(LWDP_get_override_file ${fa_to_fmrib_affine})

fa_to_fmrib_warp=${fa_to_fmrib_pfx}1Warp.nii.gz
if LWDP_needs_update_and_lock ${fa_to_fmrib_warp} ${fa_subject} ${fa_fmrib}; then
  log_out=${fa_to_fmrib_pfx}1Warp.log
  ants antsRegistration -d 3 -u -w [0.005,0.995] --initial-moving-transform ${fa_to_fmrib_affine} -t SyN[0.5,3,0.5] -m CC[${fa_subject},${fa_fmrib},0.5,4] -c 100x50x30 -f 4x2x1 -s 2x1x0vox -o ${fa_to_fmrib_pfx} > ${log_out}
  #
  ants antsApplyTransforms -d 3 -n Linear -i ${fa_fmrib} -r ${fa_subject} -o ${fa_to_fmrib_pfx}1Warp_fmrib.nii.gz -t ${fa_to_fmrib_warp} ${fa_to_fmrib_affine}
  #
  LWDP_lockfile_delete ${fa_to_fmrib_warp}
fi
export fa_to_fmrib_warp=$(LWDP_get_override_file ${fa_to_fmrib_warp})

#std2nat_warp=${autoptx_dir}/std2nat_warp.nii.gz
#if LWDP_needs_update_and_lock ${std2nat_warp} ${fa_subject} ${fa_fmrib}; then
#  fsl fsl_reg ${fa_subject} ${fa_fmrib} ${autoptx_dir}/nat2std -e -FA
#  fsl invwarp -r ${fa_subject} -w ${autoptx_dir}/nat2std_warp.nii.gz -o ${std2nat_warp}
#  LWDP_lockfile_delete ${std2nat_warp}
#fi

refvol=${autoptx_dir}/refVol.nii.gz
if LWDP_needs_update_and_lock ${refvol} ${fa_subject}; then
  fsl flirt -in ${fa_subject} -ref ${fa_subject} -applyisoxfm 1 -out ${refvol}
  fsl fslmaths ${refvol} -mul 0 ${refvol}
  LWDP_lockfile_delete ${refvol}
fi

structures=${DATA_DIR}/autoptx/structureList
snum=`cat ${structures} | wc -l`
for sidx in `seq 1 ${snum}`; do
  line=`sed -n "${sidx}p;d" ${structures}`
  struct=`echo ${line} | cut -d " " -f1` 
  tracts=${autoptx_dir}/tracts/${struct}
  tracts_norm=${tracts}/tracts/tractsNorm.nii.gz
  #if LWDP_needs_update_and_lock ${tracts_norm} ${std2nat_warp} ${refvol} ${bpx_mean_dsamples} ${bpx_mask}; then
  if LWDP_needs_update_and_lock ${tracts_norm} ${fa_to_fmrib_warp} ${fa_to_fmrib_affine} ${refvol} ${bpx_mean_dsamples} ${bpx_mask}; then
    seedm=`echo ${line} | cut -d " " -f2` 
    nSeed=$(echo "scale=0; 1000 * ${seedm} / 1"|bc)
    masks=${DATA_DIR}/autoptx/protocols/${struct}
    
    # is there a stop criterion defined in the protocol for this struct?
    if [ -e ${masks}/stop.nii.gz ]; then
      useStop=1
    else
      useStop=0
    fi
    # does the protocol defines a second run with inverted seed / target masks
    if [ -e ${masks}/invert ]; then
      symtrack=1
      rm -f ${tracts}/tractsInv/waytotal
    else
      symtrack=0
    fi
    
    # transform masks
    #fsl applywarp -r ${refvol} -w ${std2nat_warp} -i ${masks}/seed.nii.gz -o ${tracts}/seed.nii.gz -d float
    ants antsApplyTransforms -d 3 -n Linear -i ${masks}/seed.nii.gz -r ${refvol} -o ${tracts}/seed.nii.gz -t ${fa_to_fmrib_warp} ${fa_to_fmrib_affine}
    fsl fslmaths ${tracts}/seed.nii.gz -thr 0.1 -bin ${tracts}/seed.nii.gz -odt char
    #fsl applywarp -r ${refvol} -w ${std2nat_warp} -i ${masks}/target.nii.gz -o ${tracts}/target.nii.gz -d float
    ants antsApplyTransforms -d 3 -n Linear -i ${masks}/target.nii.gz -r ${refvol} -o ${tracts}/target.nii.gz -t ${fa_to_fmrib_warp} ${fa_to_fmrib_affine}
    fsl fslmaths ${tracts}/target.nii.gz -thr 0.1 -bin ${tracts}/target.nii.gz -odt char
    #fsl applywarp -r ${refvol} -w ${std2nat_warp} -i ${masks}/exclude.nii.gz -o ${tracts}/exclude.nii.gz -d float
    ants antsApplyTransforms -d 3 -n Linear -i ${masks}/exclude.nii.gz -r ${refvol} -o ${tracts}/exclude.nii.gz -t ${fa_to_fmrib_warp} ${fa_to_fmrib_affine}
    fsl fslmaths ${tracts}/exclude.nii.gz -thr 0.1 -bin ${tracts}/exclude.nii.gz -odt char
    if [ "${useStop}" -eq "1" ]; then
      #fsl applywarp -r ${refvol} -w ${std2nat_warp} -i ${masks}/stop.nii.gz -o ${tracts}/stop.nii.gz -d float
      ants antsApplyTransforms -d 3 -n Linear -i ${masks}/stop.nii.gz -r ${refvol} -o ${tracts}/stop.nii.gz -t ${fa_to_fmrib_warp} ${fa_to_fmrib_affine}
      fsl fslmaths ${tracts}/stop.nii.gz -thr 0.1 -bin ${tracts}/stop.nii.gz -odt char
    fi
    
    # process structure
    if [ "${useStop}" -eq "1" ]; then
      fsl probtrackx -s ${bpx_dir}/merged -m ${bpx_dir}/nodif_brain_mask.nii.gz -x ${tracts}/seed.nii.gz -o density --waypoints=${tracts}/target.nii.gz --stop=${tracts}/stop.nii.gz --nsamples=${nSeed} --opd --dir=${tracts}/tracts --avoid=${tracts}/exclude.nii.gz -l --forcedir
      if [ "${symtrack}" -eq "1" ]; then
        fsl probtrackx -s ${bpx_dir}/merged -m ${bpx_dir}/nodif_brain_mask.nii.gz -x ${tracts}/target.nii.gz -o density --waypoints=${tracts}/seed.nii.gz --stop=${tracts}/stop.nii.gz --nsamples=${nSeed} --opd --dir=${tracts}/tractsInv --avoid=${tracts}/exclude.nii.gz -l --forcedir
      fi
    else
      fsl probtrackx -s ${bpx_dir}/merged -m ${bpx_dir}/nodif_brain_mask.nii.gz -x ${tracts}/seed.nii.gz -o density --waypoints=${tracts}/target.nii.gz --nsamples=${nSeed} --opd --dir=${tracts}/tracts --avoid=${tracts}/exclude.nii.gz -l --forcedir
      if [ "${symtrack}" -eq "1" ]; then
        fsl probtrackx -s ${bpx_dir}/merged -m ${bpx_dir}/nodif_brain_mask.nii.gz -x ${tracts}/target.nii.gz -o density --waypoints=${tracts}/seed.nii.gz --nsamples=${nSeed} --opd --dir=${tracts}/tractsInv --avoid=${tracts}/exclude.nii.gz -l --forcedir
      fi
    fi
    
    # merge runs for forward and inverted tractography runs
    if [ "${symtrack}" = "1" ]; then
      fsl immv ${tracts}/tracts/density.nii.gz ${tracts}/tractsInv/fwDensity.nii.gz
      fsl fslmaths ${tracts}/tractsInv/fwDensity.nii.gz -add ${tracts}/tractsInv/density.nii.gz ${tracts}/tracts/density.nii.gz
      way1=`cat ${tracts}/tracts/waytotal | sed 's/e/\\*10^/' | tr -d '+' `
      mv ${tracts}/tracts/waytotal ${tracts}/tractsInv/fwWaytotal
      way2=`cat ${tracts}/tractsInv/waytotal | sed 's/e/\\*10^/' | tr -d '+' `
      way=$(echo "scale=5; ${way1} + ${way2} "|bc)
      echo ${way} > ${tracts}/tracts/waytotal
    fi
    
    # perform normalisation for waytotal
    waytotal=`cat ${tracts}/tracts/waytotal`
    fsl fslmaths ${tracts}/tracts/density.nii.gz -div ${waytotal} -range ${tracts_norm} -odt float

    LWDP_lockfile_delete ${tracts_norm}
  fi

  fa_atlas=${DATA_DIR}/sri24/sri24_fa.nii.gz
  sri24_b0fa_warp=${DIFFUSION_DIR}/${branch}/registration/sri24_b0fa/ants_0Warp.nii.gz
  input=${tracts}/tracts/tractsNorm.nii.gz
  output=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/autoptx/tractsNorm/${struct}.nii.gz
  if LWDP_needs_update_and_lock ${output} ${input} ${sri24_b0fa_warp} ${fa_atlas}; then
    ants antsApplyTransforms -d 3 -n Linear -i ${input} -r ${fa_atlas} -o ${output} -t ${sri24_b0fa_warp}
    c3d c3d ${output} -type float -o ${output}
    LWDP_lockfile_delete ${output}
  fi

  input=${tracts}/tracts/tractsNorm.nii.gz
  output=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/tractsNorm/${struct}.nii.gz
  if LWDP_needs_update_and_lock ${output} ${input} ${sri24_padded_t1_brain} ${b0_t1_mtx}; then
    ants antsApplyTransforms -d 3 -n Linear -i ${input} -r ${sri24_padded_t1_brain} -o ${output} -t ${sri24_padded_to_t1_rigid} ${t1_b0_mtx}
    c3d c3d ${output} -type float -o ${output}
    LWDP_lockfile_delete ${output}
  fi
done
# merge left right
structures=${DATA_DIR}/autoptx/structureListLR
snum=`cat ${structures} | wc -l`
for sidx in `seq 1 ${snum}`; do
  line=`sed -n "${sidx}p;d" ${structures}`
  struct=`echo ${line} | cut -d " " -f1`

  inputL=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/autoptx/tractsNorm/${struct}_l.nii.gz
  inputR=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/autoptx/tractsNorm/${struct}_r.nii.gz
  output=${DIFFUSION_DIR}/${branch}/reslice/sri24/warp_refine/autoptx/tractsNorm/${struct}.nii.gz
  if [ -e ${inputL} ] && [ -e ${inputR} ]; then
    if LWDP_needs_update_and_lock ${output} ${inputL} ${inputR}; then
      c3d c3d ${inputL} ${inputR} -add -o ${output}
      LWDP_lockfile_delete ${output}
    fi
  fi

  inputL=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/tractsNorm/${struct}_l.nii.gz
  inputR=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/tractsNorm/${struct}_r.nii.gz
  output=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/tractsNorm/${struct}.nii.gz
  if [ -e ${inputL} ] && [ -e ${inputR} ]; then
    if LWDP_needs_update_and_lock ${output} ${inputL} ${inputR}; then
      c3d c3d ${inputL} ${inputR} -add -o ${output}
      LWDP_lockfile_delete ${output}
    fi
  fi
done

