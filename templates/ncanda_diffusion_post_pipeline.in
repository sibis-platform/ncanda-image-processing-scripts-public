      measure_autoptx_values "${DIFFUSION_DIR}/pepolar/reslice/sri24/warp_refine/" ".nii.gz" "${WORKDIR}/../${VISIT_REF}/diffusion/pepolar/reslice/sri24/warp_refine/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/measures/autoptx_warp_refine_" "_ref_tracts_LR.csv" "${DATA_DIR}/autoptx/structureListLR"
      #
