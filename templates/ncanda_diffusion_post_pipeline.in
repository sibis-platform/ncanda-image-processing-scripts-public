      measure_autoptx_values "${DIFFUSION_DIR}/pepolar/reslice/sri24_padded/autoptx/" ".nii.gz" "${WORKDIR}/../${VISIT_REF}/diffusion/pepolar/reslice/sri24_padded/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/measures/autoptx_sri24_padded_" "_ref_tracts_LR.csv" "${DATA_DIR}/autoptx/structureListLR"
    fi
  elif [ "${branch}" == "pepolar_long" ] && [ "${VISIT}" != "${VISIT_REF}" ]; then
    measure_autoptx_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/" ".nii.gz" "${DIFFUSION_DIR}/pepolar/reslice/sri24/warp_refine/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/autoptx_warp_refine_" ".csv" "${DATA_DIR}/autoptx/structureList"
    measure_autoptx_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/" ".nii.gz" "${DIFFUSION_DIR}/pepolar/reslice/sri24/warp_refine/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/autoptx_warp_refine_" "_LR.csv" "${DATA_DIR}/autoptx/structureListLR"
    measure_autoptx_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/" ".nii.gz" "${WORKDIR}/../${VISIT_REF}/diffusion/pepolar/reslice/sri24/warp_refine/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/autoptx_warp_refine_" "_ref_tracts.csv" "${DATA_DIR}/autoptx/structureList"
    measure_autoptx_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24/warp_refine/" ".nii.gz" "${WORKDIR}/../${VISIT_REF}/diffusion/pepolar/reslice/sri24/warp_refine/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/autoptx_warp_refine_" "_ref_tracts_LR.csv" "${DATA_DIR}/autoptx/structureListLR"
    #
    measure_autoptx_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24_padded/autoptx/" ".nii.gz" "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24_padded/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/autoptx_sri24_padded_" ".csv" "${DATA_DIR}/autoptx/structureList"
    measure_autoptx_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24_padded/autoptx/" ".nii.gz" "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24_padded/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/autoptx_sri24_padded_" "_LR.csv" "${DATA_DIR}/autoptx/structureListLR"
    measure_autoptx_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24_padded/autoptx/" ".nii.gz" "${WORKDIR}/../${VISIT_REF}/diffusion/pepolar/reslice/sri24_padded/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/autoptx_sri24_padded_" "_ref_tracts.csv" "${DATA_DIR}/autoptx/structureList"
    measure_autoptx_values "${DIFFUSION_DIR}/pepolar/longitudinal/reslice/sri24_padded/autoptx/" ".nii.gz" "${WORKDIR}/../${VISIT_REF}/diffusion/pepolar/reslice/sri24_padded/autoptx/tractsNorm" "${DIFFUSION_DIR}/pepolar/longitudinal/measures/autoptx_sri24_padded_" "_ref_tracts_LR.csv" "${DATA_DIR}/autoptx/structureListLR"
  fi
done

