input=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/dtifit_FA.nii.gz
output=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/fa.nii.gz
if LWDP_needs_update_and_lock ${output} ${input} ${sri24_padded_t1_brain} ${b0_t1_mtx}; then
  c3d c3d ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/dtifit_FA.nii.gz -o ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/fa.nii.gz
  c3d c3d ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/dtifit_MD.nii.gz -o ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/md.nii.gz
  c3d c3d ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/dtifit_L1.nii.gz -o ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/l1.nii.gz
  c3d c3d ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/dtifit_L2.nii.gz ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/dtifit_L3.nii.gz -add -o ${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/lt.nii.gz
  LWDP_lockfile_delete ${output}

fi

if [ "${VISIT}" != "${VISIT_REF}" ]; then
  # correct inhomogeneity for followups
  map=("fa" "md" "l1" "lt")
  for map_idx in 0 1 2 3; do
    smooth_width=6
    input_b=${WORKDIR}/../${VISIT_REF}/diffusion/${branch}/reslice/sri24_padded/autoptx/${map[${map_idx}]}.nii.gz
    input=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/${map[${map_idx}]}.nii.gz
    bias=${DIFFUSION_DIR}/${branch}/longitudinal/reslice/sri24_padded/autoptx/${map[${map_idx}]}_bias_s${smooth_width}.nii.gz
    if LWDP_needs_update_and_lock ${bias} ${input} ${input_b}; then
      tmpdir=$(mktemp -d)
      caret7 wb_command -volume-smoothing ${input_b} ${smooth_width} ${tmpdir}/image_b.nii.gz
      caret7 wb_command -volume-smoothing ${input} ${smooth_width} ${tmpdir}/image_a.nii.gz
      fsl fslcpgeom ${input_b} ${tmpdir}/image_b.nii.gz
      fsl fslcpgeom ${input_b} ${tmpdir}/image_a.nii.gz
      afni 3dcalc -a ${tmpdir}/image_a.nii.gz -b ${tmpdir}/image_b.nii.gz -expr "(b-a)" -prefix ${bias}
      c3d c3d ${bias} -type float -o ${bias}
      rm -rf ${tmpdir}
      LWDP_lockfile_delete ${bias}
    fi
    output=${DIFFUSION_DIR}/${branch}/longitudinal/reslice/sri24_padded/autoptx/${map[${map_idx}]}.nii.gz
    if LWDP_needs_update_and_lock ${output} ${input} ${bias}; then
      c3d c3d ${input} ${bias} -add -type float -o ${output}
      LWDP_lockfile_delete ${output}
    fi
  done

  for structures in ${DATA_DIR}/autoptx/structureList ${DATA_DIR}/autoptx/structureListLR; do
    snum=`cat ${structures} | wc -l`
    for sidx in `seq 1 ${snum}`; do
      line=`sed -n "${sidx}p;d" ${structures}`
      struct=`echo ${line} | cut -d " " -f1`
      smooth_width=6
      input_b=${WORKDIR}/../${VISIT_REF}/diffusion/${branch}/reslice/sri24_padded/autoptx/tractsNorm/${struct}.nii.gz
      input=${DIFFUSION_DIR}/${branch}/reslice/sri24_padded/autoptx/tractsNorm/${struct}.nii.gz
      bias=${DIFFUSION_DIR}/${branch}/longitudinal/reslice/sri24_padded/autoptx/tractsNorm/${struct}_bias_s${smooth_width}.nii.gz
      if LWDP_needs_update_and_lock ${bias} ${input} ${input_b}; then
        tmpdir=$(mktemp -d)
        caret7 wb_command -volume-smoothing ${input_b} ${smooth_width} ${tmpdir}/image_b.nii.gz
        caret7 wb_command -volume-smoothing ${input} ${smooth_width} ${tmpdir}/image_a.nii.gz
        fsl fslcpgeom ${input_b} ${tmpdir}/image_b.nii.gz
        fsl fslcpgeom ${input_b} ${tmpdir}/image_a.nii.gz
        afni 3dcalc -a ${tmpdir}/image_a.nii.gz -b ${tmpdir}/image_b.nii.gz -expr "(b-a)" -prefix ${bias}
        c3d c3d ${bias} -type float -o ${bias}
        rm -rf ${tmpdir}
        LWDP_lockfile_delete ${bias}
      fi
      output=${DIFFUSION_DIR}/${branch}/longitudinal/reslice/sri24_padded/autoptx/tractsNorm/${struct}.nii.gz
      if LWDP_needs_update_and_lock ${output} ${input} ${bias}; then
        c3d c3d ${input} ${bias} -add -type float -o ${output}
        LWDP_lockfile_delete ${output}
      fi
    done
  done
fi

measure_autoptx_values()
{
  local input_pfx=$1
  local input_sfx=$2
  local weight_path=$3
  local output_pfx=$4
  local output_sfx=$5
  local structures=$6

  local map=("fa" "md" "l1" "lt")
  local map_idx

  if LWDP_needs_update_and_lock ${output_pfx}${map[0]}${output_sfx} ${input_pfx}${map[0]}${input_sfx} ${input_pfx}${map[1]}${input_sfx} ${input_pfx}${map[2]}${input_sfx} ${input_pfx}${map[3]}${input_sfx} ${weight_path}/unc_r.nii.gz; then
    # init header
    header="subject,arm,visit"
    for map_idx in 0 1 2 3; do
      values[${map_idx}]="${SUBJECT},${ARM},${VISIT}"
    done

    snum=`cat ${structures} | wc -l`
    for sidx in `seq 1 ${snum}`; do
      line=`sed -n "${sidx}p;d" ${structures}`
      struct=`echo ${line} | cut -d " " -f1`

      header="${header},${struct}"

      weight=${weight_path}/${struct}.nii.gz
      for map_idx in 0 1 2 3; do
        input=${input_pfx}${map[${map_idx}]}${input_sfx}
        roi_val=`caret7 wb_command -volume-weighted-stats ${input} -weight-volume ${weight} -mean`
        values[${map_idx}]="${values[${map_idx}]},${roi_val}"
      done

      for map_idx in 0 1 2 3; do
        output=${output_pfx}${map[${map_idx}]}${output_sfx}
        if [ -e ${output} ]; then
          rm -f ${output}
        fi
        echo ${header} >> ${output}
        echo ${values[${map_idx}]} >> ${output}
      done
    done

    LWDP_lockfile_delete ${output_pfx}${map[0]}${output_sfx}
  fi
}

for branch in pepolar pepolar_long; do
  if [ "${branch}" == "pepolar" ]; then
