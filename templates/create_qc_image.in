# freeview ${FS_VW_OPT}  -ras $V1a 0 $V3a  -viewport x  -ss ${FS_IMG_DIR}/hip_${TYPE}_sag
# freeview ${FS_VW_OPT}  -v ${FS_MRI_DIR}/lh.hippoSfLabels-${TYPE}.v10.mgz:colormap=lut -ras 0 0 $V3a -viewport y -ss ${FS_IMG_DIR}/hip_${TYPE}_cor
# freeview ${FS_VW_OPT}  -v ${FS_MRI_DIR}/lh.hippoSfLabels-${TYPE}.v10.mgz:colormap=lut -ras 0 0 $V3a -viewport z -ss ${FS_IMG_DIR}/hip_${TYPE}_axi
# freeview ${FS_VW_OPT2}  -ras $V1a 0 $V3a  -viewport x  -ss ${FS_IMG_DIR}/orig_${TYPE}_sag
# freeview ${FS_VW_OPT2}  -ras 0 0 $V3a -viewport y -ss ${FS_IMG_DIR}/orig_${TYPE}_cor
# freeview ${FS_VW_OPT2}  -ras 0 0 $V3a -viewport z -ss ${FS_IMG_DIR}/orig_${TYPE}_axi



#
# Overview 
#

# So do not do that as otherwise if something fails the entire index page is not created 
# if LWDP_needs_update_and_lock_flag ${OVERVIEW_HTML} $FS_IMG_DIR/lh.lat.hr.gif $FS_IMG_DIR/rh.lat.hr.gif  ${FS_ASEG_AXI}.png  ${MASK_HTML}; then 
if [ "${orig_review}" != "$review" ]; then 
    echo "========================================================================"
    echo "CREATE $review_file"
    echo "========================================================================"
    echo "subject,arm,visit,t1_mask_passed,t1_mask_note,t2_alignment_passed,t2_alignment_note,fa_alignment_passed,fa_alignment_note,fa_skeleton_passed,fa_skeleton_note,bold_passed,bold_note,fs_cross_passed,fs_cross_note,fs_longitudinal_passed,fs_longitudinal_note" > $review_file
    echo "$review" >> $review_file
fi 

# Only create/update if gif were created/updated 
if [ $QC_IMG_UPDATE -eq 1 ]; then
    OVERVIEW_HTML=${QC_IMG_DIR}/index.html
    echo "========================================================================"
    echo "CREATE ${OVERVIEW_HTML}"
    echo "========================================================================"
    print_overview_html > ${OVERVIEW_HTML}
fi

